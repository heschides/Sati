{
  "bindings": [
    {
      "authLevel": "function",
      "type": "httpTrigger",
      "direction": "in",
      "name": "Request",
      "methods": [ "post" ],
      "route": "demo/reset"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "Response"
    },
    {
      "type": "queue",
      "direction": "out",
      "name": "ResetRequest",
      "queueName": "demo-reset-requests",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
