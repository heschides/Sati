    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#EBDCC0" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFDF5" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3FFF9EC" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40FFF9EC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D8BE98" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#B99568" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E3D2B4" />
    <SolidColorBrush x:Key="AccentBrush" Color="#68452F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#583823" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#432A1A" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#76503A" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#5F3E29" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#432A1A" />
    <SolidColorBrush x:Key="OnAccentButtonBrush" Color="#FFFFFF" />
    <Color x:Key="AiGlowColor">#FFC7924D</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#765126" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#624018" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#4B2F10" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#F6E5BF" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#D1AA69" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#5C3C17" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F0E2C8" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#F2E5CD" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3D3028" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#59483A" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5B4A3C" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#59483A" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#604937" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#FFF9EA" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#F4E5CA" />
    <Color x:Key="SurfaceAltColor">#FFF5E8CF</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFDF5</Color>
    <Color x:Key="TextSubtleColor">#FF59483A</Color>
    <SolidColorBrush x:Key="PatternScrimBrush" Color="#EBFFF9EC" />
</ResourceDictionary>
