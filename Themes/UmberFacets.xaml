<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UMBER FACETS: intersecting espresso, chestnut, caramel, ochre, and tan planes. -->
    <DrawingBrush x:Key="WindowBackgroundBrush"
                  TileMode="Tile"
                  Viewport="0,0,320,220"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,320,220"
                  ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#251009" Geometry="M 0,0 L 320,0 320,220 0,220 Z" />
                <GeometryDrawing Brush="#321507" Geometry="M 0,0 L 178,0 218,112 164,220 0,220 Z" />
                <GeometryDrawing Brush="#43291A" Geometry="M 178,0 L 252,0 218,112 Z" />
                <GeometryDrawing Brush="#603016" Geometry="M 252,0 L 320,0 320,58 233,162 218,112 Z" />
                <GeometryDrawing Brush="#693617" Geometry="M 320,58 L 320,220 270,220 233,162 Z" />
                <GeometryDrawing Brush="#62400D" Geometry="M 233,162 L 270,220 164,220 Z" />
                <GeometryDrawing Brush="#5B2807" Geometry="M 218,112 L 233,162 164,220 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Working surfaces retain the geometry softly, so text never competes with it. -->
    <VisualBrush x:Key="SurfaceBrush"
                 TileMode="Tile"
                 Viewport="0,0,320,220"
                 ViewportUnits="Absolute"
                 Viewbox="0,0,320,220"
                 ViewboxUnits="Absolute">
        <VisualBrush.Visual>
            <Border Width="320" Height="220" Background="#F2291B14">
                <Border Background="{StaticResource WindowBackgroundBrush}" Opacity="0.11">
                    <Border.Effect>
                        <BlurEffect Radius="5" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>
            </Border>
        </VisualBrush.Visual>
    </VisualBrush>

    <DrawingBrush x:Key="NavPatternSourceBrush"
                  TileMode="Tile"
                  Viewport="0,0,196,72"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,196,72"
                  ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#2A140A" Geometry="M 0,0 L 196,0 196,72 0,72 Z" />
                <GeometryDrawing Brush="#43291A" Geometry="M 70,0 L 126,0 108,38 Z" />
                <GeometryDrawing Brush="#603016" Geometry="M 126,0 L 196,0 196,27 139,56 108,38 Z" />
                <GeometryDrawing Brush="#62400D" Geometry="M 139,56 L 171,72 83,72 Z" />
                <GeometryDrawing Brush="#5B2807" Geometry="M 108,38 L 139,56 83,72 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <VisualBrush x:Key="NavBackgroundBrush"
                 TileMode="Tile"
                 Viewport="0,0,196,72"
                 ViewportUnits="Absolute"
                 Viewbox="0,0,196,72"
                 ViewboxUnits="Absolute">
        <VisualBrush.Visual>
            <Border Width="196" Height="72" Background="#F02D1A10">
                <Border Background="{StaticResource NavPatternSourceBrush}" Opacity="0.22">
                    <Border.Effect>
                        <BlurEffect Radius="4" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>
            </Border>
        </VisualBrush.Visual>
    </VisualBrush>

