<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MODERN BLUE: the Modern layout on cool blue-gray surfaces with a cobalt accent. -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F6FA" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EEF3F9" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#E3EAF3" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE3EC" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#BFCAD8" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E3EAF3" />

    <!-- Form fields read at full ink rather than the muted default. -->
    <SolidColorBrush x:Key="InputSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="InputMutedTextBrush" Color="#475569" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="InputPressedBrush" Color="#EEF3F9" />
    <SolidColorBrush x:Key="InputSelectionBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="InputSelectionTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <!-- Button fill is its own token so a palette can lighten its buttons
         without lightening the accent used for type. -->
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="OnAccentButtonBrush" Color="#FFFFFF" />

    <!-- Local AI: violet, kept apart from the cobalt accent. -->
    <Color x:Key="AiGlowColor">#FF8D75B8</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#6B4FA0" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#7D62B3" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#513879" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#EFE9F7" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#C7B8E0" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#3A2A5A" />

    <SolidColorBrush x:Key="HoverBrush" Color="#EEF3F9" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#E3EAF3" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#475569" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#F3F6FA" />
    <Color x:Key="SurfaceAltColor">#FFEEF3F9</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFFFF</Color>
    <Color x:Key="TextSubtleColor">#FF475569</Color>
</ResourceDictionary>
