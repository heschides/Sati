<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MODERN PINK: the Modern layout on blush surfaces with a rose-magenta accent.
         The accent leans toward magenta so it never reads as the brick red that
         States.xaml reserves for overdue and billing problems. -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FBF5F7" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8EEF2" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F0E2E8" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#EBDDE3" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D4BFC8" />
    <SolidColorBrush x:Key="DividerBrush" Color="#F0E2E8" />

    <!-- Form fields read at full ink rather than the muted default. -->
    <SolidColorBrush x:Key="InputSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputTextBrush" Color="#231A1E" />
    <SolidColorBrush x:Key="InputMutedTextBrush" Color="#5A4A52" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="#FDF9FA" />
    <SolidColorBrush x:Key="InputPressedBrush" Color="#F8EEF2" />
    <SolidColorBrush x:Key="InputSelectionBrush" Color="#9D2F6B" />
    <SolidColorBrush x:Key="InputSelectionTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#9D2F6B" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#832659" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6B1F49" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <!-- Button fill is its own token so a palette can lighten its buttons
         without lightening the accent used for type. -->
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#B83280" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#9D2F6B" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#832659" />
    <SolidColorBrush x:Key="OnAccentButtonBrush" Color="#FFFFFF" />

    <!-- Local AI: teal, because violet would sit too close to the rose accent. -->
    <Color x:Key="AiGlowColor">#FF2DA39A</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#115E59" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#134E4A" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#E6F4F2" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#99D2CB" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#134E4A" />

    <SolidColorBrush x:Key="HoverBrush" Color="#F8EEF2" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#F0E2E8" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#231A1E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A3D43" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5A4A52" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#5A4A52" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#3A2D33" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#FBF5F7" />
    <Color x:Key="SurfaceAltColor">#FFF8EEF2</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFFFF</Color>
    <Color x:Key="TextSubtleColor">#FF5A4A52</Color>
</ResourceDictionary>
