<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MODERN DARK: Modern's clay accent on flat warm charcoal. Inset content sits
         darker than cards, as in Modern's light surfaces, and fields stay dark with
         full-strength ink. -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1A1917" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#211F1C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#24221F" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1E1C1A" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#2C2A26" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2A2824" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B324221F" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#4024221F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3732" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#57524A" />
    <SolidColorBrush x:Key="DividerBrush" Color="#332F2B" />

    <SolidColorBrush x:Key="InputSurfaceBrush" Color="#1E1C1A" />
    <SolidColorBrush x:Key="InputTextBrush" Color="#F2EFEA" />
    <SolidColorBrush x:Key="InputMutedTextBrush" Color="#B9B1A5" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="#24221F" />
    <SolidColorBrush x:Key="InputPressedBrush" Color="#2C2A26" />
    <SolidColorBrush x:Key="InputSelectionBrush" Color="#9A4A1C" />
    <SolidColorBrush x:Key="InputSelectionTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#F2A36B" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F5B584" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#E08A4F" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A1917" />
    <!-- Button fill is its own token so a palette can lighten its buttons
         without lightening the accent used for type. -->
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#E08A4F" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#EC9B63" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#C9763D" />
    <SolidColorBrush x:Key="OnAccentButtonBrush" Color="#1A1917" />

    <!-- Local AI: lavender, kept apart from the clay accent. -->
    <Color x:Key="AiGlowColor">#FF9C87CF</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#B8A6E0" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#C8BAE8" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#9C87CF" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#2E2940" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#6F6394" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#17151C" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#DCD3F2" />

    <SolidColorBrush x:Key="HoverBrush" Color="#2C2A26" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#34312C" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2EFEA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CFC8BD" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#B9B1A5" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#B9B1A5" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#E0D9CE" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#24221F" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#2A2824" />
    <Color x:Key="SurfaceAltColor">#FF1E1C1A</Color>
    <Color x:Key="SurfaceRaisedColor">#FF2A2824</Color>
    <Color x:Key="TextSubtleColor">#FFB9B1A5</Color>

    <!-- Dark-surface semantic variants: same meanings, luminance flipped. -->
    <SolidColorBrush x:Key="OverdueBrush" Color="#FFADA3" /><SolidColorBrush x:Key="OverdueBorderBrush" Color="#94575E" /><SolidColorBrush x:Key="OverdueFillBrush" Color="#493034" />
    <SolidColorBrush x:Key="CompliantBrush" Color="#A8DDA6" /><SolidColorBrush x:Key="CompliantFillBrush" Color="#29432F" />
    <SolidColorBrush x:Key="ProductivityDayFillBrush" Color="#2A4531" /><SolidColorBrush x:Key="ProductivityPendingDayFillBrush" Color="#27392D" /><SolidColorBrush x:Key="ProductivityPendingDayBorderBrush" Color="#E595B0" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F0D07B" /><SolidColorBrush x:Key="WarningFillBrush" Color="#493D22" /><SolidColorBrush x:Key="WarningSoftBrush" Color="#4E4228" />
    <SolidColorBrush x:Key="InfoBrush" Color="#9BCDF5" /><SolidColorBrush x:Key="InfoFillBrush" Color="#263E52" />
    <SolidColorBrush x:Key="SuccessStrongBrush" Color="#A6D69C" /><SolidColorBrush x:Key="OnSuccessStrongBrush" Color="#132613" /><SolidColorBrush x:Key="SuccessDarkBrush" Color="#B7E0AE" /><SolidColorBrush x:Key="SuccessBorderBrush" Color="#648967" /><SolidColorBrush x:Key="SuccessSoftBrush" Color="#304834" />
    <SolidColorBrush x:Key="DangerStrongBrush" Color="#F0AAAA" /><SolidColorBrush x:Key="OnDangerStrongBrush" Color="#321515" /><SolidColorBrush x:Key="DangerDarkBrush" Color="#FFC0C0" /><SolidColorBrush x:Key="DangerSoftBrush" Color="#4B3034" />
    <SolidColorBrush x:Key="WorkflowPurpleBrush" Color="#D8C2F0" /><SolidColorBrush x:Key="WorkflowPurpleFillBrush" Color="#40334F" /><SolidColorBrush x:Key="WorkflowPurpleBorderBrush" Color="#78638D" />
    <SolidColorBrush x:Key="OpenedFormBrush" Color="#FFB36B" /><SolidColorBrush x:Key="OpenedFormFillBrush" Color="#493522" />
    <SolidColorBrush x:Key="MatrixGoodBrush" Color="#2D4933" /><SolidColorBrush x:Key="MatrixWatchBrush" Color="#514622" /><SolidColorBrush x:Key="MatrixConcernBrush" Color="#563B28" /><SolidColorBrush x:Key="MatrixUrgentBrush" Color="#533034" /><SolidColorBrush x:Key="MatrixEmptyBrush" Color="#34312C" />
    <Color x:Key="MatrixGoodColor">#FF2D4933</Color><Color x:Key="MatrixWatchColor">#FF514622</Color><Color x:Key="MatrixUrgentColor">#FF533034</Color><Color x:Key="MatrixEmptyColor">#FF34312C</Color>
</ResourceDictionary>
