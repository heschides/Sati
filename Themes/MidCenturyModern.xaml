<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MID-CENTURY MODERN: warm paper, atomic geometry, teal, ochre, and coral. -->
    <!-- A deliberately roomy repeat keeps the atomic vocabulary without turning it into a grid. -->
    <DrawingBrush x:Key="WindowBackgroundBrush" TileMode="Tile"
                  Viewport="0,0,264,192" ViewportUnits="Absolute"
                  Viewbox="0,0,264,192" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F9F3E9" Geometry="M 0,0 L 264,0 264,192 0,192 Z" />

                <!-- Circles and ellipses vary gently in scale and angle. -->
                <GeometryDrawing Brush="#22608B87">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="29,28" RadiusX="18" RadiusY="18" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <DrawingGroup>
                    <DrawingGroup.Transform><RotateTransform Angle="-16" CenterX="151" CenterY="139" /></DrawingGroup.Transform>
                    <GeometryDrawing Brush="#1E608B87">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="151,139" RadiusX="21" RadiusY="17" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
                <GeometryDrawing Brush="#1C608B87">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="239,61" RadiusX="15" RadiusY="15" /></GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Ochre wedges are related, but never line up or point the same way. -->
                <GeometryDrawing Brush="#24D29B3D" Geometry="M 77,7 L 102,12 85,40 Z" />
                <GeometryDrawing Brush="#21D29B3D" Geometry="M 207,151 L 237,139 233,173 Z" />
                <GeometryDrawing Brush="#1FD29B3D" Geometry="M 126,73 L 143,53 154,80 Z" />

                <!-- Coral quarter-rounds alternate corners and sizes. -->
                <GeometryDrawing Brush="#22B85E4D" Geometry="M 220,0 C 244,0 258,14 258,38 L 220,38 Z" />
                <GeometryDrawing Brush="#1FB85E4D" Geometry="M 5,127 C 27,127 42,142 42,164 L 5,164 Z" />
                <DrawingGroup>
                    <DrawingGroup.Transform><RotateTransform Angle="182" CenterX="111" CenterY="116" /></DrawingGroup.Transform>
                    <GeometryDrawing Brush="#1DB85E4D" Geometry="M 94,99 C 115,99 128,112 128,133 L 94,133 Z" />
                </DrawingGroup>

                <!-- Loose arcs, small satellites, and off-axis crosses add the requested irregularity. -->
                <GeometryDrawing Geometry="M 8,93 C 25,72 46,70 63,91 M 174,41 C 192,23 213,27 224,47 M 177,169 C 190,151 211,151 225,169">
                    <GeometryDrawing.Pen><Pen Brush="#2483564A" Thickness="2" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <DrawingGroup>
                    <DrawingGroup.Transform><RotateTransform Angle="13" CenterX="57" CenterY="152" /></DrawingGroup.Transform>
                    <GeometryDrawing Geometry="M 50,152 L 64,152 M 57,145 L 57,159">
                        <GeometryDrawing.Pen><Pen Brush="#2683564A" Thickness="2" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
                <DrawingGroup>
                    <DrawingGroup.Transform><RotateTransform Angle="-11" CenterX="181" CenterY="99" /></DrawingGroup.Transform>
                    <GeometryDrawing Geometry="M 175,99 L 187,99 M 181,93 L 181,105">
                        <GeometryDrawing.Pen><Pen Brush="#2283564A" Thickness="1.8" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
                <GeometryDrawing Brush="#2483564A">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="73,63" RadiusX="3" RadiusY="3" />
                            <EllipseGeometry Center="118,169" RadiusX="2.5" RadiusY="2.5" />
                            <EllipseGeometry Center="201,91" RadiusX="3.5" RadiusY="3.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <VisualBrush x:Key="SurfaceBrush" TileMode="Tile"
                 Viewport="0,0,264,192" ViewportUnits="Absolute"
                 Viewbox="0,0,264,192" ViewboxUnits="Absolute">
        <VisualBrush.Visual>
            <Border Width="264" Height="192" Background="#F2FFF9EE">
                <Border Background="{StaticResource WindowBackgroundBrush}" Opacity="0.12">
                    <Border.Effect>
                        <BlurEffect Radius="4" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>
            </Border>
        </VisualBrush.Visual>
    </VisualBrush>
    <DrawingBrush x:Key="NavPatternSourceBrush" TileMode="Tile"
                  Viewport="0,0,176,64" ViewportUnits="Absolute"
                  Viewbox="0,0,176,64" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F8F3EC" Geometry="M 0,0 L 176,0 176,64 0,64 Z" />
                <GeometryDrawing Brush="#28608B87">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="18,18" RadiusX="12" RadiusY="12" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#28D29B3D" Geometry="M 52,7 L 76,7 64,34 Z" />
                <GeometryDrawing Brush="#22B85E4D" Geometry="M 100,8 C 119,8 131,20 131,39 L 100,39 Z" />
                <DrawingGroup>
                    <DrawingGroup.Transform><RotateTransform Angle="-14" CenterX="151" CenterY="26" /></DrawingGroup.Transform>
                    <GeometryDrawing Brush="#24608B87">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="151,26" RadiusX="14" RadiusY="11" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
                <GeometryDrawing Geometry="M 6,51 C 24,39 40,40 52,51 M 137,51 L 167,51">
                    <GeometryDrawing.Pen><Pen Brush="#2483564A" Thickness="2" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <VisualBrush x:Key="NavBackgroundBrush" TileMode="Tile"
                 Viewport="0,0,176,64" ViewportUnits="Absolute"
                 Viewbox="0,0,176,64" ViewboxUnits="Absolute">
        <VisualBrush.Visual>
            <Border Width="176" Height="64" Background="#EEF8F3EC">
                <Border Background="{StaticResource NavPatternSourceBrush}" Opacity="0.18">
                    <Border.Effect>
                        <BlurEffect Radius="3.5" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>
            </Border>
        </VisualBrush.Visual>
    </VisualBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EDE0CA" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#E8DDCB" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFF8" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3FFF9EE" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40FFF9EE" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D1BFA7" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#AA9180" />
    <SolidColorBrush x:Key="DividerBrush" Color="#DDCDB7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1E5A58" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#195552" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#10413F" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#246B68" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#195552" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#10413F" />
    <SolidColorBrush x:Key="OnAccentButtonBrush" Color="#FFFFFF" />
    <Color x:Key="AiGlowColor">#FFD59D3D</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#9B6817" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#82530F" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#673F09" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#F6E3B7" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#D2A75A" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#674713" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EBDDC6" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#EADDCE" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3E332C" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#594C45" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#594D46" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#584D45" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#5C4C43" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#FBF1E1" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#EFE1CE" />
    <Color x:Key="SurfaceAltColor">#FFEDE0CA</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFFF8</Color>
    <Color x:Key="TextSubtleColor">#FF584D45</Color>
    <!-- Quiets this theme's pattern behind control-dense screens. -->
    <SolidColorBrush x:Key="PatternScrimBrush" Color="#E8FFF9EE" />
</ResourceDictionary>
