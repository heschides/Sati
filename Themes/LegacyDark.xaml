<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Legacy's leaf, serif type, and gradient layout in the Black Bean palette. -->
    <BitmapImage x:Key="BrandLeafImage" UriSource="/images/leaf.png" />
    <ImageSource x:Key="AppWindowIcon">/images/leaf.ico</ImageSource>
    <FontFamily x:Key="AppFont">Palatino Linotype, Book Antiqua, Georgia</FontFamily>
    <FontFamily x:Key="DisplayFont">Palatino Linotype, Book Antiqua, Georgia</FontFamily>

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3C1006" Offset="0" />
        <GradientStop Color="#FF471709" Offset="0.45" />
        <GradientStop Color="#FF51200D" Offset="0.78" />
        <GradientStop Color="#FF421408" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF461609" Offset="0" />
        <GradientStop Color="#FF54210D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF54200C" Offset="0" />
        <GradientStop Color="#FF4B1A0A" Offset="0.5" />
        <GradientStop Color="#FF5B250F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#53200D" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#5B250F" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#59230E" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B354200C" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#4054200C" />
    <SolidColorBrush x:Key="BorderBrush" Color="#7E3615" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#AB653D" />
    <SolidColorBrush x:Key="DividerBrush" Color="#7E3615" />

    <SolidColorBrush x:Key="AccentBrush" Color="#DFD8CD" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#D3BCA5" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#3C1006" />
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#D3BCA5" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#DFD8CD" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#C5A98D" />
    <SolidColorBrush x:Key="OnAccentButtonBrush" Color="#3C1006" />

    <Color x:Key="AiGlowColor">#FFAB653D</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#DFD8CD" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#D3BCA5" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#53200D" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#AB653D" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#3C1006" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#DFD8CD" />

    <SolidColorBrush x:Key="HoverBrush" Color="#55210E" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#5D2611" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#DFD8CD" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D3BCA5" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#D3BCA5" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#D3BCA5" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#DFD8CD" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#4A1A0B" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#56220E" />
    <Color x:Key="SurfaceAltColor">#FF53200D</Color>
    <Color x:Key="SurfaceRaisedColor">#FF59230E</Color>
    <Color x:Key="TextSubtleColor">#FFD3BCA5</Color>

    <!-- Status hues retain their meaning, with dark fills and readable ink. -->
    <SolidColorBrush x:Key="OverdueBrush" Color="#FFAAA5" /><SolidColorBrush x:Key="OverdueBorderBrush" Color="#9A5960" /><SolidColorBrush x:Key="OverdueFillBrush" Color="#4B3035" />
    <SolidColorBrush x:Key="CompliantBrush" Color="#A8DDAE" /><SolidColorBrush x:Key="CompliantFillBrush" Color="#294536" />
    <SolidColorBrush x:Key="ProductivityDayFillBrush" Color="#2A4531" /><SolidColorBrush x:Key="ProductivityPendingDayFillBrush" Color="#27392D" /><SolidColorBrush x:Key="ProductivityPendingDayBorderBrush" Color="#E595B0" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2D080" /><SolidColorBrush x:Key="WarningFillBrush" Color="#4B3E22" /><SolidColorBrush x:Key="WarningSoftBrush" Color="#4E4229" />
    <SolidColorBrush x:Key="InfoBrush" Color="#9FD1F3" /><SolidColorBrush x:Key="InfoFillBrush" Color="#234458" />
    <SolidColorBrush x:Key="SuccessStrongBrush" Color="#A7D9AE" /><SolidColorBrush x:Key="OnSuccessStrongBrush" Color="#132613" /><SolidColorBrush x:Key="SuccessDarkBrush" Color="#B9E4BF" /><SolidColorBrush x:Key="SuccessBorderBrush" Color="#658F6C" /><SolidColorBrush x:Key="SuccessSoftBrush" Color="#2E4A37" />
    <SolidColorBrush x:Key="DangerStrongBrush" Color="#F0AAAA" /><SolidColorBrush x:Key="OnDangerStrongBrush" Color="#321515" /><SolidColorBrush x:Key="DangerDarkBrush" Color="#FFC0C0" /><SolidColorBrush x:Key="DangerSoftBrush" Color="#4D3035" />
    <SolidColorBrush x:Key="WorkflowPurpleBrush" Color="#D7C5EE" /><SolidColorBrush x:Key="WorkflowPurpleFillBrush" Color="#403650" /><SolidColorBrush x:Key="WorkflowPurpleBorderBrush" Color="#79698D" />
    <SolidColorBrush x:Key="OpenedFormBrush" Color="#F1B66F" /><SolidColorBrush x:Key="OpenedFormFillBrush" Color="#493722" />
    <SolidColorBrush x:Key="MatrixGoodBrush" Color="#2C4B38" /><SolidColorBrush x:Key="MatrixWatchBrush" Color="#514623" /><SolidColorBrush x:Key="MatrixConcernBrush" Color="#563D2A" /><SolidColorBrush x:Key="MatrixUrgentBrush" Color="#553136" /><SolidColorBrush x:Key="MatrixEmptyBrush" Color="#2D454E" />
    <Color x:Key="MatrixGoodColor">#FF2C4B38</Color><Color x:Key="MatrixWatchColor">#FF514623</Color><Color x:Key="MatrixUrgentColor">#FF553136</Color><Color x:Key="MatrixEmptyColor">#FF2D454E</Color>
</ResourceDictionary>
