<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- PAISLEY: linen paper with layered, hooked boteh, foliage, wine, and teal. -->
    <DrawingBrush x:Key="WindowBackgroundBrush" TileMode="Tile"
                  Viewport="0,0,216,216" ViewportUnits="Absolute"
                  Viewbox="0,0,216,216" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F8F3EC" Geometry="M 0,0 L 216,0 216,216 0,216 Z" />

                <!-- The large hooked boteh has nested contours and a curling centre. -->
                <GeometryDrawing Brush="#1275445D"
                                 Geometry="M 39,10 C 76,16 97,47 92,78 C 88,106 67,127 42,127 C 18,127 4,109 8,87 C 11,67 27,57 37,45 C 48,32 52,18 39,10 Z">
                    <GeometryDrawing.Pen><Pen Brush="#2275445D" Thickness="1.3" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#12608780"
                                 Geometry="M 39,29 C 62,34 75,53 71,71 C 67,90 53,103 39,102 C 27,101 20,91 23,80 C 26,68 38,64 45,56 C 52,48 51,36 39,29 Z">
                        <GeometryDrawing.Pen><Pen Brush="#2C608780" Thickness="1.1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 40,43 C 56,48 60,60 56,70 C 52,80 41,84 34,79 C 28,74 32,67 39,66 C 45,65 48,69 45,73">
                    <GeometryDrawing.Pen><Pen Brush="#2275445D" Thickness="1.4" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#2275445D" Geometry="M 19,95 C 28,86 37,87 42,93 C 34,102 25,103 19,95 Z M 49,113 C 58,103 69,104 75,111 C 67,120 56,121 49,113 Z" />
                <GeometryDrawing Brush="#2275445D">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="39,66" RadiusX="2.8" RadiusY="2.8" />
                            <EllipseGeometry Center="62,84" RadiusX="2.2" RadiusY="2.2" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Smaller boteh are rotated and scaled independently to break the obvious repeat. -->
                <DrawingGroup>
                    <DrawingGroup.Transform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.78" ScaleY="0.78" />
                            <RotateTransform Angle="-32" CenterX="46" CenterY="66" />
                            <TranslateTransform X="121" Y="105" />
                        </TransformGroup>
                    </DrawingGroup.Transform>
                    <GeometryDrawing Brush="#14608780"
                                     Geometry="M 39,10 C 76,16 97,47 92,78 C 88,106 67,127 42,127 C 18,127 4,109 8,87 C 11,67 27,57 37,45 C 48,32 52,18 39,10 Z">
                        <GeometryDrawing.Pen><Pen Brush="#2C608780" Thickness="1.5" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 39,29 C 62,34 75,53 71,71 C 67,90 53,103 39,102 C 27,101 20,91 23,80 C 26,68 38,64 45,56 C 52,48 51,36 39,29 Z">
                        <GeometryDrawing.Pen><Pen Brush="#2275445D" Thickness="1.3" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 40,43 C 56,48 60,60 56,70 C 52,80 41,84 34,79 C 28,74 32,67 39,66">
                        <GeometryDrawing.Pen><Pen Brush="#2E608780" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#2275445D" Geometry="M 19,95 C 28,86 37,87 42,93 C 34,102 25,103 19,95 Z M 49,113 C 58,103 69,104 75,111 C 67,120 56,121 49,113 Z" />
                </DrawingGroup>

                <DrawingGroup>
                    <DrawingGroup.Transform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.62" ScaleY="0.62" />
                            <RotateTransform Angle="28" CenterX="46" CenterY="66" />
                            <TranslateTransform X="137" Y="-8" />
                        </TransformGroup>
                    </DrawingGroup.Transform>
                    <GeometryDrawing Brush="#1075445D"
                                     Geometry="M 39,10 C 76,16 97,47 92,78 C 88,106 67,127 42,127 C 18,127 4,109 8,87 C 11,67 27,57 37,45 C 48,32 52,18 39,10 Z">
                        <GeometryDrawing.Pen><Pen Brush="#2275445D" Thickness="1.8" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 39,29 C 62,34 75,53 71,71 C 67,90 53,103 39,102 C 27,101 20,91 23,80 C 26,68 38,64 45,56 C 52,48 51,36 39,29 Z">
                        <GeometryDrawing.Pen><Pen Brush="#2C608780" Thickness="1.5" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>

                <!-- Fine vines, leaves, and seed dots fill the negative space without forming rows. -->
                <GeometryDrawing Geometry="M 91,16 C 112,28 119,47 111,68 M 95,151 C 81,169 83,190 101,205 M 184,77 C 202,88 208,105 203,123">
                    <GeometryDrawing.Pen><Pen Brush="#22608780" Thickness="1.1" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#22608780" Geometry="M 105,37 C 114,31 121,34 123,40 C 115,46 108,45 105,37 Z M 86,177 C 95,171 102,174 104,181 C 96,187 89,185 86,177 Z M 197,101 C 205,96 212,99 214,105 C 207,111 200,109 197,101 Z" />
                <GeometryDrawing Brush="#2275445D">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="112,18" RadiusX="2.2" RadiusY="2.2" />
                            <EllipseGeometry Center="119,79" RadiusX="2.7" RadiusY="2.7" />
                            <EllipseGeometry Center="18,158" RadiusX="2.3" RadiusY="2.3" />
                            <EllipseGeometry Center="107,137" RadiusX="1.9" RadiusY="1.9" />
                            <EllipseGeometry Center="207,49" RadiusX="2.5" RadiusY="2.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- The pattern remains crisp in decorative navigation areas. Behind working
         content it is softly rasterized so it cannot compete with controls. -->
    <VisualBrush x:Key="SurfaceBrush" TileMode="Tile"
                 Viewport="0,0,216,216" ViewportUnits="Absolute"
                 Viewbox="0,0,216,216" ViewboxUnits="Absolute">
        <VisualBrush.Visual>
            <Border Width="216" Height="216" Background="#F2FFFCF8">
                <Border Background="{StaticResource WindowBackgroundBrush}" Opacity="0.12">
                    <Border.Effect>
                        <BlurEffect Radius="4" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>
            </Border>
        </VisualBrush.Visual>
    </VisualBrush>
    <DrawingBrush x:Key="NavPatternSourceBrush" TileMode="Tile"
                  Viewport="0,0,144,72" ViewportUnits="Absolute"
                  Viewbox="0,0,144,72" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F8F3EE" Geometry="M 0,0 L 144,0 144,72 0,72 Z" />
                <GeometryDrawing Brush="#0F75445D" Geometry="M 17,4 C 41,8 52,27 46,45 C 41,61 26,69 13,61 C 1,53 3,35 14,25 C 23,17 25,9 17,4 Z" />
                <GeometryDrawing Geometry="M 17,10 C 33,14 40,27 36,39 C 33,49 23,55 16,50 C 10,46 12,37 18,33 C 25,28 26,17 17,10 Z">
                    <GeometryDrawing.Pen><Pen Brush="#2275445D" Thickness="1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <DrawingGroup>
                    <DrawingGroup.Transform><RotateTransform Angle="-24" CenterX="104" CenterY="37" /></DrawingGroup.Transform>
                    <GeometryDrawing Brush="#10608780" Geometry="M 96,11 C 119,15 130,33 125,50 C 120,65 106,71 94,63 C 83,55 86,39 96,30 C 104,22 104,15 96,11 Z" />
                    <GeometryDrawing Geometry="M 97,20 C 111,23 117,34 114,44 C 111,53 103,57 97,53 C 91,49 94,42 99,39 C 104,35 104,26 97,20 Z">
                        <GeometryDrawing.Pen><Pen Brush="#28608780" Thickness="1" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <VisualBrush x:Key="NavBackgroundBrush" TileMode="Tile"
                 Viewport="0,0,144,72" ViewportUnits="Absolute"
                 Viewbox="0,0,144,72" ViewboxUnits="Absolute">
        <VisualBrush.Visual>
            <Border Width="144" Height="72" Background="#EEF8F3EE">
                <Border Background="{StaticResource NavPatternSourceBrush}" Opacity="0.18">
                    <Border.Effect>
                        <BlurEffect Radius="3.5" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>
            </Border>
        </VisualBrush.Visual>
    </VisualBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F2E8DE" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#E9DCD2" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3FFFCF8" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40FFFCF8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D5C0B8" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#B99C9E" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E1D1C8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#72425B" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5E344A" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#492638" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#75445D" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#5E344A" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#492638" />
    <SolidColorBrush x:Key="OnAccentButtonBrush" Color="#FFFFFF" />
    <Color x:Key="AiGlowColor">#FF5F8F88</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#44766F" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#315F59" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#234B46" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#E0EEE9" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#8BAEA8" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#294F4A" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EDDED5" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#E9DCD9" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3E3035" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5E4D54" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5D4D53" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#5C4D53" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#634B55" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#FBF5EE" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#F1E5E2" />
    <Color x:Key="SurfaceAltColor">#FFF2E8DE</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFFFF</Color>
    <Color x:Key="TextSubtleColor">#FF5C4D53</Color>
    <!-- Quiets this theme's pattern behind control-dense screens. -->
    <SolidColorBrush x:Key="PatternScrimBrush" Color="#E8FFFCF8" />
</ResourceDictionary>
