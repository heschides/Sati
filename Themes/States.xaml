<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Individual branded themes may opt into a shell logo. -->
    <Visibility x:Key="BrandLogoVisibility">Collapsed</Visibility>

    <!-- Brand defaults: the watercolor leaf, its icon, and Inter. A theme may replace any of
         them (Legacy restores the original copper leaf and Palatino). Kept here rather than in
         App.xaml because an application-level key would outrank every theme dictionary. -->
    <BitmapImage x:Key="BrandLeafImage" UriSource="/images/sati-watercolor-leaf.png" />
    <ImageSource x:Key="AppWindowIcon">/images/sati.ico</ImageSource>
    <FontFamily x:Key="AppFont">Inter</FontFamily>
    <FontFamily x:Key="DisplayFont">Palatino Linotype</FontFamily>

    <!-- Form controls have their own surface/ink pair. Most themes inherit their
         existing raised-surface colors; a theme may override the pair together. -->
    <SolidColorBrush x:Key="InputSurfaceBrush" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="InputTextBrush" Color="{DynamicResource TextSubtleColor}" />
    <SolidColorBrush x:Key="InputMutedTextBrush" Color="{DynamicResource TextSubtleColor}" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="InputPressedBrush" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="InputSelectionBrush" Color="{DynamicResource TextSubtleColor}" />
    <SolidColorBrush x:Key="InputSelectionTextBrush" Color="{DynamicResource SurfaceRaisedColor}" />

    <!-- STATE / STATUS COLORS — semantic meaning is fixed. Dark themes override
         luminance (not hue/meaning) so foreground and fill pairs stay legible. -->

    <!-- Overdue / danger -->
    <SolidColorBrush x:Key="OverdueBrush"       Color="#A93226" />
    <SolidColorBrush x:Key="OverdueBorderBrush" Color="#D9AEAE" />
    <SolidColorBrush x:Key="OverdueFillBrush"   Color="#F5E8E8" />

    <!-- Compliant / success -->
    <SolidColorBrush x:Key="CompliantBrush"     Color="#3F6B43" />
    <SolidColorBrush x:Key="CompliantFillBrush" Color="#D4EDD4" />

    <!-- Calendar days in this month's documented daily average. Gentle by design:
         green for a day with logged or approved units, a paler green with a pink
         border for one counted only through pending notes. -->
    <SolidColorBrush x:Key="ProductivityDayFillBrush"          Color="#E4F2E0" />
    <SolidColorBrush x:Key="ProductivityPendingDayFillBrush"   Color="#F1F8EE" />
    <SolidColorBrush x:Key="ProductivityPendingDayBorderBrush" Color="#B05B78" />

    <!-- Warning / amber -->
    <SolidColorBrush x:Key="WarningBrush"     Color="#6B4C00" />
    <SolidColorBrush x:Key="WarningFillBrush" Color="#F5DFB0" />

    <!-- Info -->
    <SolidColorBrush x:Key="InfoBrush"     Color="#184A74" />
    <SolidColorBrush x:Key="InfoFillBrush" Color="#A8C5D6" />

    <!-- Dashboard data series. Kept separate from semantic status colors so charts can
         feel calm and coordinated without changing overdue/success meaning elsewhere. -->
    <SolidColorBrush x:Key="ChartBlueBrush" Color="#1769D2" />
    <SolidColorBrush x:Key="ChartGoldBrush" Color="#E3AD3F" />
    <SolidColorBrush x:Key="ChartCopperBrush" Color="#D47A24" />

    <!-- Additional fixed semantic states used by dashboards and matrix views. -->
    <SolidColorBrush x:Key="SuccessStrongBrush" Color="#3A6B35" />
    <SolidColorBrush x:Key="OnSuccessStrongBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="#2A4A10" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#8AAE6A" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#A8C48A" />
    <SolidColorBrush x:Key="DangerStrongBrush" Color="#7A3B3B" />
    <SolidColorBrush x:Key="OnDangerStrongBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerDarkBrush" Color="#5E2D2D" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#EDD4D4" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#EDDFC0" />
    <SolidColorBrush x:Key="WorkflowPurpleBrush" Color="#3A2A5A" />
    <SolidColorBrush x:Key="WorkflowPurpleFillBrush" Color="#C4B8D8" />
    <SolidColorBrush x:Key="WorkflowPurpleBorderBrush" Color="#A89CC0" />

    <!-- Local AI actions: intentionally distinct from each theme's primary accent. -->
    <Color x:Key="AiGlowColor">#FF8D75B8</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#6B4FA0" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#7D62B3" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#513879" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#E9E0F5" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#B7A3D5" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#3A2A5A" />

    <SolidColorBrush x:Key="MatrixGoodBrush" Color="#C2DFB3" />
    <SolidColorBrush x:Key="MatrixWatchBrush" Color="#F5DFB0" />
    <SolidColorBrush x:Key="MatrixConcernBrush" Color="#F2B17A" />
    <SolidColorBrush x:Key="MatrixUrgentBrush" Color="#EEB09A" />
    <SolidColorBrush x:Key="MatrixEmptyBrush" Color="#E8E0D3" />
    <Color x:Key="MatrixGoodColor">#FFC2DFB3</Color>
    <Color x:Key="MatrixWatchColor">#FFF5DFB0</Color>
    <Color x:Key="MatrixUrgentColor">#FFEEB09A</Color>
    <Color x:Key="MatrixEmptyColor">#FFE8E0D3</Color>

    <!-- Form workflow: opened -->
    <SolidColorBrush x:Key="OpenedFormBrush"     Color="#914300" />
    <SolidColorBrush x:Key="OpenedFormFillBrush" Color="#FBEAD7" />

    <!-- Control-dense screens quiet a patterned theme behind their working area.
         Themes without a pattern leave this transparent, so the overlay costs them
         nothing; the patterned ones override it with a translucent surface tone.
         See PATTERNED_THEME_SCRIM in DECISIONS.md. -->
    <SolidColorBrush x:Key="PatternScrimBrush" Color="Transparent" />

    <!-- Modal scrim (dim behind dialogs). Functional, theme-independent. -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#80000000" />

</ResourceDictionary>
