<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MODERN: flat ivory shell, white working surfaces, and one clay accent.
         No gradients or patterns; hierarchy comes from surface steps and ink weight.
         The Modern family shares Segoe UI Variable, which ships with Windows 11. -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F4EE" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F3EFE8" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#ECE6DC" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E3DCD0" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CFC6B8" />
    <SolidColorBrush x:Key="DividerBrush" Color="#ECE6DC" />

    <!-- Form fields read at full ink rather than the muted default. -->
    <SolidColorBrush x:Key="InputSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputTextBrush" Color="#1F1B16" />
    <SolidColorBrush x:Key="InputMutedTextBrush" Color="#5C554B" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="#FAF7F2" />
    <SolidColorBrush x:Key="InputPressedBrush" Color="#F3EFE8" />
    <SolidColorBrush x:Key="InputSelectionBrush" Color="#9A3412" />
    <SolidColorBrush x:Key="InputSelectionTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#9A3412" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7C2D12" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6A2610" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <!-- Button fill is its own token so a palette can lighten its buttons
         without lightening the accent used for type. -->
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#9A3412" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#7C2D12" />
    <SolidColorBrush x:Key="OnAccentButtonBrush" Color="#FFFFFF" />

    <!-- Local AI: violet, kept apart from the clay accent. -->
    <Color x:Key="AiGlowColor">#FF8D75B8</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#6B4FA0" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#7D62B3" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#513879" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#EFE9F7" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#C7B8E0" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#3A2A5A" />

    <SolidColorBrush x:Key="HoverBrush" Color="#F3EFE8" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#ECE6DC" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1B16" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4F483F" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5C554B" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#5C554B" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#3A332C" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#F7F4EE" />
    <Color x:Key="SurfaceAltColor">#FFF3EFE8</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFFFF</Color>
    <Color x:Key="TextSubtleColor">#FF5C554B</Color>
</ResourceDictionary>
