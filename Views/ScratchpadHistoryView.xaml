<UserControl x:Class="Sati.Views.ScratchpadHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="HistoryView_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="HistoryTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="{StaticResource NarrativeFont}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource NarrativeTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="HistoryLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- A single click selects one day. Dragging or Shift-clicking selects a range. -->
        <Border x:Name="PickerPanel"
                Grid.Row="0"
                Grid.Column="0"
                Padding="12"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="FIND A DAY"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Click one date, or drag across dates to select a continuous range."
                               Margin="0,5,0,12"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <Calendar x:Name="HistoryCalendar"
                              AutomationProperties.Name="Scratchpad history date or date range"
                              SelectionMode="SingleRange"
                              DisplayDateEnd="{Binding LatestSelectableDate, Mode=OneWay}"
                              SelectedDatesChanged="HistoryCalendar_SelectedDatesChanged"
                              HorizontalAlignment="Stretch" />

                    <Border Margin="0,14,0,0"
                            Padding="10"
                            Background="{DynamicResource WarningFillBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="HISTORY INTEGRITY"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="Original text stays locked. Anything added later is stored and shown as a separate, timestamped comment."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="ResultsPanel"
              Grid.Row="0"
              Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding SelectionSummary}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{Binding EntryCountSummary}"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Width="38"
                        Height="38"
                        IsEnabled="{Binding CanToggleEditor}"
                        Command="{Binding ToggleEditorCommand}"
                        ToolTip="{Binding EditorToolTip}"
                        AutomationProperties.Name="Lock or unlock retrospective comment editor">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE72E;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditorUnlocked}" Value="True">
                                        <Setter Property="Text" Value="&#xE785;" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Visibility="{Binding IsSelectionEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE787;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="No scratchpad entry was recorded in this selection."
                                   Margin="10"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasVisibleEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding VisibleEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="14"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:dddd, MMMM d, yyyy}}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   AutomationProperties.HeadingLevel="Level2" />

                                        <Border Margin="0,10,0,0"
                                                Padding="11"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72E;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11"
                                                               Margin="0,0,6,0"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="ORIGINAL — ENTERED ON THIS DAY"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                                <TextBox Text="{Binding DisplayContent, Mode=OneWay}"
                                                         Margin="0,8,0,0"
                                                         IsReadOnly="True"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         Background="Transparent"
                                                         FontFamily="{StaticResource NarrativeFont}"
                                                         FontSize="14"
                                                         Foreground="{DynamicResource NarrativeTextBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl Margin="0,10,0,0"
                                                      ItemsSource="{Binding Comments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8"
                                                            Padding="12,10"
                                                            Background="{DynamicResource WarningFillBrush}"
                                                            BorderBrush="{DynamicResource WarningBrush}"
                                                            BorderThickness="4,0,0,0"
                                                            CornerRadius="4">
                                                        <StackPanel>
                                                            <TextBlock FontSize="10"
                                                                       FontWeight="Bold"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource WarningBrush}"
                                                                       Text="{Binding DisplayHeader, Mode=OneWay}" />
                                                            <TextBlock Text="{Binding Content, Mode=OneWay}"
                                                                       Margin="0,7,0,0"
                                                                       FontFamily="{StaticResource NarrativeFont}"
                                                                       FontSize="14"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource NarrativeTextBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Panel.ZIndex="2"
                        Background="{DynamicResource SurfaceAlpha70Brush}"
                        IsHitTestVisible="True"
                        AutomationProperties.Name="Loading scratchpad history"
                        AutomationProperties.LiveSetting="Polite"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ProgressBar Width="150"
                                     Height="5"
                                     IsIndeterminate="True" />
                        <TextBlock Text="Loading history…"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Margin="0,10,0,0"
                    Padding="12"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="{Binding IsEditorUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="ADD A RETROSPECTIVE COMMENT"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBox Grid.Row="1"
                             Style="{StaticResource HistoryTextBoxStyle}"
                             AutomationProperties.Name="Retrospective scratchpad comment"
                             Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,7,0,10"
                             MinHeight="76"
                             MaxHeight="150"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="This is timestamped and cannot alter the original text."
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding CancelCommentCommand}"
                                Content="Cancel"
                                Margin="10,0,8,0" />
                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommentCommand}"
                                IsEnabled="{Binding CanSaveComment}"
                                Content="Save comment" />
                    </Grid>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3"
                       Text="{Binding StatusMessage}"
                       Margin="2,8,0,0"
                       VerticalAlignment="Bottom"
                       FontSize="11"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorUnlocked}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
