<Window x:Class="Sati.Views.UndocumentedDayPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Days about to fall out of the billing window"
        Width="620" Height="460" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.FontFamily="{StaticResource AppFont}"
        AutomationProperties.Name="Undocumented workday reminder">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="Explanation" Grid.Row="1" Margin="0,7,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OverdueBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="8">
            <ListBox x:Name="DayList" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Workdays with nothing documented">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,10" Margin="0,0,0,6"
                                Background="{DynamicResource PersonGroupAltBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="{Binding DayLabel}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding DeadlineLabel}" Margin="0,3,0,0"
                                           Foreground="{DynamicResource OverdueBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="5" TextWrapping="Wrap" Margin="0,0,0,14"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="If one of these days genuinely produced nothing billable, tick it on the calendar as having no billable work. It stays out of the average as a zero, and the rest of the month still has to make up its units." />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LaterButton" Content="Not now" Padding="16,7" MinWidth="110"
                    IsCancel="True"
                    AutomationProperties.Name="Close this reminder without writing the notes"
                    Click="Later_Click" />
            <Button x:Name="WriteNowButton" Content="Write them now" Padding="16,7" MinWidth="150"
                    Margin="10,0,0,0" IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="Stay in Sati and write these notes now"
                    Click="WriteNow_Click" />
        </StackPanel>
    </Grid>
</Window>
