<Window x:Class="Sati.Views.TimeOffCheckRequestPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time off and weekly check requests"
        Width="680" Height="455" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        AutomationProperties.Name="Time-off check-request reminder">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="16" /><RowDefinition Height="*" />
            <RowDefinition Height="16" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Heading}" FontSize="23" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Grid.Row="1" Text="{Binding Explanation}" Margin="0,7,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="8">
            <ListBox ItemsSource="{Binding Collisions}" SelectedItem="{Binding SelectedCollision}"
                     BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Check requests affected by scheduled time off">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,7"
                                Background="{DynamicResource PersonGroupAltBrush}" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ConsumerName}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding PayableTo, StringFormat=Payable to {0}}" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding PendingCheckRequestId, StringFormat=Existing pending request #{0}}"
                                               FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:C2}}"
                                           FontWeight="SemiBold" Margin="18,0,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Preparing creates or opens a draft only. It does not submit, approve, or release a check."
                       VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" Margin="0,0,18,0"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <Button Grid.Column="1" Content="Later" MinWidth="100" IsCancel="True"
                    Click="Later_Click" AutomationProperties.Name="Handle time-off check requests later" />
            <Button Grid.Column="3" Content="Prepare now" MinWidth="125" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Prepare_Click"
                    AutomationProperties.Name="Prepare check request before time off" />
        </Grid>
    </Grid>
</Window>
