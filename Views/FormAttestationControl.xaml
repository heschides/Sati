<UserControl x:Class="Sati.Views.FormAttestationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
    <Border Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="5"
            Padding="12"
            Margin="0,8,0,8">
        <StackPanel>
            <TextBlock Text="{Binding ContextLabel}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       AutomationProperties.HeadingLevel="Level3" />
            <TextBlock Text="{Binding StatusText}"
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding RetentionNotice}"
                       Margin="0,5,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding PlanYearWarning}"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}"
                       Visibility="{Binding HasPlanYearWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding CurrentAttestationEvidenceText}"
                       Margin="0,3,0,0"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Visibility="{Binding HasCurrentAttestationEvidence, Converter={StaticResource BoolToVisibilityConverter}}"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Visibility="{Binding IsReclassification, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,3,0,8">
                <TextBlock Text="{Binding PrerequisiteSummary}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding PrerequisiteError}"
                       Foreground="{DynamicResource DangerStrongBrush}"
                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive" />

            <StackPanel Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="ACTUAL COMPLETION DATE"
                           Style="{StaticResource LabelStyle}" />
                <DatePicker Width="170"
                            HorizontalAlignment="Left"
                            SelectedDate="{Binding CompletionDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Form attestation completion date"
                            AutomationProperties.HelpText="Choose the date the form was actually completed. This field starts blank." />
                <TextBlock Text="{Binding CompletionDateError}"
                           Foreground="{DynamicResource DangerStrongBrush}"
                           FontSize="11"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <StackPanel Visibility="{Binding IsAssessmentDateRequired, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,10,0,0">
                    <TextBlock Text="ACTUAL COMPREHENSIVE ASSESSMENT COMPLETION DATE"
                               Style="{StaticResource LabelStyle}" />
                    <DatePicker Width="170"
                                HorizontalAlignment="Left"
                                SelectedDate="{Binding ComprehensiveAssessmentCompletionDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Comprehensive Assessment actual completion date"
                                AutomationProperties.HelpText="Required because this Reclassification implies the Comprehensive Assessment was completed. Sati records a separate attestation for each." />
                    <TextBlock Text="{Binding ComprehensiveAssessmentCompletionDateError}"
                               Foreground="{DynamicResource DangerStrongBrush}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
                <CheckBox IsChecked="{Binding HasConfirmedEvergreenCompletion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,10,0,0"
                          MaxWidth="620"
                          HorizontalAlignment="Left"
                          Visibility="{Binding RequiresEvergreenConfirmation, Converter={StaticResource BoolToVisibilityConverter}}"
                          AutomationProperties.Name="Confirm Evergreen form completion attestation"
                          AutomationProperties.HelpText="Required before recording a timestamped billing-compliance attestation.">
                    <TextBlock Text="{Binding AttestationStatement}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </CheckBox>
                <TextBlock Text="Check the Evergreen completion box above to enable this button."
                           Visibility="{Binding NeedsEvergreenConfirmation, Converter={StaticResource BoolToVisibilityConverter}}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <Border Margin="0,10,0,0" Padding="10"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1" CornerRadius="5"
                        Visibility="{Binding HasScheduledNoteConversionPrompt, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ScheduledNoteConversionPrompt}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Use this note and record completion"
                                    Command="{Binding ConfirmScheduledNoteConversionCommand}"
                                    AutomationProperties.Name="Use scheduled note as a draft and record form completion"
                                    Padding="12,6" />
                            <Button Content="Go back"
                                    Command="{Binding CancelScheduledNoteConversionCommand}"
                                    Margin="8,0,0,0" Padding="12,6" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                            Visibility="{Binding HasScheduledNoteConversionPrompt, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Button Content="Record timestamped attestation"
                            Command="{Binding CompleteAttestationCommand}"
                            AutomationProperties.Name="Complete form attestation"
                            Padding="12,6" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Margin="8,0,0,0"
                            Padding="12,6" />
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="WHY IS THIS ATTESTATION BEING REVOKED?"
                           Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding RevocationReason, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="280"
                         MaxLength="500"
                         AutomationProperties.Name="Form attestation revocation reason" />
                <TextBlock Text="{Binding RevocationReasonError}"
                           Foreground="{DynamicResource DangerStrongBrush}"
                           FontSize="11"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Revoke attestation"
                            Command="{Binding RevokeAttestationCommand}"
                            AutomationProperties.Name="Revoke form attestation"
                            Padding="12,6" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Margin="8,0,0,0"
                            Padding="12,6" />
                </StackPanel>
            </StackPanel>

            <Separator Margin="0,12,0,8" />
            <TextBlock Text="ATTESTATION HISTORY" Style="{StaticResource LabelStyle}" />
            <TextBlock Text="{Binding HistoryStatusText}"
                       Margin="0,2,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding HasHistoryStatus, Converter={StaticResource BoolToVisibilityConverter}}"
                       AutomationProperties.LiveSetting="Polite" />
            <ScrollViewer MaxHeight="190"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasAttestationHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding AttestationHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,7">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActionText}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DetailText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding ActorAndTimestampText}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ReasonText}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
