<Window x:Class="Sati.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sati"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        TextElement.FontFamily="{DynamicResource AppFont}"
        AutomationProperties.Name="Sati startup">

    <Border x:Name="WindowSurface"
            Width="760"
            Height="480"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <!-- A default instance preserves the brand presentation for design tools
                 and existing view tests. Runtime startup uses the preparation mode
                 only after authentication; it no longer imposes a fixed splash wait. -->
            <Grid x:Name="BrandingContent"
                  Margin="48,34,48,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Row="0"
                       Grid.Column="0"
                       Source="{DynamicResource BrandLeafImage}"
                       Width="240"
                       Height="330"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="Sati"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="64"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Case Management"
                               Margin="3,-4,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Width="76"
                            Height="3"
                            Margin="3,24,0,22"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="2" />
                    <TextBlock Text="by Robin-Bradley AMS"
                               Margin="3,0,0,0"
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel x:Name="BrandingActivityDots"
                            Orientation="Horizontal"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="6,0" Fill="{DynamicResource AccentBrush}" />
                    <Ellipse Width="10" Height="10" Margin="6,0" Fill="{DynamicResource AccentBrush}" />
                    <Ellipse Width="10" Height="10" Margin="6,0" Fill="{DynamicResource AccentBrush}" />
                    <Ellipse Width="10" Height="10" Margin="6,0" Fill="{DynamicResource AccentBrush}" />
                    <Ellipse Width="10" Height="10" Margin="6,0" Fill="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="WorkspacePreparationContent"
                  Visibility="Collapsed"
                  Margin="58,38,58,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Source="{DynamicResource BrandLeafImage}"
                       Width="86"
                       Height="86"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Row="1"
                            Margin="0,10,0,0">
                    <TextBlock Text="We are preparing the Sati workspace."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               AutomationProperties.Name="We are preparing the Sati workspace."
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="Sati is gathering the information you need. Your workspace will appear automatically when it is ready."
                               Margin="24,8,24,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               LineHeight="20"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="0,22,0,18"
                        Padding="26,20"
                        CornerRadius="12"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="A Sati reflection"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <!-- Deliberately not a live region. Slowly changing prose
                             should never interrupt a screen-reader user's status. -->
                        <TextBlock x:Name="ReflectionText"
                                   Margin="0,11,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource NarrativeFont}"
                                   FontSize="16"
                                   FontStyle="Italic"
                                   LineHeight="24"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3"
                            HorizontalAlignment="Center">
                    <StackPanel x:Name="PreparationActivityDots"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Workspace preparation is in progress">
                        <Ellipse Width="8" Height="8" Margin="5,0" Fill="{DynamicResource AccentBrush}" />
                        <Ellipse Width="8" Height="8" Margin="5,0" Fill="{DynamicResource AccentBrush}" />
                        <Ellipse Width="8" Height="8" Margin="5,0" Fill="{DynamicResource AccentBrush}" />
                        <Ellipse Width="8" Height="8" Margin="5,0" Fill="{DynamicResource AccentBrush}" />
                        <Ellipse Width="8" Height="8" Margin="5,0" Fill="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="Still working — no action is needed"
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               AutomationProperties.Name="Workspace preparation is in progress. No action is needed."
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
