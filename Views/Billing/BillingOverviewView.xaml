<UserControl x:Class="Sati.Views.Billing.BillingOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:billingViews="clr-namespace:Sati.Views.Billing"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{DynamicResource AppFont}">
    <UserControl.Resources>
        <Style x:Key="BillingMetricCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#44000000" BlurRadius="16"
                                      ShadowDepth="3" Direction="270" Opacity="0.14" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BillingMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="BillingMetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Margin="28,24,28,36" MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BILLING PULSE" Style="{StaticResource SectionHeader}" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="See revenue moving from documented service to payment, with exceptions visible before they become denials." />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Margin="16,0,0,0"
                        VerticalAlignment="Top" Style="{StaticResource SmallButton}"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh billing dashboard" />
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource BillingMetricCard}" Margin="0,0,6,0"
                        AutomationProperties.Name="Revenue ready for billing">
                    <Grid>
                        <Border Height="3" Margin="-16,-14,-16,0" VerticalAlignment="Top"
                                CornerRadius="8,8,0,0" Background="{DynamicResource AccentBrush}" />
                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="{Binding ReadyRevenueLabel}" Style="{StaticResource BillingMetricValue}"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="READY TO BILL" Style="{StaticResource BillingMetricLabel}" />
                            <TextBlock Text="{Binding ReadinessDetail}" FontSize="11" Margin="0,7,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource BillingMetricCard}" Margin="6,0"
                        AutomationProperties.Name="Revenue in draft claims">
                    <Grid>
                        <Border Height="3" Margin="-16,-14,-16,0" VerticalAlignment="Top"
                                CornerRadius="8,8,0,0" Background="{DynamicResource InfoBrush}" />
                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="{Binding DraftRevenueLabel}" Style="{StaticResource BillingMetricValue}" />
                            <TextBlock Text="IN DRAFT" Style="{StaticResource BillingMetricLabel}" />
                            <TextBlock Text="Claim lines being prepared" FontSize="11" Margin="0,7,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource BillingMetricCard}" Margin="6,0"
                        AutomationProperties.Name="Charges created in the last six months">
                    <Grid>
                        <Border Height="3" Margin="-16,-14,-16,0" VerticalAlignment="Top"
                                CornerRadius="8,8,0,0" Background="{DynamicResource WorkflowPurpleBrush}" />
                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="{Binding BilledRevenueLabel}" Style="{StaticResource BillingMetricValue}" />
                            <TextBlock Text="6-MONTH CHARGES" Style="{StaticResource BillingMetricLabel}" />
                            <TextBlock Text="Draft and submitted claims" FontSize="11" Margin="0,7,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource BillingMetricCard}" Margin="6,0,0,0"
                        AutomationProperties.Name="Payments received in the last six months">
                    <Grid>
                        <Border Height="3" Margin="-16,-14,-16,0" VerticalAlignment="Top"
                                CornerRadius="8,8,0,0" Background="{DynamicResource ChartBlueBrush}" />
                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="{Binding PaidRevenueLabel}" Style="{StaticResource BillingMetricValue}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="6-MONTH PAYMENTS" Style="{StaticResource BillingMetricLabel}" />
                            <TextBlock Text="Posted remittance outcomes" FontSize="11" Margin="0,7,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource BillingMetricCard}" Padding="18,14"
                        ClipToBounds="True">
                    <Grid>
                        <Ellipse Width="520" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-170,-155" Fill="{DynamicResource AccentBrush}"
                                 Opacity="0.13" IsHitTestVisible="False">
                            <Ellipse.OpacityMask>
                                <RadialGradientBrush>
                                    <GradientStop Color="#E6000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.OpacityMask>
                        </Ellipse>
                    <StackPanel>
                        <TextBlock Text="REVENUE MOMENTUM" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Charges created and payments posted · rolling six months"
                                   FontSize="11" Margin="0,4,0,4"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Charges" FontSize="10" Margin="5,0,16,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource ChartBlueBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Payments" FontSize="10" Margin="5,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Grid Height="260">
                            <oxy:PlotView x:Name="RevenueTrendChart"
                                          Model="{Binding RevenueTrendChartModel}"
                                          Background="Transparent"
                                          AutomationProperties.Name="Six month charges and payments chart" />
                            <TextBlock Text="Revenue history will appear as claims move through billing."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding HasRevenueData, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource BillingMetricCard}" Padding="18,14"
                        ClipToBounds="True">
                    <Grid>
                        <Ellipse Width="310" Height="310" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-140,-120,0" Fill="{DynamicResource ChartBlueBrush}"
                                 Opacity="0.12" IsHitTestVisible="False">
                            <Ellipse.OpacityMask>
                                <RadialGradientBrush>
                                    <GradientStop Color="#E6000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.OpacityMask>
                        </Ellipse>
                    <StackPanel>
                        <TextBlock Text="CLAIM OUTCOMES" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="How remitted claims resolved"
                                   FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid Height="198">
                            <Ellipse Width="160" Height="160" Fill="{DynamicResource SurfaceBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#55000000" BlurRadius="18"
                                                      ShadowDepth="5" Direction="270" Opacity="0.24" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <oxy:PlotView x:Name="ClaimOutcomeChart"
                                          Model="{Binding ClaimOutcomeChartModel}"
                                          Background="Transparent"
                                          AutomationProperties.Name="Claim outcomes chart" />
                            <Ellipse Width="108" Height="108" Fill="{DynamicResource SurfaceRaisedBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#30000000" BlurRadius="8"
                                                      ShadowDepth="1" Direction="270" Opacity="0.18" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock Text="{Binding PaidClaimPercentLabel}" FontSize="28" FontWeight="SemiBold"
                                           TextAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="paid" FontSize="10" TextAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="3" Margin="2,3,2,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource ChartBlueBrush}" />
                                <TextBlock Text="{Binding PaidOutcomeLabel}" FontSize="10" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource ChartGoldBrush}" />
                                <TextBlock Text="{Binding PartialOutcomeLabel}" FontSize="10" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource ChartCopperBrush}" />
                                <TextBlock Text="{Binding AttentionOutcomeLabel}" FontSize="10" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource BillingMetricCard}" Padding="20,18" Margin="0,0,0,18"
                    AutomationProperties.Name="Form and release date billing reviews">
                <StackPanel>
                    <TextBlock Text="FORM AND RELEASE DATE CHANGES" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding FormChangeReviewSummary}" Margin="0,6,0,10"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,0,0,12"
                            Visibility="{Binding CanAdminCorrectFormDate, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.Name="Admin form or release note source date correction">
                        <StackPanel>
                            <TextBlock Text="ADMIN SOURCE DATE CORRECTION" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="Enter a note ID to inspect a linked form or release note, including an approved note that has no change notice. The correction updates the note activity date and completion attestation together; it does not waive a late deadline."
                                       TextWrapping="Wrap" Margin="0,4,0,8"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Text="{Binding CorrectionNoteIdText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100" Height="30" Margin="0,0,8,0"
                                         AutomationProperties.Name="Form or release note ID to correct" />
                                <Button Content="Look up note" Command="{Binding FindFormDateCorrectionTargetCommand}"
                                        AutomationProperties.Name="Look up note source date" />
                            </StackPanel>
                            <TextBlock Text="{Binding CorrectionStatusMessage}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}"
                                       AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8" />
                            <StackPanel Visibility="{Binding HasCorrectionTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding CorrectionTargetSummary}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Actual date the work was done" Margin="0,0,0,3"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <DatePicker SelectedDate="{Binding CorrectedActivityDate, Mode=TwoWay}"
                                            AutomationProperties.Name="Corrected note activity date"
                                            Margin="0,0,0,8" />
                                <TextBlock Text="Why was the source date wrong?" Margin="0,0,0,3"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBox Text="{Binding CorrectionReason, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                                         Height="72" Margin="0,0,0,8"
                                         AutomationProperties.Name="Note date correction reason" />
                                <CheckBox Content="I checked the source record and confirm this is the actual date of work."
                                          IsChecked="{Binding CorrectionEvidenceConfirmed, Mode=TwoWay}"
                                          AutomationProperties.Name="Confirm source date correction evidence"
                                          Margin="0,0,0,8" />
                                <Button Content="Save source correction"
                                        HorizontalAlignment="Left"
                                        Command="{Binding SaveFormDateCorrectionCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding FormChangeReviewFlags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RecordLabel}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DateLabel}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ReasonLabel}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ClaimLabel}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding HoldLabel}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding RecordedLabel}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Button Content="Review source date (Admin)"
                                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                                Visibility="{Binding DataContext.CanAdminCorrectFormDate, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.ReviewFormDateFlagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding NoteId}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BillingMetricCard}" Padding="20,18" Margin="0,0,0,18"
                    AutomationProperties.Name="Unresolved billing policy review queue">
                <StackPanel>
                    <TextBlock Text="POLICY CHANGE REVIEWS" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Submitted notes and finalized claim records are never silently rewritten when an effective-dated compliance rule changes. Each affected record remains here as unresolved until a later review workflow explicitly resolves it."
                               Margin="0,6,0,5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding BillingPolicyReviewSummary}"
                               Margin="0,0,0,12" TextWrapping="Wrap" FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding BillingPolicyReviewFlags}"
                                  Visibility="{Binding HasBillingPolicyReviewFlags, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="12" Margin="0,0,0,8"
                                        AutomationProperties.Name="{Binding RecordLabel}"
                                        AutomationProperties.HelpText="{Binding BlockerLabel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding RecordLabel}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ChangeLabel}" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DateLabel}"
                                                   Margin="0,0,12,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding BlockerLabel}"
                                                   Margin="0,0,12,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding StatusLabel}"
                                                   TextWrapping="Wrap" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BillingMetricCard}" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="BILLING CONFIGURATION" Style="{StaticResource SectionHeader}" />
                    <TextBlock Margin="0,6,0,20" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="These agency-level values control claim creation and the 837P envelope. The billing queue remains blocked until every required value is valid." />

                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Procedure code" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding ProcedureCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Billing procedure code" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Modifier (optional)" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding Modifier, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Billing modifier" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Rate per unit" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding UnitRate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Billing unit rate" />
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="EDI submitter ID" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding EdiSubmitterId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="EDI submitter ID" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Payer ID" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding PayerId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payer ID" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Payer name" Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding PayerName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payer name" />
                    </StackPanel>

                    <UniformGrid Columns="2" Margin="0,0,0,20">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="EDI contact name" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="EDI contact name" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="EDI contact telephone" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="EDI contact telephone" />
                        </StackPanel>
                    </UniformGrid>

                    <Button Content="Save Billing Configuration" Width="220" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Border>

            <billingViews:ComplianceRecoveryWorkspace
                DataContext="{Binding ComplianceRecovery}"
                Margin="0,18,0,0" />

            <TextBlock Margin="0,12,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
