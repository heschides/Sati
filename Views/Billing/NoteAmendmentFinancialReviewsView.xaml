<UserControl x:Class="Sati.Views.Billing.NoteAmendmentFinancialReviewsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="12">
        <TextBlock Text="Approved note financial review" FontSize="18" />
        <TextBlock Text="Clinical approval does not authorize a financial change. Review the exact approved service facts. This action does not alter existing claims or send a file." TextWrapping="Wrap" Margin="0,8" />
        <WrapPanel><Button Content="Load reviews" Command="{Binding LoadCommand}" /><Button Content="More reviews" Command="{Binding MoreCommand}" Margin="8,0" /></WrapPanel>
        <ListBox ItemsSource="{Binding Queue}" SelectedItem="{Binding Selected}" MaxHeight="220" AutomationProperties.Name="Approved financial amendments"><ListBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding ClientName, Mode=OneWay}" /><Run Text="; version " /><Run Text="{Binding ApprovedVersionId, Mode=OneWay}" /><Run Text="; reviewed " /><Run Text="{Binding Reviewed, Mode=OneWay}" /></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox>
        <TextBlock Text="Original service facts" Margin="0,8" /><TextBlock Text="{Binding Selected.OriginalService}" TextWrapping="Wrap" />
        <TextBlock Text="Corrected approved service facts" Margin="0,8" /><TextBlock Text="{Binding Selected.CorrectedService}" TextWrapping="Wrap" />
        <TextBlock Text="Financial review explanation" Margin="0,8" /><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AutomationProperties.Name="Financial amendment review explanation" />
        <Button Content="Confirm financial review of this exact version" Command="{Binding ReviewCommand}" Margin="0,8" />
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
