<UserControl x:Class="Sati.Views.Billing.ComplianceRecoveryWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Visibility="{Binding CanManageComplianceRecovery, Converter={StaticResource BoolToVisibilityConverter}}"
             AutomationProperties.Name="Administrator compliance recovery workspace">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18"
                AutomationProperties.Name="Administrator compliance recovery">
            <StackPanel>
                <TextBlock Text="COMPLIANCE RECOVERY"
                           Style="{StaticResource SectionHeader}" />
                <TextBlock Margin="0,6,0,16"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="After overdue requirements are completed, review the exact unbilled notes that fell inside the compliance gap. This creates an immutable administrator decision; it never rewrites submitted, finalized, or already-billed records." />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="CONSUMER"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="RecoveryPersonComboBox"
                                  ItemsSource="{Binding RecoveryPeople}"
                                  SelectedItem="{Binding SelectedRecoveryPerson}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsRecoveryBusy, Converter={StaticResource InverseBoolConverter}}"
                                  MaxDropDownHeight="320"
                                  AutomationProperties.Name="Consumer for compliance recovery" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Find eligible notes"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding LoadRecoveryPlanCommand}"
                            AutomationProperties.Name="Find eligible notes for compliance recovery" />
                </Grid>

                <ItemsControl ItemsSource="{Binding RecoveryNotes}"
                              Visibility="{Binding HasRecoveryNotes, Converter={StaticResource BoolToVisibilityConverter}}"
                              AutomationProperties.Name="Eligible unbilled note checklist"
                              Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          AutomationProperties.Name="{Binding NoteLabel}"
                                          AutomationProperties.HelpText="{Binding BlockerLabel}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding NoteLabel}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding BlockerLabel, StringFormat=Resolved blockers: {0}}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding HasRecoveryNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="EXPLANATION"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox Text="{Binding RecoveryExplanation, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="64"
                             MaxLength="4000"
                             AutomationProperties.Name="Compliance recovery explanation"
                             Margin="0,0,0,10" />
                    <CheckBox IsChecked="{Binding RecoveryAttestationConfirmed}"
                              AutomationProperties.Name="Administrator compliance recovery attestation"
                              Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap"
                                   Text="I attest that the listed compliance obligations were completed on the recorded dates and authorize billing eligibility only for the selected unbilled notes." />
                    </CheckBox>
                    <Button Content="Record recovery decision"
                            Width="220"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RecordComplianceRecoveryCommand}"
                            AutomationProperties.Name="Record immutable compliance recovery decision" />
                </StackPanel>

                <TextBlock Text="{Binding RecoveryStatus}"
                           AutomationProperties.LiveSetting="Assertive"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
