<Window x:Class="Sati.Views.PhotoCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop profile photo"
        Width="720" Height="600" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.FontFamily="{DynamicResource AppFont}"
        AutomationProperties.Name="Crop profile photo">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Crop the profile photo" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,14" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Drag the square to choose what shows. Use the size slider or the mouse wheel to make it larger or smaller. From the keyboard, arrow keys move it (hold Shift to move faster) and plus or minus change its size." />

        <!-- The photo, scaled to fit, with everything outside the square dimmed. -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                Padding="8">
            <Canvas x:Name="Surface" HorizontalAlignment="Center" VerticalAlignment="Center"
                    ClipToBounds="True" Background="Transparent" Cursor="SizeAll"
                    MouseLeftButtonDown="Surface_MouseLeftButtonDown"
                    MouseMove="Surface_MouseMove"
                    MouseLeftButtonUp="Surface_MouseLeftButtonUp"
                    LostMouseCapture="Surface_LostMouseCapture"
                    MouseWheel="Surface_MouseWheel">
                <Image x:Name="PhotoImage" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="Photo being cropped" />
                <Path x:Name="DimOverlay" Fill="#99000000" IsHitTestVisible="False" />
                <Border x:Name="CropFrame" BorderBrush="White" BorderThickness="2"
                        Focusable="True"
                        KeyDown="CropFrame_KeyDown"
                        GotKeyboardFocus="CropFrame_FocusChanged"
                        LostKeyboardFocus="CropFrame_FocusChanged"
                        AutomationProperties.Name="Crop square. Arrow keys move it; plus and minus change its size.">
                    <Border x:Name="CropFrameInner" BorderBrush="#CC000000" BorderThickness="1" Margin="0" />
                </Border>
            </Canvas>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="20,0,0,0" Width="150">
            <TextBlock Text="Preview" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="As it will appear in the client's profile." Margin="0,3,0,10"
                       TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <!-- Matches the bio frame: 116 square, 12 corner radius, 3 inset. -->
            <Border Width="116" Height="116" CornerRadius="12" HorizontalAlignment="Left"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid Margin="3">
                    <Image x:Name="PreviewImage" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Preview of the cropped profile photo" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SizeLabel" Text="Size" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Slider x:Name="SizeSlider" Grid.Column="1" VerticalAlignment="Center"
                    SmallChange="8" LargeChange="64"
                    ValueChanged="SizeSlider_ValueChanged"
                    AutomationProperties.Name="Crop square size"
                    AutomationProperties.LabeledBy="{Binding ElementName=SizeLabel}" />
            <Button x:Name="ResetButton" Grid.Column="2" Content="Reset" Padding="12,5" Margin="12,0,0,0"
                    AutomationProperties.Name="Reset the crop to the largest square"
                    Click="Reset_Click" />
        </Grid>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Padding="16,7" MinWidth="110" IsCancel="True"
                    AutomationProperties.Name="Cancel without changing the photo"
                    Click="Cancel_Click" />
            <Button x:Name="UseButton" Content="Use this photo" Padding="16,7" MinWidth="150"
                    Margin="10,0,0,0" IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="Save the cropped photo to this client's profile"
                    Click="Use_Click" />
        </StackPanel>
    </Grid>
</Window>
