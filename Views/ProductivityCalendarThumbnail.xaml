<UserControl x:Class="Sati.Views.ProductivityCalendarThumbnail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False">

    <!-- Read-only glance at this month on the Overview. The tint is the whole message:
         green days have logged or approved units in the daily average, pale days with a
         pink border are in it through pending notes only. The screen-reader name carries
         the same counts (ProductivityMonthSummary), so nothing here depends on colour. -->
    <UserControl.Resources>
        <Style x:Key="ThumbnailDayStyle" TargetType="Border">
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="1.5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CountsWithSecuredUnits}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ProductivityDayFillBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CountsWithoutSecuredUnits}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ProductivityPendingDayFillBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ProductivityPendingDayBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <UniformGrid Columns="7" Margin="0,0,0,1">
            <TextBlock Text="S" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="M" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="T" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="W" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="T" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="F" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="S" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        </UniformGrid>
        <ItemsControl ItemsSource="{Binding Cells}"
                      Focusable="False"
                      IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border Height="14" Margin="1.5"
                                Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" />
                        <Border Style="{StaticResource ThumbnailDayStyle}"
                                ToolTip="{Binding AccessibleLabel}"
                                Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
