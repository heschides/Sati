<UserControl x:Class="Sati.Views.CaseManagerDashboardContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sati="clr-namespace:Sati;assembly=Sati.Persistence"
             xmlns:vm="clr-namespace:Sati.ViewModels"
             xmlns:views="clr-namespace:Sati.Views"
             xmlns:models="clr-namespace:Sati.Models;assembly=Sati.Persistence"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{DynamicResource AppFont}">

    <!-- Escape returns the note panel to a blank New Note and drops the notes
         grid's highlight with it. The selected CLIENT survives — it scopes this
         whole page. Declared here as well as on the module so the key works from
         every Overview pane, not only from inside the form. -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding NoteEntry.StartNewNoteCommand}" />
    </UserControl.InputBindings>

    <!-- The three primary Overview panes keep fixed jobs: current note, Work Agenda,
         and Upcoming Due Dates. Code-behind changes only their size and, in the
         narrowest tier, stacks them vertically. The dedicated Notes, Reviews, Clients,
         and Statistics workspaces retain the deeper versions of those features. -->
    <Grid x:Name="AdaptiveGrid"
          Margin="12"
          SizeChanged="AdaptiveGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: NOTE ENTRY MODULE ═══
             Shared UserControl, rendered via the NoteEntryViewModel DataTemplate.
             The module carries its own border, padding, and compliance overlay. -->
        <ContentControl x:Name="NoteHost"
                        Grid.Column="0"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        AutomationProperties.Name="Current note panel"
                        Content="{Binding NoteEntry}" />

        <!-- ShellWindow moves its one live Work Agenda view into this host while
              Overview is active, preserving both dated drafts and editor state. -->
        <ContentControl x:Name="AgendaHost"
                        Grid.Column="2"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        AutomationProperties.Name="Work Agenda panel" />

        <!-- ═══ BELOW WORK AGENDA: MONTHLY PRODUCTIVITY ═══ -->
        <Border x:Name="SummaryHost"
                Grid.Column="2"
                Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,10,0,0"
                AutomationProperties.Name="Monthly productivity panel">
            <ScrollViewer AutomationProperties.Name="Monthly productivity summary"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="2">
                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                        <TextBlock Text="YOUR MONTHLY PRODUCTIVITY"
                                   Style="{StaticResource SectionHeader}"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource IconButton}"
                                Content="&#xE76B;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Width="26" Height="24"
                                Command="{Binding PreviousProductivityMonthCommand}"
                                ToolTip="Previous productivity month"
                                AutomationProperties.Name="Previous productivity month" />
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding ProductivityPeriodLabel}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="9,0"
                                   MinWidth="96"
                                   TextAlignment="Center"
                                   AutomationProperties.Name="Selected productivity month" />
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource IconButton}"
                                Content="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Width="26" Height="24"
                                Command="{Binding NextProductivityMonthCommand}"
                                ToolTip="Next productivity month"
                                AutomationProperties.Name="Next productivity month" />
                    </DockPanel>

                    <!-- The calendar shares the top row with the numbers. Its width is fixed
                         so the seven day columns stay legible at wide window sizes. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="172" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding IsCurrentProductivityMonth, Converter={StaticResource BoolToVisibilityConverter}}">
                            <UniformGrid Columns="4" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="RECOVERABLE" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding RecoverableUnits}" FontSize="18"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="SECURED" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding SecuredUnits}" FontSize="18"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="ABANDONED" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding AbandonedUnits}" FontSize="18"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="DOCUMENTED AVG" Style="{StaticResource LabelStyle}"
                                               ToolTip="Average known units on documented service days this month." />
                                    <TextBlock Text="{Binding DailyAverageUnits, StringFormat={}{0:F1}}"
                                               FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DailyAverageBasis}" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource LabelStyle}" Margin="0">
                                <Run Text="{Binding SecuredUnits, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Threshold, Mode=OneWay}" />
                                <Run Text=" units secured" />
                            </TextBlock>
                            <ProgressBar Minimum="0"
                                         Maximum="{Binding SafeThreshold, TargetNullValue=1, FallbackValue=1}"
                                         Value="{Binding SecuredUnits, Mode=OneWay}"
                                         Height="6" Margin="0,3,0,6"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource BorderBrush}"
                                         BorderThickness="0" />
                            <UniformGrid Columns="4">
                                <StackPanel>
                                    <TextBlock Text="PROJECTED / DAY" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding ProjectedPace, StringFormat={}{0:F1}, TargetNullValue='—'}"
                                               FontSize="17" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="SECURED / DAY" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding SecuredPace, StringFormat={}{0:F1}, TargetNullValue='—'}"
                                               FontSize="17" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="DAYS TO CAPTURE" Style="{StaticResource LabelStyle}"
                                               ToolTip="{Binding PaceCapacityBasis}" />
                                    <TextBlock Text="{Binding PaceCapacityDays}"
                                               FontSize="17" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="EST. INCENTIVE" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding EstimatedIncentive, StringFormat=C}"
                                               FontSize="17" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>

                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding IsHistoricalProductivityMonth, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Visibility="{Binding HasHistoricalProductivityData, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="SECURED PRODUCTIVITY"
                                           Style="{StaticResource LabelStyle}" Margin="0,0,0,5" />
                                <UniformGrid Columns="4">
                                    <StackPanel>
                                        <TextBlock Text="SECURED UNITS" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{Binding HistoricalSecuredUnits}" FontSize="18"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="DOCUMENTED DAYS" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{Binding HistoricalDocumentedDays}" FontSize="18"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="SECURED / DAY" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{Binding HistoricalSecuredPerDay, StringFormat={}{0:F1}}"
                                                   FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="MONTH GOAL" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{Binding HistoricalGoalLabel}" FontSize="18"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Margin="0,12,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11">
                                    <Run Text="Goal reached: " />
                                    <Run Text="{Binding HistoricalAttainmentLabel, Mode=OneWay}" />
                                    <Run Text="  ·  Logged and approved notes only" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="Loading month…"
                                       Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding IsHistoricalProductivityLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{Binding HistoricalProductivityError}"
                                       Margin="0,5,0,0"
                                       Foreground="{DynamicResource DangerStrongBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       Visibility="{Binding HasHistoricalProductivityError, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <views:ProductivityCalendarThumbnail Grid.Column="2"
                                                             DataContext="{Binding ProductivityMonth}"
                                                             Width="172"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Top"
                                                             AutomationProperties.Name="{Binding DataContext.ProductivityMonthSummary, RelativeSource={RelativeSource AncestorType={x:Type views:CaseManagerDashboardContentView}}}"
                                                             ToolTip="Highlighted days have logged or approved units. In the current month, a pale highlighted day has pending notes only." />
                    </Grid>
                    <StackPanel Visibility="{Binding IsCurrentProductivityMonth, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{DynamicResource WarningFillBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6"
                                Margin="0,5,0,0"
                                AutomationProperties.Name="Documentation deadline warning"
                                Visibility="{Binding HasDueTodayRisk, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding DueTodayRiskMessage}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding PendingItemsWithoutUnitsMessage}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   AutomationProperties.Name="Unestimated pending notes warning"
                                   Visibility="{Binding HasPendingItemsWithoutUnits, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ RIGHT: UPCOMING DUE DATES ═══ -->
        <Border x:Name="DeadlinesHost"
                Grid.Column="4"
                Grid.Row="0"
                Grid.RowSpan="3"
                AutomationProperties.Name="Upcoming due dates panel"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14">

            <Border.Resources>

                <!-- Tab pill: a RadioButton drawn as an underline pill. One GroupName
                     for the strip; each pill's IsChecked binds to SelectedTab through
                     EnumToBoolConverter — the same pattern the NoteType radios use, so
                     clicking a pill sets SelectedTab and the rest clear themselves. The
                     active styling lives on the IsChecked trigger, which is why one
                     shared style covers all eight. -->
                <Style x:Key="BoardPill"
                       TargetType="RadioButton">
                    <Setter Property="Margin"
                            Value="0,0,10,4" />
                    <Setter Property="Cursor"
                            Value="Hand" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter Property="FontSize"
                            Value="11" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="PillBorder"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent"
                                        Padding="0,0,0,3"
                                        Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked"
                                             Value="True">
                                        <Setter TargetName="PillBorder"
                                                Property="BorderBrush"
                                                Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Form row. Left bar colors by workflow state; the red triangle shows
                     only when overdue. The context menu reaches the VM through
                     PlacementTarget.Tag — the menu isn't in the visual tree, so it can't
                     inherit the VM as DataContext — and passes the row itself via
                     PlacementTarget.DataContext. -->
                <DataTemplate DataType="{x:Type vm:FormTaskRow}">
                    <Border Margin="0,2"
                            Padding="6,4"
                            CornerRadius="3"
                            BorderThickness="3,0,0,0"
                            Background="Transparent"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource InputBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static sati:FormWorkflowState.Opened}">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource OpenedFormBrush}" />
                                        <Setter Property="Background"
                                                Value="{DynamicResource OpenedFormFillBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static sati:FormWorkflowState.Completed}">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource CompliantBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Mark Opened"
                                          Command="{Binding PlacementTarget.Tag.MarkFormOpenedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Mark Completed"
                                          Command="{Binding PlacementTarget.Tag.MarkFormCompletedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- One line: name · type · dates. StackPanel aligns children
                                 by box, not baseline, so the mixed font sizes need explicit
                                 VerticalAlignment="Center" to sit level. -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal">
                                <TextBlock Text="{Binding ClientName}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="·"
                                           FontSize="12"
                                           Foreground="{DynamicResource InputBorderBrush}"
                                           Margin="7,0,7,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TypeLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="·"
                                           FontSize="12"
                                           Foreground="{DynamicResource InputBorderBrush}"
                                           Margin="7,0,7,0"
                                           VerticalAlignment="Center" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center">
                                    <Run Text="Open" />
                                    <Run Text="{Binding OpenByDate, StringFormat={}{0:MMM d}, Mode=OneWay}" />
                                    <Run Text="  ·  Due" />
                                    <Run Text="{Binding DueDate, StringFormat={}{0:MMM d}, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="▲"
                                       Foreground="{DynamicResource OverdueBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="6,0,2,0"
                                       Cursor="Help"
                                       ToolTip="{Binding OverdueTooltip}"
                                       Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </DataTemplate>

                <!-- Recipient-specific release row. Open routes to the Releases workspace
                     with this durable obligation selected; completion still happens there,
                     never through a category-level Form command. -->
                <DataTemplate DataType="{x:Type vm:ReleaseTaskRow}">
                    <Border Margin="0,2"
                            Padding="6,4"
                            CornerRadius="3"
                            BorderThickness="3,0,0,0"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            Background="Transparent"
                            AutomationProperties.Name="{Binding AutomationName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding ClientName}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="·"
                                           FontSize="12"
                                           Foreground="{DynamicResource InputBorderBrush}"
                                           Margin="7,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TypeLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="·"
                                           FontSize="12"
                                           Foreground="{DynamicResource InputBorderBrush}"
                                           Margin="7,0"
                                           VerticalAlignment="Center" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center">
                                    <Run Text="Open" />
                                    <Run Text="{Binding OpenByDate, StringFormat={}{0:MMM d}, Mode=OneWay}" />
                                    <Run Text="  ·  Due" />
                                    <Run Text="{Binding DueDate, StringFormat={}{0:MMM d}, Mode=OneWay}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding ActionLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="6,0,2,0">
                                <TextBlock Text="▲"
                                           Foreground="{DynamicResource OverdueBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"
                                           Cursor="Help"
                                           ToolTip="{Binding OverdueTooltip}"
                                           Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="Open"
                                        Command="{Binding DataContext.OpenReleaseTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanOpenExact}"
                                        Padding="9,3"
                                        AutomationProperties.Name="Open exact release obligation" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>

                <!-- Appointment row (scheduled visits/contacts/forms). Read-only. -->
                <DataTemplate DataType="{x:Type models:UpcomingEvent}">
                    <Border Margin="0,2"
                            Padding="6,4"
                            CornerRadius="3"
                            BorderThickness="3,0,0,0"
                            BorderBrush="{DynamicResource CompliantBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Date, StringFormat={}{0:MMM d}}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>

            </Border.Resources>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="UPCOMING DUE DATES"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,6"
                           AutomationProperties.HeadingLevel="Level2" />

                <Grid Grid.Row="1"
                      Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0">
                        <RadioButton Content="Comp Assessments"
                                     Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=CompAssessments}" />
                    <RadioButton Content="Reclasses"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Reclasses}" />
                    <RadioButton Content="PCPs"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Pcps}" />
                    <RadioButton Content="Releases"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Releases}" />
                    <RadioButton Content="Appointments"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Appointments}" />
                    <RadioButton Content="90-Day Reviews"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Reviews}" />
                    <RadioButton Content="Effective Dates"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=EffectiveDates}" />
                    <RadioButton Content="All"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=All}" />
                    </WrapPanel>

                    <!-- Date filter. One click advances the ring
                         (Overdue → 2/4/6/8/10/12 wks → All); the label is there because
                         eight states behind one glyph is a memory game. The dot binds to
                         TabHasOverdue, which counts the unfiltered tab — so it stays lit
                         while you're in a narrow window that hides the overdue items.
                         Hidden on Effective Dates, which has no date axis to narrow. -->
                    <Button Grid.Column="1"
                            AutomationProperties.Name="Change upcoming items date range"
                            AutomationProperties.HelpText="Cycles through overdue, two through twelve weeks, and all dates"
                            VerticalAlignment="Top"
                            Cursor="Hand"
                            Padding="6,0,0,0"
                            Command="{Binding CycleDateFilterCommand}"
                            Visibility="{Binding IsTaskListTab, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Click to change the date window">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <TextBlock Text="&#xE71C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{DynamicResource OverdueBrush}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,-1,-3,0"
                                         Visibility="{Binding TabHasOverdue, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock Text="{Binding DateFilterLabel, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Separator Grid.Row="2" />

                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsTaskListTab, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding BoardGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="8,7"
                                            CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource PersonGroupBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlternate}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource PersonGroupAltBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ClientName}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="3,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Items}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding BoardStateMessage}"
                               MaxWidth="300"
                               Margin="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding IsBoardStateVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                               AutomationProperties.Name="{Binding BoardStateMessage}"
                               AutomationProperties.LiveSetting="Polite" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEffectiveDatesTab, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding EffectiveDateGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            CornerRadius="4"
                                            Padding="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource HoverBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding ClientNames}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Board context-menu actions open the same deliberate attestation panel
             used by Clients and Reviews. It must live in this view or those actions
             would update an invisible view model. -->
        <views:FormAttestationControl Grid.Row="0"
                                      Grid.RowSpan="3"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="7"
                                      Panel.ZIndex="50"
                                      MaxWidth="720"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      DataContext="{Binding Attestation}" />

    </Grid>
</UserControl>
