<Window x:Class="Sati.Views.LeftoverScheduledWorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduled work that did not get done"
        Width="720" Height="540" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.FontFamily="{DynamicResource AppFont}"
        AutomationProperties.Name="Scheduled work that did not get done">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="Explanation" Grid.Row="1" Margin="0,7,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,10">
            <Button x:Name="MoveAllButton" Content="Move all to the next workday" Padding="12,5"
                    AutomationProperties.Name="Choose move to the next workday for every item"
                    Click="MoveAll_Click" />
            <Button x:Name="DeleteAllButton" Content="Delete all" Padding="12,5" Margin="8,0,0,0"
                    AutomationProperties.Name="Choose delete for every item"
                    Click="DeleteAll_Click" />
        </StackPanel>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="8">
            <ItemsControl x:Name="ItemList" Focusable="False"
                          AutomationProperties.Name="Scheduled items that did not get done">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,10" Margin="0,0,0,6"
                                Background="{DynamicResource PersonGroupAltBrush}" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Summary}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Details}" Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <RadioButton Content="{Binding MoveLabel}"
                                                 GroupName="{Binding GroupName}"
                                                 IsChecked="{Binding IsMove, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding MoveAutomationName}" />
                                    <RadioButton Content="Delete" Margin="0,4,0,0"
                                                 GroupName="{Binding GroupName}"
                                                 IsChecked="{Binding IsDelete, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding DeleteAutomationName}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StayOpenButton" Content="Keep Sati open" Padding="16,7" MinWidth="130"
                    IsCancel="True"
                    AutomationProperties.Name="Keep Sati open and change nothing"
                    Click="StayOpen_Click" />
            <Button x:Name="ApplyButton" Content="Apply and close" Padding="16,7" MinWidth="150"
                    Margin="10,0,0,0" IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="Move or delete these items as chosen, then close Sati"
                    Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
