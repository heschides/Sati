<Window x:Class="Sati.Views.ComplianceReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Sati.Converters"
        Title="Review Form Compliance"
        Width="440"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="LabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="36" />
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Review Form Compliance"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />

            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13"
                       Margin="0,0,0,16">
                <Run Text="Based on " />
                <Run Text="{Binding ClientName, Mode=OneWay}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
                <Run Text="'s effective date creates the obligations below. Nothing is completed automatically. Check a new obligation only when you can enter the date the work actually occurred. Existing records are changed through their individual attestation controls." />
            </TextBlock>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,16">
                <ScrollViewer MaxHeight="460"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox x:Name="ComplianceCheckBox"
                                              Grid.Row="0"
                                              Grid.Column="0"
                                              IsChecked="{Binding IsCompliant, Mode=TwoWay}"
                                              IsEnabled="{Binding IsEditable}"
                                              AutomationProperties.Name="{Binding Type, Converter={StaticResource EnumDescriptionConverter}}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0" />

                                    <Label Grid.Row="0"
                                           Grid.Column="1"
                                           Target="{Binding ElementName=ComplianceCheckBox}"
                                           Content="{Binding Type, Converter={StaticResource EnumDescriptionConverter}}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           Padding="0"
                                           VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="2"
                                               Text="{Binding DueDate, StringFormat={}{0:MMM d, yyyy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />

                                    <!-- The worker supplies the actual occurrence date. No
                                         due date or current timestamp is inferred. -->
                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Margin="0,4,0,0"
                                                Visibility="{Binding IsCompliant, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Completed"
                                                   Style="{StaticResource LabelStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <DatePicker AutomationProperties.Name="Completion date" SelectedDate="{Binding CompletedDate, Mode=TwoWay}"
                                                    IsEnabled="{Binding IsEditable}"
                                                    Width="140" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Text="{Binding ValidationMessage}"
                       Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibilityConverter}}"
                       Foreground="{DynamicResource DangerDarkBrush}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive"
                       Margin="0,0,0,12" />

            <Button Content="Confirm"
                    Style="{StaticResource PrimaryButton}"
                    Click="Confirm_Click" />
        </StackPanel>
    </Border>
</Window>
