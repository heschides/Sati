<Window x:Class="Sati.Views.CheckRequestPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weekly check requests"
        Width="720" Height="500" MinWidth="580" MinHeight="390"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        AutomationProperties.Name="Weekly check-request reminder">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Grid.Row="1" Text="{Binding Explanation}" Margin="0,7,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="8">
            <ListBox ItemsSource="{Binding Drafts}" SelectedItem="{Binding SelectedDraft}"
                     BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Generated check-request drafts">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,7"
                                Background="{DynamicResource PersonGroupAltBrush}" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ConsumerName}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                                        <Run Text="Scheduled " /><Run Text="{Binding ScheduledForDate, StringFormat={}{0:MMM d, yyyy}}" />
                                        <Run Text=" • Needed " /><Run Text="{Binding NeededByDate, StringFormat={}{0:MMM d, yyyy}}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding PayableTo, StringFormat=Payable to {0}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:C2}}" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,4,0,0"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="You can defer now; Sati will ask again on shutdown and on the next day."
                       VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,0,18,0" />
            <Button Grid.Column="1" Content="Defer" MinWidth="105" IsCancel="True"
                    Click="Defer_Click" AutomationProperties.Name="Defer weekly check requests" />
            <Button Grid.Column="3" Content="Review now" MinWidth="125" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Review_Click"
                    AutomationProperties.Name="Review generated check request now" />
        </Grid>
    </Grid>
</Window>
