<UserControl x:Class="Sati.Views.Finance.RepresentativePayeeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{DynamicResource AppFont}"
             TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="Refresh representative payee workspace" />
            <StackPanel>
                <TextBlock Text="REPRESENTATIVE PAYEE" FontSize="13" FontWeight="Bold" />
                <TextBlock Text="Only financial workflow data is shown here; clinical notes are not part of this workspace."
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="APPROVED CHECK REQUESTS" Style="{StaticResource LabelStyle}" Margin="0,0,0,4" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding CheckRequests}" SelectedItem="{Binding SelectedCheckRequest}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      AutomationProperties.Name="Finance check request queue">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CONSUMER" Binding="{Binding ConsumerName}" Width="140" />
                    <DataGridTextColumn Header="PAYABLE TO" Binding="{Binding PayableTo}" Width="*" />
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="90" />
                    <DataGridTextColumn Header="NEEDED" Binding="{Binding NeededByDate, StringFormat={}{0:d}}" Width="90" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="SELECTED REQUEST" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{Binding SelectedRequestStatus}" FontWeight="SemiBold" Margin="0,4,0,8" />
                    <TextBlock Text="{Binding SelectedCheckRequest.Reason}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button Content="Record check release" Command="{Binding ReleaseCommand}" IsEnabled="{Binding CanRelease}"
                            Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Record representative payee check release" />
                    <Button Content="Acknowledge receipt" Command="{Binding AcknowledgeReceiptCommand}"
                            IsEnabled="{Binding CanAcknowledgeReceipt}" Margin="0,8,0,0"
                            AutomationProperties.Name="Acknowledge representative payee check receipt" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="CONSUMER LEDGER" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding Consumers}" SelectedItem="{Binding SelectedConsumer}"
                              DisplayMemberPath="ConsumerName" AutomationProperties.Name="Representative payee consumer" Margin="0,4,0,12" />
                    <TextBlock Text="CURRENT BALANCE" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{Binding Balance, StringFormat={}{0:C}}" FontSize="24" FontWeight="Bold" Margin="0,3,0,14" />
                    <TextBlock Text="Add an entry" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DatePicker SelectedDate="{Binding LedgerEntryDate}" AutomationProperties.Name="Ledger entry date" Margin="0,0,0,8" />
                    <TextBox Text="{Binding LedgerAmount, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Ledger amount, positive received or negative spent" Margin="0,0,0,8" />
                    <TextBox Text="{Binding LedgerDescription, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Ledger description" Margin="0,0,0,8" />
                    <Button Content="Record ledger entry" Command="{Binding AddLedgerEntryCommand}"
                            IsEnabled="{Binding CanAddLedgerEntry}" Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="Corrections are entered as new transactions; saved history is never overwritten."
                               TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <DataGrid Grid.Column="2" ItemsSource="{Binding LedgerEntries}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" AutomationProperties.Name="Representative payee ledger">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DATE" Binding="{Binding EntryDate, StringFormat={}{0:d}}" Width="95" />
                    <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="105" />
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="95" />
                    <DataGridTextColumn Header="RECORDED BY" Binding="{Binding RecordedByName}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
