<UserControl x:Class="Sati.Views.ClientDocuments.CheckRequestsWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sati.Views.ClientDocuments"
             DataContextChanged="OnContextChanged"
             AutomationProperties.Name="Check requests">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Check requests" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="Create, review, and prepare representative-payee check requisitions for this consumer."
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="New request" Command="{Binding NewCommand}"
                    IsEnabled="{Binding CanCreate}" Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="Create a new check request" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="REQUEST HISTORY" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="3,2,3,8" />
                    <TextBlock Text="No requests yet." Foreground="{DynamicResource TextSecondaryBrush}" Margin="3"
                               Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                             BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Saved check requests">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9" Margin="0,0,0,6" Background="{DynamicResource PersonGroupAltBrush}" CornerRadius="6">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding RequestDate, StringFormat={}{0:MMM d, yyyy}}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding PayableTo, TargetNullValue=Payee not entered}" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Amount, StringFormat={}{0:C2}}" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                    </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="Request details" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <TextBlock Text="Request date" Style="{StaticResource LabelStyle}" />
                            <DatePicker SelectedDate="{Binding RequestDate}" AutomationProperties.Name="Request date" Margin="0,3,0,10" />
                            <TextBlock Text="Check payable to" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding PayableTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Check payable to" Margin="0,3,0,10" />
                            <TextBlock Text="Mailing address" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding MailingAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mailing address"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" Margin="0,3,0,10" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Amount" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Check amount" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Needed by" Style="{StaticResource LabelStyle}" />
                                    <DatePicker SelectedDate="{Binding NeededByDate}" AutomationProperties.Name="Date needed by" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Reason" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reason for check request"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="86" VerticalScrollBarVisibility="Auto" Margin="0,3,0,10" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" Margin="12" MaxWidth="270">
                            <TextBlock Text="Ready for a new request?" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" />
                            <TextBlock Text="{Binding EditorPrompt}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,14" />
                            <Button Content="Create draft" Command="{Binding NewCommand}" IsEnabled="{Binding CanCreate}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Create a new check request draft" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Border Background="{DynamicResource PersonGroupAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="CURRENT DELIVERY" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding DeliveryInstructions}" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding PublicationNote}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,9" />
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" Margin="0,0,0,9" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="Save draft" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}"
                                    AutomationProperties.Name="Save check request draft" />
                            <Button Grid.Column="2" Content="Publish PDF for email" Command="{Binding PublishCommand}" IsEnabled="{Binding CanPublish}"
                                    Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Publish and save check request PDF for email" />
                        </Grid>
                        <Button Content="Save prepared PDF again" Command="{Binding RegenerateCommand}" IsEnabled="{Binding CanRegenerate}"
                                Margin="0,8,0,0" AutomationProperties.Name="Save the prepared check request PDF again" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{DynamicResource PersonGroupAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Grid.Row="2" Background="#22000000" Padding="10" CornerRadius="4">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <local:CheckRequestDocument />
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
