<UserControl x:Class="Sati.Views.ClientDocuments.AnnualDocumentsWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Sati.Views.ClientDocuments"
 xmlns:converters="clr-namespace:Sati.Converters"
 DataContextChanged="OnContextChanged"
 Background="{DynamicResource SurfaceBrush}"
 Foreground="{DynamicResource TextPrimaryBrush}">
 <UserControl.Resources>
  <!-- Timeline positions: fractions of the measured track, with no minimum. -->
  <converters:TimelineFractionConverter x:Key="FractionToPixels" MinimumPixels="0"/>
  <!-- One status, four looks. The text always states the status too, so color is never the only cue. -->
  <Style x:Key="PlanYearStatePill" TargetType="Border">
   <Setter Property="CornerRadius" Value="11"/>
   <Setter Property="Padding" Value="10,3"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Background" Value="{DynamicResource InfoFillBrush}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding StateKey}" Value="Done">
     <Setter Property="Background" Value="{DynamicResource CompliantFillBrush}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding StateKey}" Value="Overdue">
     <Setter Property="Background" Value="{DynamicResource OverdueFillBrush}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding StateKey}" Value="Open">
     <Setter Property="Background" Value="{DynamicResource OpenedFormFillBrush}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="PlanYearStateText" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding StateKey}" Value="Done">
     <Setter Property="Foreground" Value="{DynamicResource CompliantBrush}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding StateKey}" Value="Overdue">
     <Setter Property="Foreground" Value="{DynamicResource OverdueBrush}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding StateKey}" Value="Open">
     <Setter Property="Foreground" Value="{DynamicResource OpenedFormBrush}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="PlanYearCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="10"/>
  </Style>
  <!-- Previous / next: small words, full-size click targets. -->
  <Style x:Key="YearStepButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="MinHeight" Value="44"/>
   <Setter Property="MinWidth" Value="92"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="Transparent" BorderThickness="2" BorderBrush="Transparent" CornerRadius="6" Padding="8,0">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="Cursor" Value="Arrow"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- The view switch: radio buttons drawn as one segmented control, so arrow keys move within it. -->
  <Style x:Key="ViewSegment" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="MinHeight" Value="40"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="GroupName" Value="AnnualFormsView"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="Segment" Background="Transparent" CornerRadius="7" Padding="14,0" BorderThickness="2" BorderBrush="Transparent">
       <ContentPresenter VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Segment" Property="Background" Value="{DynamicResource HoverBrush}"/>
       </Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- One item row, shared by the list view and the purpose cards. -->
  <DataTemplate x:Key="PlanYearRowTemplate">
   <Border Padding="16,11" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
           AutomationProperties.Name="{Binding AccessibleName}">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="24"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto" MinWidth="150"/>
     </Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Marker}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                Style="{StaticResource PlanYearStateText}"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding WhenText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
      <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                 Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}"/>
     </StackPanel>
     <Border Grid.Column="2" Style="{StaticResource PlanYearStatePill}">
      <TextBlock Text="{Binding StateLabel}" Style="{StaticResource PlanYearStateText}"/>
     </Border>
     <Grid Grid.Column="3" HorizontalAlignment="Right" Margin="12,0,0,0">
      <Button Content="{Binding ActionLabel}" Style="{StaticResource PrimaryButton}" MinHeight="40"
              Command="{Binding DataContext.OpenPlanYearItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
              CommandParameter="{Binding Item}"
              AutomationProperties.Name="{Binding QuickActionLabel}"
              Visibility="{Binding IsPrimaryAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
      <Button Content="{Binding ActionLabel}" MinHeight="40"
              Command="{Binding DataContext.OpenPlanYearItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
              CommandParameter="{Binding Item}"
              AutomationProperties.Name="{Binding QuickActionLabel}">
       <Button.Style>
        <!-- Quiet outlined button: "View" on finished work should not compete with the work still to do. -->
        <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
         <Setter Property="Visibility" Value="Visible"/>
         <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
         <Setter Property="Cursor" Value="Hand"/>
         <Setter Property="Template">
          <Setter.Value>
           <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
             <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/>
             </Trigger>
             <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
             </Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Setter.Value>
         </Setter>
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsPrimaryAction}" Value="True">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding HasAction}" Value="False">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Button.Style>
      </Button>
     </Grid>
    </Grid>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="8"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <TextBlock Text="Annual Forms" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,0"
             AutomationProperties.HeadingLevel="Level1"/>

  <TabControl Grid.Row="2"
              SelectedIndex="{Binding AnnualFormsTabIndex, Mode=TwoWay}"
              AutomationProperties.Name="Annual forms sections">
   <TabItem Header="Overview" AutomationProperties.Name="Annual forms overview">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="18" DataContext="{Binding AnnualDocuments}">

      <!-- No effective date: there is no plan year to show. -->
      <Border Style="{StaticResource PlanYearCard}" Padding="24" HorizontalAlignment="Left" MaxWidth="560"
              Visibility="{Binding HasNoPlanYear, Converter={StaticResource BoolToVisibilityConverter}}"
              AutomationProperties.Name="No plan year yet">
       <StackPanel>
        <TextBlock Text="No plan year yet" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Annual forms are organized by plan year, which starts on the effective date. Add the effective date on the client's Overview to see this page."/>
       </StackPanel>
      </Border>

      <StackPanel Visibility="{Binding HasPlanYears, Converter={StaticResource BoolToVisibilityConverter}}">
       <!-- Header bar: view switch, year stepper, packet. -->
       <Border Style="{StaticResource PlanYearCard}" Padding="16,12">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock x:Name="ViewAsLabel" Text="VIEW AS" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,5"/>
          <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="10" Padding="4">
           <StackPanel Orientation="Horizontal"
                       KeyboardNavigation.TabNavigation="Once"
                       KeyboardNavigation.DirectionalNavigation="Cycle"
                       AutomationProperties.Name="View as"
                       AutomationProperties.LabeledBy="{Binding ElementName=ViewAsLabel}">
            <RadioButton Style="{StaticResource ViewSegment}" IsChecked="{Binding IsListView, Mode=TwoWay}"
                         AutomationProperties.Name="List view">
             <StackPanel Orientation="Horizontal">
              <Path Data="M5.5,4 L13.5,4 M5.5,8 L13.5,8 M5.5,12 L13.5,12 M1.6,4 L3.4,4 M1.6,8 L3.4,8 M1.6,12 L3.4,12"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                    StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="List" VerticalAlignment="Center"/>
             </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource ViewSegment}" IsChecked="{Binding IsTimelineView, Mode=TwoWay}" Margin="4,0"
                         AutomationProperties.Name="Timeline view">
             <StackPanel Orientation="Horizontal">
              <Path Data="M1.5,8 L14.5,8 M4,6.2 A1.8,1.8 0 1 1 4,9.8 A1.8,1.8 0 1 1 4,6.2 M9,6.2 A1.8,1.8 0 1 1 9,9.8 A1.8,1.8 0 1 1 9,6.2 M13,5.5 L13,10.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                    StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="Timeline" VerticalAlignment="Center"/>
             </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource ViewSegment}" IsChecked="{Binding IsByPurposeView, Mode=TwoWay}"
                         AutomationProperties.Name="By purpose view">
             <StackPanel Orientation="Horizontal">
              <Path Data="M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                    StrokeThickness="1.6" StrokeLineJoin="Round"
                    Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="By purpose" VerticalAlignment="Center"/>
             </StackPanel>
            </RadioButton>
           </StackPanel>
          </Border>
         </StackPanel>

         <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="16,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
           <Button Style="{StaticResource YearStepButton}" Command="{Binding PreviousYearCommand}"
                   AutomationProperties.Name="Previous plan year">
            <TextBlock Text="‹ previous"/>
           </Button>
           <TextBlock Text="{Binding YearLabel}" FontSize="30" FontWeight="SemiBold" MinWidth="130"
                      TextAlignment="Center" VerticalAlignment="Center" Margin="10,0"
                      AutomationProperties.Name="{Binding YearRange, StringFormat=Plan year {0}}"
                      AutomationProperties.LiveSetting="Polite"/>
           <Button Style="{StaticResource YearStepButton}" Command="{Binding NextYearCommand}"
                   AutomationProperties.Name="{Binding NextYearAccessibleName}">
            <StackPanel Orientation="Horizontal">
             <TextBlock Text="next" VerticalAlignment="Center"/>
             <Ellipse Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource InfoBrush}"
                      ToolTip="Next plan year's work has opened"
                      Visibility="{Binding NextYearHasOpenWork, Converter={StaticResource BoolToVisibilityConverter}}"/>
             <TextBlock Text=" ›" VerticalAlignment="Center"/>
            </StackPanel>
           </Button>
          </StackPanel>
          <TextBlock Text="{Binding YearRange}" HorizontalAlignment="Center" FontSize="13"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <Border HorizontalAlignment="Center" Margin="0,6,0,0" CornerRadius="11" Padding="12,3">
           <Border.Style>
            <Style TargetType="Border">
             <Setter Property="Background" Value="{DynamicResource InfoFillBrush}"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding YearBadgeState}" Value="Done">
               <Setter Property="Background" Value="{DynamicResource CompliantFillBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding YearBadgeState}" Value="Overdue">
               <Setter Property="Background" Value="{DynamicResource OverdueFillBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding YearBadgeState}" Value="Open">
               <Setter Property="Background" Value="{DynamicResource OpenedFormFillBrush}"/>
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </Border.Style>
           <TextBlock Text="{Binding YearBadge}" FontSize="12" FontWeight="SemiBold">
            <TextBlock.Style>
             <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding YearBadgeState}" Value="Done">
                <Setter Property="Foreground" Value="{DynamicResource CompliantBrush}"/>
               </DataTrigger>
               <DataTrigger Binding="{Binding YearBadgeState}" Value="Overdue">
                <Setter Property="Foreground" Value="{DynamicResource OverdueBrush}"/>
               </DataTrigger>
               <DataTrigger Binding="{Binding YearBadgeState}" Value="Open">
                <Setter Property="Foreground" Value="{DynamicResource OpenedFormBrush}"/>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
           </TextBlock>
          </Border>
         </StackPanel>

         <Button Grid.Column="2" Content="Download this year's packet" HorizontalAlignment="Right" VerticalAlignment="Center"
                 MinHeight="40" Command="{Binding SavePacketCommand}" IsEnabled="{Binding CanSavePacket}"
                 ToolTip="Saves this plan year's available drafts and a manifest of outstanding work."/>
        </Grid>
       </Border>

       <!-- An older year with open work is never hidden: billing checks it too. -->
       <Button Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource YearStepButton}"
               Command="{Binding JumpToEarlierOpenYearCommand}"
               Visibility="{Binding HasEarlierYearNotice, Converter={StaticResource BoolToVisibilityConverter}}"
               AutomationProperties.Name="{Binding EarlierYearNotice, StringFormat={}{0}. Open that year.}">
        <Border Background="{DynamicResource OverdueFillBrush}" CornerRadius="11" Padding="12,4">
         <TextBlock Foreground="{DynamicResource OverdueBrush}" FontWeight="SemiBold" FontSize="13">
          <Run Text="{Binding EarlierYearNotice, Mode=OneWay}"/><Run Text=" ›"/>
         </TextBlock>
        </Border>
       </Button>

       <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"
                  AutomationProperties.LiveSetting="Polite">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <Style.Triggers>
           <Trigger Property="Text" Value="">
            <Setter Property="Visibility" Value="Collapsed"/>
           </Trigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>

       <!-- Summary -->
       <Border Style="{StaticResource PlanYearCard}" Padding="18,14" Margin="0,12,0,0">
        <StackPanel>
         <TextBlock Text="{Binding SummaryText}" FontSize="16" FontWeight="SemiBold"
                    AutomationProperties.LiveSetting="Polite"/>
         <Border CornerRadius="4" Margin="0,8,0,0" Height="8" ClipToBounds="True"
                 Background="{DynamicResource SurfaceMutedBrush}">
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SummaryDoneWidth}"/>
            <ColumnDefinition Width="{Binding SummaryNeedsYouWidth}"/>
            <ColumnDefinition Width="{Binding SummaryComingUpWidth}"/>
           </Grid.ColumnDefinitions>
           <Rectangle Fill="{DynamicResource CompliantBrush}"/>
           <Rectangle Grid.Column="1" Fill="{DynamicResource OpenedFormBrush}"/>
           <Rectangle Grid.Column="2" Fill="{DynamicResource InfoFillBrush}"/>
          </Grid>
         </Border>
        </StackPanel>
       </Border>

       <!-- LIST VIEW -->
       <ItemsControl ItemsSource="{Binding ListSections}" Margin="0,14,0,0"
                     Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibilityConverter}}"
                     AutomationProperties.Name="Annual forms list view">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <StackPanel Margin="0,0,0,16">
           <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
            <TextBlock Text="{Binding Hint}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Bottom" Margin="10,0,0,1"/>
           </StackPanel>
           <Border Style="{StaticResource PlanYearCard}" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource PlanYearRowTemplate}" Margin="0,-1,0,0"/>
           </Border>
          </StackPanel>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>

       <!-- TIMELINE VIEW -->
       <StackPanel Margin="0,14,0,0"
                   Visibility="{Binding IsTimelineView, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border Style="{StaticResource PlanYearCard}" Padding="24,18,24,16"
                AutomationProperties.Name="{Binding Timeline.AccessibleSummary}">
         <StackPanel>
          <TextBlock Text="This plan year at a glance" FontSize="17" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
          <Grid Height="200" Margin="0,14,0,0" x:Name="TimelineTrack">
           <!-- Zones -->
           <ItemsControl ItemsSource="{Binding Timeline.Zones}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
             <DataTemplate>
              <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Height="130" Margin="0,12,0,0">
               <Grid.Style>
                <Style TargetType="Grid">
                 <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="Year">
                   <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                 </Style.Triggers>
                </Style>
               </Grid.Style>
               <Border CornerRadius="8">
                <Border.Style>
                 <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                  <Style.Triggers>
                   <DataTrigger Binding="{Binding Kind}" Value="NextPrep">
                    <Setter Property="Background" Value="{DynamicResource InfoFillBrush}"/>
                    <Setter Property="Opacity" Value="0.55"/>
                   </DataTrigger>
                  </Style.Triggers>
                 </Style>
                </Border.Style>
               </Border>
               <TextBlock Text="{Binding Caption}" FontSize="12" FontWeight="SemiBold" Margin="8,6,8,0"
                          TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
               <Grid.Width>
                <MultiBinding Converter="{StaticResource TimelineWidthConverter}">
                 <Binding Path="WidthFraction"/>
                 <Binding Path="ActualWidth" ElementName="TimelineTrack"/>
                </MultiBinding>
               </Grid.Width>
               <Grid.RenderTransform>
                <TranslateTransform>
                 <TranslateTransform.X>
                  <MultiBinding Converter="{StaticResource FractionToPixels}">
                   <Binding Path="StartFraction"/>
                   <Binding Path="ActualWidth" ElementName="TimelineTrack"/>
                  </MultiBinding>
                 </TranslateTransform.X>
                </TranslateTransform>
               </Grid.RenderTransform>
              </Grid>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
           <!-- The line -->
           <Rectangle Height="4" RadiusX="2" RadiusY="2" VerticalAlignment="Top" Margin="0,76,0,0"
                      Fill="{DynamicResource BorderBrush}"/>
           <!-- Today -->
           <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0"
                 Visibility="{Binding Timeline.HasToday, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RenderTransform>
             <TranslateTransform>
              <TranslateTransform.X>
               <MultiBinding Converter="{StaticResource FractionToPixels}">
                <Binding Path="Timeline.TodayStartFraction"/>
                <Binding Path="ActualWidth" ElementName="TimelineTrack"/>
               </MultiBinding>
              </TranslateTransform.X>
             </TranslateTransform>
            </Grid.RenderTransform>
            <Rectangle Width="2" Height="150" HorizontalAlignment="Left" Fill="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{Binding Timeline.TodayLabel}" FontSize="12" FontWeight="SemiBold" Margin="6,136,0,0"
                       Foreground="{DynamicResource AccentBrush}"/>
           </Grid>
           <!-- Markers -->
           <ItemsControl ItemsSource="{Binding Timeline.Markers}" AutomationProperties.Name="Dated items">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
             <DataTemplate>
              <Canvas HorizontalAlignment="Left" VerticalAlignment="Top" Width="0" Height="200"
                      ToolTip="{Binding AccessibleName}" AutomationProperties.Name="{Binding AccessibleName}"
                      Background="Transparent">
               <Canvas.RenderTransform>
                <TranslateTransform>
                 <TranslateTransform.X>
                  <MultiBinding Converter="{StaticResource FractionToPixels}">
                   <Binding Path="StartFraction"/>
                   <Binding Path="ActualWidth" ElementName="TimelineTrack"/>
                  </MultiBinding>
                 </TranslateTransform.X>
                </TranslateTransform>
               </Canvas.RenderTransform>
               <Border Canvas.Left="-10" Canvas.Top="68" Width="20" Height="20" CornerRadius="10" BorderThickness="3">
                <Border.Style>
                 <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                  <Style.Triggers>
                   <DataTrigger Binding="{Binding StateKey}" Value="Done">
                    <Setter Property="Background" Value="{DynamicResource CompliantBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CompliantBrush}"/>
                   </DataTrigger>
                   <DataTrigger Binding="{Binding StateKey}" Value="Overdue">
                    <Setter Property="Background" Value="{DynamicResource OverdueBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource OverdueBrush}"/>
                    <Setter Property="CornerRadius" Value="4"/>
                   </DataTrigger>
                   <DataTrigger Binding="{Binding StateKey}" Value="Open">
                    <Setter Property="Background" Value="{DynamicResource OpenedFormBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource OpenedFormBrush}"/>
                    <Setter Property="CornerRadius" Value="4"/>
                   </DataTrigger>
                  </Style.Triggers>
                 </Style>
                </Border.Style>
               </Border>
               <StackPanel Canvas.Left="-60" Width="120">
                <StackPanel.Style>
                 <Style TargetType="StackPanel">
                  <Setter Property="Canvas.Top" Value="94"/>
                  <Style.Triggers>
                   <DataTrigger Binding="{Binding LabelAbove}" Value="True">
                    <Setter Property="Canvas.Top" Value="28"/>
                   </DataTrigger>
                  </Style.Triggers>
                 </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding DateLabel}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="{Binding Caption}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
               </StackPanel>
              </Canvas>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
           <!-- Month ticks -->
           <ItemsControl ItemsSource="{Binding Timeline.Ticks}" VerticalAlignment="Bottom">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
             <DataTemplate>
              <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Left"
                         Foreground="{DynamicResource TextSecondaryBrush}">
               <TextBlock.RenderTransform>
                <TranslateTransform>
                 <TranslateTransform.X>
                  <MultiBinding Converter="{StaticResource FractionToPixels}">
                   <Binding Path="StartFraction"/>
                   <Binding Path="ActualWidth" ElementName="TimelineTrack"/>
                  </MultiBinding>
                 </TranslateTransform.X>
                </TranslateTransform>
               </TextBlock.RenderTransform>
              </TextBlock>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </Grid>
         </StackPanel>
        </Border>

        <TextBlock Text="Needs you now" FontSize="17" FontWeight="SemiBold" Margin="2,18,0,8" AutomationProperties.HeadingLevel="Level2"
                   Visibility="{Binding HasNeedsYouRows, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <ItemsControl ItemsSource="{Binding NeedsYouRows}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Border Style="{StaticResource PlanYearCard}" Padding="16" Margin="0,0,12,12" AutomationProperties.Name="{Binding AccessibleName}">
            <DockPanel LastChildFill="False">
             <TextBlock DockPanel.Dock="Top" Text="{Binding WhenText}" Style="{StaticResource PlanYearStateText}" TextWrapping="Wrap"/>
             <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
             <TextBlock DockPanel.Dock="Top" Text="{Binding Detail}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>
             <Button DockPanel.Dock="Bottom" Content="{Binding ActionLabel}" Style="{StaticResource PrimaryButton}" MinHeight="40" Margin="0,10,0,0"
                     Command="{Binding DataContext.OpenPlanYearItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     CommandParameter="{Binding Item}" AutomationProperties.Name="{Binding QuickActionLabel}"/>
            </DockPanel>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>

       <!-- BY PURPOSE VIEW -->
       <StackPanel Margin="0,14,0,0"
                   Visibility="{Binding IsByPurposeView, Converter={StaticResource BoolToVisibilityConverter}}">
        <ItemsControl ItemsSource="{Binding NeedsYouRows}" HorizontalAlignment="Center" Margin="0,0,0,12">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Button Style="{StaticResource PrimaryButton}" MinHeight="40" Margin="4" Content="{Binding QuickActionLabel}"
                   Command="{Binding DataContext.OpenPlanYearItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   CommandParameter="{Binding Item}"/>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding PurposeCards}" AutomationProperties.Name="Annual forms by purpose">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Border Style="{StaticResource PlanYearCard}" Margin="0,0,12,12" ClipToBounds="True">
            <StackPanel>
             <DockPanel Margin="16,14,16,2">
              <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
             </DockPanel>
             <TextBlock Text="{Binding Hint}" FontSize="13" Margin="16,0,16,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
             <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource PlanYearRowTemplate}"/>
            </StackPanel>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Not tied to any plan year, so it sits apart from the yearly cards. -->
        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}"
                Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,12,0" ClipToBounds="True"
                Visibility="{Binding HasOneTimeRows, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.Name="One-time items">
         <StackPanel>
          <TextBlock Text="One-time" FontSize="17" FontWeight="SemiBold" Margin="16,12,16,0" AutomationProperties.HeadingLevel="Level2"/>
          <TextBlock Text="Not tied to a plan year." FontSize="13" Margin="16,0,16,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <ItemsControl ItemsSource="{Binding OneTimeRows}" ItemTemplate="{StaticResource PlanYearRowTemplate}"/>
         </StackPanel>
        </Border>
       </StackPanel>

       <!-- Kept for staff who rely on them, out of the way of the everyday view. -->
       <Expander Header="Document records, verification, and signatures" Margin="0,18,0,0"
                 AutomationProperties.Name="Document records, verification, and signatures">
        <StackPanel Margin="0,10,0,0">
         <TextBlock Text="{Binding WindowDescription}" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding AuthorizedRepresentativeRecordedMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8"/>
         <TextBlock Text="The package includes available drafts and a manifest. Retrieve completed releases from their exact saved or signed copies; Sati does not reconstruct them from metadata."
                    TextWrapping="Wrap" Margin="0,4,0,8"/>
         <DataGrid ItemsSource="{Binding Artifacts}" AutoGenerateColumns="False" IsReadOnly="True"
                   MaxHeight="240" AutomationProperties.Name="Current annual form document records">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Record" Binding="{Binding Id}"/>
           <DataGridTextColumn Header="Document" Binding="{Binding Kind}"/>
           <DataGridTextColumn Header="Preparation" Binding="{Binding Origin}"/>
           <DataGridTextColumn Header="Generated" Binding="{Binding GeneratedAtUtc}"/>
          </DataGrid.Columns>
         </DataGrid>
         <WrapPanel Margin="0,12">
          <TextBlock Text="Document record to verify" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Text="{Binding VerificationArtifactId, UpdateSourceTrigger=PropertyChanged}" Width="90"
                   AutomationProperties.Name="Annual form document record to verify"/>
          <Button Content="Choose file and verify" Command="{Binding VerifyCommand}" Margin="8,0"/>
         </WrapPanel>
         <TextBlock Text="Verification compares the selected file's fingerprint with the recorded generated document. The file contents are not uploaded."
                    TextWrapping="Wrap"/>
         <local:SignatureRequestsWorkspace DataContext="{Binding Signatures}" Margin="0,24"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </TabItem>

   <TabItem Header="Releases" AutomationProperties.Name="Annual form releases">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="16">
      <TextBlock Text="Releases" FontSize="18" FontWeight="SemiBold"
                 AutomationProperties.HeadingLevel="Level2"/>
      <TextBlock Text="First confirm the exact recipient and service year below. Then prepare the matching medical or agency release. For Maine DHHS's state release, use DHHS Documents."
                 TextWrapping="Wrap" Margin="0,6,0,12"/>
      <local:ReleaseObligationsWorkspace DataContext="{Binding ReleaseObligations}"/>
      <Separator Margin="0,12"/>
      <local:AgencyReleaseWorkspace DataContext="{Binding AgencyRelease}"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>

   <TabItem Header="DHHS Documents" AutomationProperties.Name="Annual DHHS documents">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <local:DhhsFormsWorkspace DataContext="{Binding DhhsForms}"/>
     <Border Grid.Row="1" Margin="16,0,16,16" Padding="12" CornerRadius="7"
             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
             Background="{DynamicResource PersonGroupAltBrush}"
             DataContext="{Binding AnnualDocuments}"
             AutomationProperties.Name="Record DHHS Authorized Representative form already on file">
      <StackPanel>
       <StackPanel.Style>
        <Style TargetType="StackPanel">
         <Setter Property="Visibility" Value="Visible"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding NeedsAuthorizedRepresentative}" Value="False">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </StackPanel.Style>
       <TextBlock Text="Already have the signed Authorized Representative form? Describe where the agency-approved copy is retained or how you verified it. This records the fact and audit trail, not the PDF bytes."
                  TextWrapping="Wrap"/>
       <TextBox Text="{Binding AuthorizedRepresentativeOnFileNote, UpdateSourceTrigger=PropertyChanged}"
                MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" Margin="0,6"
                AutomationProperties.Name="DHHS Authorized Representative on-file verification note"/>
       <Button Content="Record signed form already on file"
               Command="{Binding RecordAuthorizedRepresentativeOnFileCommand}"
               IsEnabled="{Binding CanRecordAuthorizedRepresentativeOnFile}"
               HorizontalAlignment="Left"/>
      </StackPanel>
     </Border>
    </Grid>
   </TabItem>

   <TabItem Header="Safety Plan" AutomationProperties.Name="Annual safety plan">
    <local:SafetyPlanWorkspace DataContext="{Binding SafetyPlan}"/>
   </TabItem>

   <TabItem Header="Privacy Practices" AutomationProperties.Name="Annual privacy practices">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="18" DataContext="{Binding AnnualDocuments}">
      <TextBlock Text="Privacy Practices" FontSize="18" FontWeight="SemiBold"
                 AutomationProperties.HeadingLevel="Level2"/>
      <TextBlock Text="Generate only the agency-approved notice. Generating a PDF does not record delivery, receipt, acknowledgment, or signature."
                 TextWrapping="Wrap" Margin="0,6,0,12"/>
      <Button Content="Generate privacy notice PDF" Command="{Binding GenerateNoticeCommand}"
              HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding ReceiptStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10"/>
      <TextBlock Text="Receipt date (leave blank when recording a good-faith effort instead)"/>
      <DatePicker SelectedDate="{Binding ReceivedOn}"
                  AutomationProperties.Name="Privacy notice received on"/>
      <TextBlock Text="Good-faith effort explanation" Margin="0,8,0,0"/>
      <TextBox Text="{Binding GoodFaithEffortReason, UpdateSourceTrigger=PropertyChanged}"
               MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
               AutomationProperties.Name="Privacy notice good-faith effort"/>
      <Button Content="Record receipt or effort" Command="{Binding AcknowledgeCommand}"
              IsEnabled="{Binding CanRecordReceipt}" HorizontalAlignment="Left" Margin="0,8"/>

      <Expander Header="Agency privacy template (administrators)" IsEnabled="{Binding CanManageTemplates}" Margin="0,18">
       <StackPanel>
        <TextBlock Text="Publish a new version only after agency review. Existing versions remain unchanged. This editor is source text, not a visual preview of the generated PDF. Supported tokens are listed in DOCUMENT_TEMPLATES.md."
                   TextWrapping="Wrap"/>
        <Button Content="Load current template" Command="{Binding LoadTemplateCommand}"
                HorizontalAlignment="Left" Margin="0,8,0,0"/>
        <TextBlock Text="Template source" FontWeight="SemiBold" Margin="0,10,0,4"/>
        <TextBox Text="{Binding TemplateBody, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="360" MaxHeight="620"
                 MaxLength="100000" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Agency privacy template source"/>
        <TextBlock Text="{Binding TemplateValidationMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                   AutomationProperties.LiveSetting="Polite"/>
        <Button Content="Publish new template version" Command="{Binding PublishTemplateCommand}"
                IsEnabled="{Binding CanPublishTemplate}" HorizontalAlignment="Left"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
