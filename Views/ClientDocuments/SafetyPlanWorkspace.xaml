<UserControl x:Class="Sati.Views.ClientDocuments.SafetyPlanWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Sati.Views.ClientDocuments"
 DataContextChanged="OnContextChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Grid Margin="18">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="3*" MinWidth="470"/>
   <ColumnDefinition Width="14"/>
   <ColumnDefinition Width="2*" MinWidth="330"/>
  </Grid.ColumnDefinitions>
  <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="Safety plan" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"/>
    <TextBlock Text="Save a draft, submit it for review, then have your supervisor approve it. Returned and approved versions remain unchanged; start a new revision to edit." TextWrapping="Wrap" Margin="0,8"/>
    <WrapPanel>
     <TextBlock Text="Cycle beginning" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <DatePicker SelectedDate="{Binding CycleStart}" AutomationProperties.Name="Safety plan cycle beginning"/>
     <Button Content="Load cycle" Command="{Binding ReloadCommand}" Margin="8,0"/>
     <Button Content="Start / revise plan" Command="{Binding StartCommand}" IsEnabled="{Binding CanAuthor}"/>
    </WrapPanel>
    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,12"/>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <ItemsControl ItemsSource="{Binding Sections}" IsEnabled="{Binding CanEdit}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <StackPanel Margin="0,8">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
         MinHeight="80" MaxLength="8000" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Title}"/>
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <WrapPanel Margin="0,12">
     <Button Content="Save draft" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"/>
     <Button Content="Submit for review" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"/>
     <Button Content="Save PDF of saved version" Command="{Binding GenerateCommand}"/>
    </WrapPanel>
    <TextBlock Text="Supervisor return reason" FontWeight="SemiBold"/>
    <TextBox Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanReview}"
     MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" AutomationProperties.Name="Safety plan return reason"/>
    <WrapPanel Margin="0,8">
     <Button Content="Approve submitted plan" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanReview}" Margin="0,0,8,0"/>
     <Button Content="Return for revision" Command="{Binding ReturnCommand}" IsEnabled="{Binding CanReview}"/>
    </WrapPanel>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Column="2" Background="{DynamicResource PersonGroupAltBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
    <local:SafetyPlanDocument Grid.Row="2"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>
