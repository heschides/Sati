<UserControl x:Class="Sati.Views.ClientDocuments.BenefitsApplicationWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:documents="clr-namespace:Sati.Views.ClientDocuments"
             Background="{DynamicResource WindowBackgroundBrush}"
             DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="AnswerTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="280" />
            <Setter Property="MaxWidth" Value="680" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
            <StackPanel>
                <TextBlock Text="MAINE OFI APPLICATION FOR BENEFITS" FontWeight="Bold" FontSize="11"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding PersonName}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,4"
                           Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{Binding SourceRevision}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="The steps follow the state's application pages. Applicant identity is taken from the selected consumer record; review every answer and all instructions in the generated PDF."
                           TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="12" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource WarningBrush}" Background="{DynamicResource WarningSoftBrush}">
            <TextBlock Text="Draft only. The applicant or authorized representative must review and sign page 3. Appendix B needs both signatures if used. Sati does not submit this application or determine eligibility. Leave any answer you cannot verify blank for the applicant to complete."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                       AutomationProperties.Name="Application draft and signature guidance" />
        </Border>

        <ScrollViewer x:Name="AnswerScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Benefits application questions">
            <StackPanel>
                <documents:FormWizardProgressWorkspace DataContext="{Binding Progress}" />
                <TextBlock Text="{Binding StepProgress}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding StepTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,12"
                           Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.HeadingLevel="Level3" />
                <ItemsControl ItemsSource="{Binding CurrentFields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,0,0,7" CornerRadius="5"
                                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,0,5"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="{Binding MaxLength}"
                                             Style="{StaticResource AnswerTextBox}"
                                             AutomationProperties.Name="{Binding Label}"
                                             Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <PasswordBox MaxLength="{Binding MaxLength}" Padding="8,6" Width="280"
                                                 HorizontalAlignment="Left" Loaded="SensitiveLoaded"
                                                 PasswordChanged="SensitiveChanged"
                                                 AutomationProperties.Name="{Binding Label}"
                                                 Visibility="{Binding IsSensitive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ComboBox ItemsSource="{Binding DataContext.YesNoOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Width="150" HorizontalAlignment="Left"
                                              AutomationProperties.Name="{Binding Label}"
                                              Visibility="{Binding IsYesNo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Content="Select" AutomationProperties.Name="{Binding Label}"
                                              Visibility="{Binding IsCheck, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="6" Padding="12" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanBack}"
                            Padding="16,7" AutomationProperties.Name="Previous application step" />
                    <Button Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"
                            Margin="8,0,0,0" Padding="16,7"
                            AutomationProperties.Name="Next application step" />
                    <Button Content="Generate draft PDF" Command="{Binding GenerateCommand}"
                            Margin="16,0,0,0" Padding="16,7"
                            AutomationProperties.Name="Generate benefits application draft PDF" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Margin="20,0,0,0" VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
