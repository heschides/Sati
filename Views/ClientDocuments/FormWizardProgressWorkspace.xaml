<UserControl x:Class="Sati.Views.ClientDocuments.FormWizardProgressWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">
    <Border Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="5" Margin="0,0,0,8">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Save progress" Command="{Binding SaveCommand}" Padding="12,5"
                        AutomationProperties.Name="Save this form's answers and current step" />
                <Button Content="Resume saved" Command="{Binding ResumeCommand}" Padding="12,5"
                        Margin="8,0,0,0" AutomationProperties.Name="Resume saved form answers" />
                <Button Content="Reload saved" Command="{Binding ReloadCommand}" Padding="12,5"
                        Margin="8,0,0,0" AutomationProperties.Name="Reload form progress from the database" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Margin="16,0,0,0" VerticalAlignment="Center"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Border>
</UserControl>
