<UserControl x:Class="Sati.Views.ClientDocuments.DhhsFormEntryPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Live DHHS form entry preview">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Background="White" Padding="22" TextElement.Foreground="#17324D">
            <StackPanel>
                <TextBlock Text="MAINE DEPARTMENT OF HEALTH AND HUMAN SERVICES"
                           FontSize="9" FontWeight="Bold" Foreground="#2F7D7A" TextWrapping="Wrap" />
                <Separator Background="#2F7D7A" Margin="0,5,0,14" />
                <TextBlock Text="{Binding SelectedFormChoice.DisplayName}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PersonName}" Margin="0,4,0,12" FontWeight="SemiBold" />
                <Border Background="#FFF7E6" BorderBrush="#9A5C00" BorderThickness="3,0,0,0"
                        Padding="8" Margin="0,0,0,12">
                    <TextBlock Text="Live entry review. The generated file uses the official DHHS PDF layout; signatures and signing dates remain blank."
                               FontSize="10" TextWrapping="Wrap" />
                </Border>
                <ItemsControl ItemsSource="{Binding ActiveConsentGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,13">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#2F7D7A" />
                                <ItemsControl ItemsSource="{Binding Checks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                                      IsHitTestVisible="False" Focusable="False"
                                                      Foreground="#17324D" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Text}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#586571" TextWrapping="Wrap" />
                                                <Border Grid.Column="1" BorderBrush="#CDD6DC" BorderThickness="0,0,0,1" Margin="7,0,0,0">
                                                    <TextBlock Text="{Binding Value}" MinHeight="16" TextWrapping="Wrap" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Consumer / representative signature: __________________________"
                           Margin="0,16,0,8" TextWrapping="Wrap" />
                <TextBlock Text="Date: __________________" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
