<UserControl x:Class="Sati.Views.ClientDocuments.CwicPacketWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource WindowBackgroundBrush}" DataContextChanged="OnDataContextChanged">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  <Style x:Key="CwicField" TargetType="TextBox">
   <Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,3,8,8"/>
   <Setter Property="MinWidth" Value="145"/><Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
  </Style>
  <Style x:Key="CwicLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
   <Setter Property="Margin" Value="0,2,8,0"/>
  </Style>
  <Style x:Key="PaperValue" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#111111"/><Setter Property="FontFamily" Value="Arial"/>
   <Setter Property="FontSize" Value="10"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="16" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="CWIC / BENEFITS COUNSELING REFERRAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
     <TextBlock Text="{Binding PersonName}" Margin="0,4,0,5" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"/>
     <TextBlock Text="{Binding SourceRevision}" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
    <Border Grid.Column="2" Padding="12" CornerRadius="6" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
     <TextBlock Text="This creates a draft of MaineHealth's complete ten-page packet. Review every page. Sati never fills signatures, signature dates, guardian permission, or sensitive-release choices unless a user explicitly enters the answer." TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
    </Border>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="530"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*" MinWidth="380"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="CWIC packet answers">
    <StackPanel>
     <Expander Header="1. Consumer and contact information" IsExpanded="True" Margin="0,0,0,8">
      <Border Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
       <StackPanel>
        <WrapPanel>
         <StackPanel><TextBlock Text="Mailing address" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding MailingAddress, UpdateSourceTrigger=PropertyChanged}" Tag="CWIC mailing address" Width="300" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="City" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Tag="CWIC city" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="State" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" Tag="CWIC state" Width="65" MinWidth="65" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="ZIP" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding Zip, UpdateSourceTrigger=PropertyChanged}" Tag="CWIC ZIP" Width="95" MinWidth="95" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="County" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding County, UpdateSourceTrigger=PropertyChanged}" Tag="CWIC county" Style="{StaticResource CwicField}"/></StackPanel>
        </WrapPanel>
        <WrapPanel>
         <StackPanel><TextBlock Text="Home phone" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding HomePhone, UpdateSourceTrigger=PropertyChanged}" Tag="CWIC home phone" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="Cell phone" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding CellPhone, UpdateSourceTrigger=PropertyChanged}" Tag="CWIC cell phone" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="Email" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Tag="CWIC email" Width="250" Style="{StaticResource CwicField}"/></StackPanel>
        </WrapPanel>
        <WrapPanel>
         <StackPanel><TextBlock Text="Marital status" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding MaritalStatuses}" SelectedItem="{Binding MaritalStatus}" MinWidth="145" Margin="0,3,8,8" AutomationProperties.Name="CWIC marital status"/></StackPanel>
         <StackPanel><TextBlock Text="Gender as entered on packet" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding Gender, UpdateSourceTrigger=PropertyChanged}" Tag="CWIC gender" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="Spouse receives disability benefits" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding YesNoChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding SpouseReceivesDisabilityBenefits}" MinWidth="145" Margin="0,3,8,8" AutomationProperties.Name="Spouse disability benefits"/></StackPanel>
        </WrapPanel>
       </StackPanel>
      </Border>
     </Expander>

     <Expander Header="2–5. Referral, scheduling, payee, and guardian" IsExpanded="True" Margin="0,0,0,8">
      <Border Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
       <StackPanel>
        <TextBlock Text="Referring organization" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding ReferringOrganization, UpdateSourceTrigger=PropertyChanged}" Tag="Referring organization" Width="360" HorizontalAlignment="Left" Style="{StaticResource CwicField}"/>
        <CheckBox Content="Contact the consumer to schedule" IsChecked="{Binding ScheduleWithConsumer}" Margin="0,3,0,8" AutomationProperties.Name="Contact consumer to schedule"/>
        <WrapPanel Visibility="{Binding ShowSchedulingContact, Converter={StaticResource BooleanToVisibilityConverter}}">
         <StackPanel><TextBlock Text="Scheduling contact" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding SchedulingContactName, UpdateSourceTrigger=PropertyChanged}" Tag="Scheduling contact name" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="Relationship" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding SchedulingContactRelationship, UpdateSourceTrigger=PropertyChanged}" Tag="Scheduling contact relationship" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="Phone" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding SchedulingContactPhone, UpdateSourceTrigger=PropertyChanged}" Tag="Scheduling contact phone" Style="{StaticResource CwicField}"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="Preferred meeting methods" Style="{StaticResource CwicLabel}"/>
        <ItemsControl ItemsSource="{Binding MeetingMethods}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2,18,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <WrapPanel>
         <StackPanel><TextBlock Text="Representative payee" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding YesNoChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding HasRepresentativePayee}" MinWidth="145" Margin="0,3,8,8" AutomationProperties.Name="Has representative payee"/></StackPanel>
         <StackPanel Visibility="{Binding ShowRepresentativePayee, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Payee name" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding RepresentativePayeeName, UpdateSourceTrigger=PropertyChanged}" Tag="Representative payee name" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel Visibility="{Binding ShowRepresentativePayee, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Payee phone" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding RepresentativePayeePhone, UpdateSourceTrigger=PropertyChanged}" Tag="Representative payee phone" Style="{StaticResource CwicField}"/></StackPanel>
        </WrapPanel>
        <WrapPanel>
         <StackPanel><TextBlock Text="Legal guardian" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding YesNoChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding HasLegalGuardian}" MinWidth="145" Margin="0,3,8,8" AutomationProperties.Name="Has legal guardian"/></StackPanel>
         <StackPanel Visibility="{Binding ShowGuardian, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Guardian name" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding GuardianName, UpdateSourceTrigger=PropertyChanged}" Tag="Guardian name" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel Visibility="{Binding ShowGuardian, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Guardian phone" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding GuardianPhone, UpdateSourceTrigger=PropertyChanged}" Tag="Guardian phone" Style="{StaticResource CwicField}"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="Name/agency guardian authorizes to communicate in their absence (leave blank unless guardian directs)" Style="{StaticResource CwicLabel}" Visibility="{Binding ShowGuardian, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <TextBox Text="{Binding GuardianCommunicationPermission, UpdateSourceTrigger=PropertyChanged}" Tag="Guardian communication permission" Width="430" HorizontalAlignment="Left" Style="{StaticResource CwicField}" Visibility="{Binding ShowGuardian, Converter={StaticResource BooleanToVisibilityConverter}}"/>
       </StackPanel>
      </Border>
     </Expander>

     <Expander Header="6–10. Work situation and benefits" IsExpanded="True" Margin="0,0,0,8">
      <Border Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
       <StackPanel>
        <TextBlock Text="Current job situation (check all that apply)" Style="{StaticResource CwicLabel}"/>
        <ItemsControl ItemsSource="{Binding EmploymentSituations}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2,18,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <WrapPanel>
         <StackPanel><TextBlock Text="Self-employment monthly profit" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding SelfEmploymentMonthlyProfit, UpdateSourceTrigger=PropertyChanged}" Tag="Self employment monthly profit" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="Self-employment hours/month" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding SelfEmploymentHoursPerMonth, UpdateSourceTrigger=PropertyChanged}" Tag="Self employment hours" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="Working hours/week" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding WorkingHoursPerWeek, UpdateSourceTrigger=PropertyChanged}" Tag="Working hours per week" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="Hourly wage" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding WorkingHourlyWage, UpdateSourceTrigger=PropertyChanged}" Tag="Working hourly wage" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="Work began" Style="{StaticResource CwicLabel}"/><DatePicker SelectedDate="{Binding WorkBeganOn}" Margin="0,3,8,8" AutomationProperties.Name="Work began date"/></StackPanel>
         <StackPanel><TextBlock Text="Offered hours/week" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding OfferedHoursPerWeek, UpdateSourceTrigger=PropertyChanged}" Tag="Offered hours per week" Style="{StaticResource CwicField}"/></StackPanel>
         <StackPanel><TextBlock Text="Offered hourly wage" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding OfferedHourlyWage, UpdateSourceTrigger=PropertyChanged}" Tag="Offered hourly wage" Style="{StaticResource CwicField}"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="How the consumer feels about the job situation" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding JobSatisfactionChoices}" SelectedItem="{Binding JobSatisfaction}" MinWidth="220" HorizontalAlignment="Left" Margin="0,3,8,8" AutomationProperties.Name="Job satisfaction"/>
        <TextBlock Text="Benefits received (check all that apply)" Style="{StaticResource CwicLabel}"/>
        <ItemsControl ItemsSource="{Binding Benefits}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2,18,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="Other benefit" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding OtherBenefit, UpdateSourceTrigger=PropertyChanged}" Tag="Other benefit" Width="360" HorizontalAlignment="Left" Style="{StaticResource CwicField}"/>
        <TextBlock Text="Children under 21 living with consumer receive MaineCare" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding YesNoChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ChildrenUnder21ReceiveMaineCare}" MinWidth="145" HorizontalAlignment="Left" Margin="0,3,8,8" AutomationProperties.Name="Children receive MaineCare"/>
        <TextBlock Text="Specific benefits question" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding BenefitsQuestion, UpdateSourceTrigger=PropertyChanged}" Tag="Specific benefits question" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxLength="1500" Style="{StaticResource CwicField}"/>
       </StackPanel>
      </Border>
     </Expander>

     <Expander Header="11–12. Meeting location and accommodations" Margin="0,0,0,8">
      <Border Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
       <StackPanel>
        <TextBlock Text="Most convenient in-person location" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding InPersonLocation}" MinWidth="220" HorizontalAlignment="Left" Margin="0,3,8,8" AutomationProperties.Name="Most convenient in-person location"/>
        <TextBlock Text="Accommodations" Style="{StaticResource CwicLabel}"/>
        <ItemsControl ItemsSource="{Binding Accommodations}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2,18,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <WrapPanel><StackPanel><TextBlock Text="Foreign language" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding ForeignLanguage, UpdateSourceTrigger=PropertyChanged}" Tag="Foreign language" Style="{StaticResource CwicField}"/></StackPanel><StackPanel><TextBlock Text="Other accommodation" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding OtherAccommodation, UpdateSourceTrigger=PropertyChanged}" Tag="Other accommodation" Width="280" Style="{StaticResource CwicField}"/></StackPanel></WrapPanel>
       </StackPanel>
      </Border>
     </Expander>

     <Expander Header="13. Vocational Rehabilitation counselor section" IsExpanded="True" Margin="0,0,0,8">
      <Border Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
       <StackPanel>
        <TextBlock Text="State of Maine VR counselor" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding YesNoChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding HasVrCounselor}" MinWidth="145" HorizontalAlignment="Left" Margin="0,3,8,8" AutomationProperties.Name="Has State of Maine VR counselor"/>
        <StackPanel Visibility="{Binding ShowVrDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
         <WrapPanel><StackPanel><TextBlock Text="Counselor name" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding VrCounselorName, UpdateSourceTrigger=PropertyChanged}" Tag="VR counselor name" Style="{StaticResource CwicField}"/></StackPanel><StackPanel><TextBlock Text="Phone" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding VrCounselorPhone, UpdateSourceTrigger=PropertyChanged}" Tag="VR counselor phone" Style="{StaticResource CwicField}"/></StackPanel><StackPanel><TextBlock Text="Status" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding VrStatuses}" SelectedItem="{Binding VrStatus}" MinWidth="145" Margin="0,3,8,8" AutomationProperties.Name="VR status"/></StackPanel><StackPanel><TextBlock Text="Status date" Style="{StaticResource CwicLabel}"/><DatePicker SelectedDate="{Binding VrStatusDate}" Margin="0,3,8,8" AutomationProperties.Name="VR status date"/></StackPanel></WrapPanel>
         <WrapPanel><StackPanel><TextBlock Text="Estimated return to work" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding ReturnToWorkChoices}" SelectedItem="{Binding EstimatedReturnToWork}" MinWidth="190" Margin="0,3,8,8" AutomationProperties.Name="Estimated return to work"/></StackPanel><StackPanel><TextBlock Text="Has an IPE" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding YesNoChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding HasIpe}" MinWidth="145" Margin="0,3,8,8" AutomationProperties.Name="Has an IPE"/></StackPanel></WrapPanel>
         <StackPanel Visibility="{Binding ShowIpeDetails, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="IPE goal" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding IpeGoal, UpdateSourceTrigger=PropertyChanged}" Tag="IPE goal" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Style="{StaticResource CwicField}"/><WrapPanel><StackPanel><TextBlock Text="Estimated hours/week" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding EstimatedHoursPerWeek, UpdateSourceTrigger=PropertyChanged}" Tag="Estimated hours per week" Style="{StaticResource CwicField}"/></StackPanel><StackPanel><TextBlock Text="IPE date" Style="{StaticResource CwicLabel}"/><DatePicker SelectedDate="{Binding IpeDate}" Margin="0,3,8,8" AutomationProperties.Name="IPE date"/></StackPanel><StackPanel><TextBlock Text="Expected end" Style="{StaticResource CwicLabel}"/><DatePicker SelectedDate="{Binding IpeExpectedEndDate}" Margin="0,3,8,8" AutomationProperties.Name="IPE expected end date"/></StackPanel></WrapPanel></StackPanel>
        </StackPanel>
       </StackPanel>
      </Border>
     </Expander>

     <Expander Header="Maine DOL release details and sensitive choices" Margin="0,0,0,8">
      <Border Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
       <StackPanel>
        <TextBlock Text="These choices appear on page 10. Record them only from the consumer's explicit direction; leaving Not answered keeps both boxes blank." TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
        <WrapPanel><StackPanel><TextBlock Text="VR division" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding VrDivisions}" SelectedItem="{Binding VrDivision}" MinWidth="220" Margin="0,3,8,8" AutomationProperties.Name="VR division"/></StackPanel><StackPanel><TextBlock Text="Release begins" Style="{StaticResource CwicLabel}"/><DatePicker SelectedDate="{Binding DolReleaseStart}" Margin="0,3,8,8" AutomationProperties.Name="DOL release begins"/></StackPanel><StackPanel><TextBlock Text="Release ends" Style="{StaticResource CwicLabel}"/><DatePicker SelectedDate="{Binding DolReleaseEnd}" Margin="0,3,8,8" AutomationProperties.Name="DOL release ends"/></StackPanel></WrapPanel>
        <TextBlock Text="VR counselor/office address" Style="{StaticResource CwicLabel}"/><TextBox Text="{Binding VrOfficeAddress, UpdateSourceTrigger=PropertyChanged}" Tag="VR office address" Width="430" HorizontalAlignment="Left" Style="{StaticResource CwicField}"/>
        <WrapPanel>
         <StackPanel><TextBlock Text="Substance-use disclosure" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding YesNoChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding AuthorizeSubstanceUseDisclosure}" MinWidth="145" Margin="0,3,8,8" AutomationProperties.Name="Substance-use disclosure authorization"/></StackPanel>
         <StackPanel><TextBlock Text="Mental-health disclosure" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding YesNoChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding AuthorizeMentalHealthDisclosure}" MinWidth="145" Margin="0,3,8,8" AutomationProperties.Name="Mental-health disclosure authorization"/></StackPanel>
         <StackPanel><TextBlock Text="Review before release" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding YesNoChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ReviewBeforeRelease}" MinWidth="145" Margin="0,3,8,8" AutomationProperties.Name="Review before release"/></StackPanel>
         <StackPanel><TextBlock Text="HIV disclosure" Style="{StaticResource CwicLabel}"/><ComboBox ItemsSource="{Binding YesNoChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding AuthorizeHivDisclosure}" MinWidth="145" Margin="0,3,8,8" AutomationProperties.Name="HIV disclosure authorization"/></StackPanel>
        </WrapPanel>
       </StackPanel>
      </Border>
     </Expander>
    </StackPanel>
   </ScrollViewer>

   <Border Grid.Column="2" Background="{DynamicResource PersonGroupAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="LIVE PACKET PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Live CWIC packet preview">
      <StackPanel>
       <Border Background="White" BorderBrush="#B7B7B7" BorderThickness="1" Padding="22" Margin="0,0,0,10" MinHeight="510">
        <StackPanel>
         <TextBlock Text="MaineHealth · Department of Vocational Services" Foreground="#5A4E45" FontWeight="Bold" FontSize="12"/>
         <TextBlock Text="Request for Benefits Counseling Services" Foreground="#111" FontWeight="Bold" FontSize="14" TextAlignment="Center" Margin="0,8"/>
         <TextBlock Text="Page 1 of 10 · Consumer information and referral" Foreground="#555" FontSize="9" TextAlignment="Center" Margin="0,0,0,12"/>
         <TextBlock Style="{StaticResource PaperValue}"><Run FontWeight="Bold" Text="Name: "/><Run Text="{Binding PersonName, Mode=OneWay}"/><Run Text="     Age: "/><Run Text="{Binding AgeDisplay, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}" Margin="0,5,0,0"><Run FontWeight="Bold" Text="Address: "/><Run Text="{Binding MailingAddress, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}"><Run Text="{Binding City, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding State, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Zip, Mode=OneWay}"/><Run Text="   County: "/><Run Text="{Binding County, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}" Margin="0,5,0,0"><Run Text="Home: "/><Run Text="{Binding HomePhone, Mode=OneWay}"/><Run Text="   Cell: "/><Run Text="{Binding CellPhone, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}"><Run Text="Email: "/><Run Text="{Binding Email, Mode=OneWay}"/></TextBlock>
         <Separator Margin="0,10"/>
         <TextBlock Style="{StaticResource PaperValue}"><Run FontWeight="Bold" Text="1. Referred by: "/><Run Text="{Binding ReferringOrganization, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}" Margin="0,6,0,0"><Run FontWeight="Bold" Text="2. Scheduling: "/><Run Text="{Binding SchedulingContactName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding SchedulingContactRelationship, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding SchedulingContactPhone, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}" Margin="0,6,0,0"><Run FontWeight="Bold" Text="4. Representative payee: "/><Run Text="{Binding RepresentativePayeeName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding RepresentativePayeePhone, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}" Margin="0,6,0,0"><Run FontWeight="Bold" Text="5. Guardian: "/><Run Text="{Binding GuardianName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding GuardianPhone, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}" Margin="0,6,0,0"><Run FontWeight="Bold" Text="6. Work: "/><Run Text="{Binding WorkingHoursPerWeek, Mode=OneWay}"/><Run Text=" hours/week at $"/><Run Text="{Binding WorkingHourlyWage, Mode=OneWay}"/></TextBlock>
         <TextBlock Text="Guardian and consumer signature lines remain blank." Foreground="#8A5200" FontSize="9" FontWeight="Bold" Margin="0,14,0,0"/>
        </StackPanel>
       </Border>
       <Border Background="White" BorderBrush="#B7B7B7" BorderThickness="1" Padding="22" Margin="0,0,0,10" MinHeight="380">
        <StackPanel>
         <TextBlock Text="Page 2 of 10 · Benefits, meeting, and VR" Foreground="#111" FontWeight="Bold" FontSize="13" TextAlignment="Center"/>
         <TextBlock Style="{StaticResource PaperValue}" Margin="0,14,0,0"><Run FontWeight="Bold" Text="Job satisfaction: "/><Run Text="{Binding JobSatisfaction, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}" Margin="0,7,0,0"><Run FontWeight="Bold" Text="Specific question: "/><Run Text="{Binding BenefitsQuestion, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}" Margin="0,7,0,0"><Run FontWeight="Bold" Text="In-person location: "/><Run Text="{Binding InPersonLocation, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}" Margin="0,7,0,0"><Run FontWeight="Bold" Text="VR counselor: "/><Run Text="{Binding VrCounselorName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding VrCounselorPhone, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}"><Run Text="Status: "/><Run Text="{Binding VrStatus, Mode=OneWay}"/><Run Text="   Return to work: "/><Run Text="{Binding EstimatedReturnToWork, Mode=OneWay}"/></TextBlock>
         <TextBlock Style="{StaticResource PaperValue}"><Run Text="IPE goal: "/><Run Text="{Binding IpeGoal, Mode=OneWay}"/></TextBlock>
        </StackPanel>
       </Border>
       <Border Background="White" BorderBrush="#B7B7B7" BorderThickness="1" Padding="18" Margin="0,0,0,10">
        <StackPanel>
         <TextBlock Text="Pages 3–10 · Included official releases and notices" Foreground="#111" FontWeight="Bold" FontSize="13"/>
         <TextBlock Text="3  DVS Human Rights and Privacy Practices" Style="{StaticResource PaperValue}" Margin="0,10,0,0"/>
         <TextBlock Text="4–7  Two Social Security consent forms and instructions" Style="{StaticResource PaperValue}"/>
         <TextBlock Style="{StaticResource PaperValue}"><Run Text="Name/DOB/SSN: "/><Run Text="{Binding PersonName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding BirthDateDisplay, Mode=OneWay}"/><Run Text=" · securely filled on generated PDF if on file"/></TextBlock>
         <TextBlock Text="8–9  Maine DHHS Authorization to Release Information" Style="{StaticResource PaperValue}" Margin="0,6,0,0"/>
         <TextBlock Text="10  Maine DOL/BRS Authorization to Release Confidential Information" Style="{StaticResource PaperValue}" Margin="0,6,0,0"/>
         <TextBlock Style="{StaticResource PaperValue}"><Run Text="VR division: "/><Run Text="{Binding VrDivision, Mode=OneWay}"/><Run Text="   Dates: "/><Run Text="{Binding DolReleaseStart, Mode=OneWay, StringFormat={}{0:MM/dd/yyyy}}"/><Run Text=" – "/><Run Text="{Binding DolReleaseEnd, Mode=OneWay, StringFormat={}{0:MM/dd/yyyy}}"/></TextBlock>
         <TextBlock Text="All required signature and date lines remain blank." Foreground="#8A5200" FontSize="9" FontWeight="Bold" Margin="0,10,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>

  <Border Grid.Row="4" Padding="12" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding BlankFieldsMessage}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,3,10,0"/><ProgressBar IsIndeterminate="True" Height="3" Margin="0,7,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Reset to profile" Command="{Binding ClearCommand}" Padding="13,7" Margin="0,0,8,0"/><Button Content="Generate draft packet PDF" Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}" Padding="16,7" FontWeight="SemiBold"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
