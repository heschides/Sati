<UserControl x:Class="Sati.Views.ClientDocuments.SafetyDeviceWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:documents="clr-namespace:Sati.Views.ClientDocuments"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SafetyField" TargetType="TextBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,3,10,8" />
            <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" />
        </Style>
        <Style x:Key="SafetyLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
            <Setter Property="Margin" Value="0,2,8,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="16" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="SAFETY DEVICE REQUEST" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding PersonName}" Margin="0,4,0,5" FontSize="20"
                           FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{Binding SourceRevision}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                           Text="This is an entry workspace. Generate the editable PDF to review the six-page OADS form. The PDF retains Appendix A's safety device levels and Appendix B's additional device rows." />
                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                           Text="Medical provider dates and signatures and member or guardian approval remain blank. The planning team notes and any required HCBS modification must be handled outside this draft." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Safety device request answers">
            <StackPanel>
                <documents:FormWizardProgressWorkspace DataContext="{Binding Progress}" />
                <Expander Header="1. Member and program" IsExpanded="True" Margin="0,0,0,8">
                    <Border Padding="12" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Member identity, address, guardian, and assigned case manager come from the current consumer profile. Correct those facts in the profile before generating a draft." TextWrapping="Wrap" Margin="0,0,0,7" />
                            <TextBlock Text="Member or guardian contact information" Style="{StaticResource SafetyLabel}" />
                            <TextBox Text="{Binding MemberOrGuardianContact, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Member or guardian contact information" Width="460" HorizontalAlignment="Left"
                                     MaxLength="200" Style="{StaticResource SafetyField}" />
                            <TextBlock Text="Service or waiver program name and address" Style="{StaticResource SafetyLabel}" />
                            <TextBox Text="{Binding ProgramNameAndAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Service or waiver program name and address" Width="560" HorizontalAlignment="Left"
                                     MaxLength="300" Style="{StaticResource SafetyField}" />
                            <WrapPanel>
                                <StackPanel><TextBlock Text="Program contact names" Style="{StaticResource SafetyLabel}" />
                                    <TextBox Text="{Binding ProgramContacts, UpdateSourceTrigger=PropertyChanged}" Tag="Program contact names" Width="250" MaxLength="200" Style="{StaticResource SafetyField}" /></StackPanel>
                                <StackPanel><TextBlock Text="Contact numbers" Style="{StaticResource SafetyLabel}" />
                                    <TextBox Text="{Binding ProgramContactNumbers, UpdateSourceTrigger=PropertyChanged}" Tag="Program contact numbers" Width="220" MaxLength="200" Style="{StaticResource SafetyField}" /></StackPanel>
                                <StackPanel><TextBlock Text="Contact email addresses" Style="{StaticResource SafetyLabel}" />
                                    <TextBox Text="{Binding ProgramContactEmails, UpdateSourceTrigger=PropertyChanged}" Tag="Program contact email addresses" Width="270" MaxLength="200" Style="{StaticResource SafetyField}" /></StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Header="2. Medical provider and safety devices" IsExpanded="True" Margin="0,0,0,8">
                    <Border Padding="12" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Medical provider name (DO, MD, PA, or NP)" Style="{StaticResource SafetyLabel}" />
                            <TextBox Text="{Binding MedicalProviderName, UpdateSourceTrigger=PropertyChanged}" Tag="Medical provider name" Width="340" HorizontalAlignment="Left" MaxLength="200" Style="{StaticResource SafetyField}" />
                            <TextBlock Text="Enter up to ten recommendations. Rows 1–5 fill the main form; rows 6–10 fill Appendix B. Check Appendix A for the level. If a device is not listed there, OADS directs applicants to use Level 2." TextWrapping="Wrap" Margin="0,4,0,8" />
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" Margin="0,0,0,7" Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"><Run Text="Device "/><Run Text="{Binding Number, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PageLabel, Mode=OneWay}"/></TextBlock>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <StackPanel><TextBlock Text="Name and type" Style="{StaticResource SafetyLabel}" />
                                                        <TextBox Text="{Binding NameAndType, UpdateSourceTrigger=PropertyChanged}" Tag="Safety device name and type" Width="210" MaxLength="200" Style="{StaticResource SafetyField}" /></StackPanel>
                                                    <StackPanel><TextBlock Text="Purpose" Style="{StaticResource SafetyLabel}" />
                                                        <TextBox Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Tag="Safety device purpose" Width="230" MaxLength="300" Style="{StaticResource SafetyField}" /></StackPanel>
                                                    <StackPanel><TextBlock Text="When used" Style="{StaticResource SafetyLabel}" />
                                                        <TextBox Text="{Binding WhenUsed, UpdateSourceTrigger=PropertyChanged}" Tag="When safety device is used" Width="210" MaxLength="200" Style="{StaticResource SafetyField}" /></StackPanel>
                                                    <StackPanel><TextBlock Text="Level" Style="{StaticResource SafetyLabel}" />
                                                        <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"
                                                                  Width="65" Margin="0,3,8,8" AutomationProperties.Name="Safety device level" /></StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Header="3. Planning team questions" IsExpanded="True" Margin="0,0,0,8">
                    <Border Padding="12" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Less restrictive strategies tried and why they did not work" Style="{StaticResource SafetyLabel}" />
                            <TextBox Text="{Binding LessRestrictiveStrategies, UpdateSourceTrigger=PropertyChanged}" Tag="Less restrictive strategies tried" Width="650" HorizontalAlignment="Left" MinHeight="75" MaxLength="1500" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource SafetyField}" />
                            <TextBlock Text="How effectiveness will be evaluated, documented, and reviewed by the Team" Style="{StaticResource SafetyLabel}" />
                            <TextBox Text="{Binding EvaluationPlan, UpdateSourceTrigger=PropertyChanged}" Tag="Safety device evaluation and team review plan" Width="650" HorizontalAlignment="Left" MinHeight="75" MaxLength="1500" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource SafetyField}" />
                            <TextBlock Text="Accommodations for effects on the rights of other people" Style="{StaticResource SafetyLabel}" />
                            <TextBox Text="{Binding OtherResidentsAccommodations, UpdateSourceTrigger=PropertyChanged}" Tag="Accommodations for other people's rights" Width="650" HorizontalAlignment="Left" MinHeight="75" MaxLength="1500" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource SafetyField}" />
                            <TextBlock Text="Date the Planning Team met and approved the provider recommendations" Style="{StaticResource SafetyLabel}" />
                            <DatePicker SelectedDate="{Binding PlanningTeamMeetingDate}" Margin="0,3,0,8" Width="170" HorizontalAlignment="Left" AutomationProperties.Name="Planning team meeting date" />
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Padding="12" CornerRadius="7" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding ReviewItemsMessage}" TextWrapping="Wrap" Margin="0,3,10,0" Foreground="{DynamicResource WarningBrush}" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,7,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Reset answers" Command="{Binding ResetAnswersCommand}" Padding="13,7" Margin="0,0,8,0" />
                    <Button Content="Generate editable draft PDF" Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}" Padding="16,7" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
