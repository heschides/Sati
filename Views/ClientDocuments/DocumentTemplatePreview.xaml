<UserControl x:Class="Sati.Views.ClientDocuments.DocumentTemplatePreview"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="Transparent">
 <Border Background="White" BorderBrush="#C9D3DA" BorderThickness="1" CornerRadius="4" Padding="18"
  AutomationProperties.Name="Live privacy template preview">
  <DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
    <TextBlock Text="LIVE DOCUMENT PREVIEW" Foreground="#2F7D7A" FontSize="11" FontWeight="Bold"/>
    <TextBlock Text="CONFIDENTIAL" Foreground="#5C6873" FontSize="10" Margin="0,3,0,0"/>
    <Separator Margin="0,8,0,0" Background="#2F7D7A"/>
   </StackPanel>
   <FlowDocumentScrollViewer x:Name="PreviewViewer" IsToolBarVisible="False"
    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
    Background="White" Foreground="#17324D"/>
  </DockPanel>
 </Border>
</UserControl>
