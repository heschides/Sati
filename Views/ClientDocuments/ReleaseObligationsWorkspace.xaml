<UserControl x:Class="Sati.Views.ClientDocuments.ReleaseObligationsWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="360">
    <Grid>
      <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Releases"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           AutomationProperties.HeadingLevel="Level3" />
                <TextBlock Text="Prepare authorizations, follow their status, and keep annual provider requirements separate from one-off recipients."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,3,16,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="New one-off release"
                    Command="{Binding PrepareOneOffReleaseCommand}"
                    Padding="12,5"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Create an untracked one-off release" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                    AutomationProperties.Name="Release workflow type">
            <Button Content="Provider requirements"
                    Command="{Binding ShowProviderRequirementsCommand}"
                    Padding="12,6" />
            <Button Content="One-off releases"
                    Command="{Binding ShowOneOffReleasesCommand}"
                    Padding="12,6"
                    Margin="6,0,0,0" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsProviderRequirementsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Text="{Binding SignerLabel}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,8"
                   AutomationProperties.Name="Required release signer" />

        <ItemsControl ItemsSource="{Binding LinkageIssues}"
                      Visibility="{Binding HasLinkageIssues, Converter={StaticResource BoolToVisibilityConverter}}"
                      AutomationProperties.Name="Release review issues">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource WarningSoftBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8"
                            Margin="0,0,0,6">
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Items}"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}"
                      AutomationProperties.Name="Release obligations">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,7"
                            AutomationProperties.Name="{Binding AutomationName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding CycleLabel}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TimingLabel}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding WorkflowStage}"
                                           Margin="0,5,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           AutomationProperties.Name="Release workflow stage" />
                                <TextBlock Text="{Binding WorkflowDescription}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding StatusLabel}"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <Button Content="Prepare for delivery"
                                        Command="{Binding DataContext.PrepareReleaseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanPrepare, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Padding="10,4"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Prepare {0} for delivery'}" />
                                <Button Content="Attest"
                                        Command="{Binding DataContext.BeginAttestationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanAttest}"
                                        Margin="0,6,0,0"
                                        Padding="10,4"
                                        AutomationProperties.Name="{Binding AttestAutomationName}" />
                                <Button Content="Withdraw"
                                        Command="{Binding DataContext.BeginWithdrawalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanWithdraw, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,6,0,0"
                                        Padding="10,4"
                                        AutomationProperties.Name="{Binding WithdrawAutomationName}" />
                                <Button Content="Correct attestation"
                                        Command="{Binding DataContext.BeginRevocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanRevokeAttestation, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,6,0,0"
                                        Padding="10,4"
                                        AutomationProperties.Name="{Binding RevokeAutomationName}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="No release obligations are currently available."
                   Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibilityConverter}}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,2,0,8" />

        <Border Visibility="{Binding HasAttestationEditor, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,4,0,8">
            <StackPanel>
                <TextBlock Text="{Binding SelectedForAttestation.Name}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="ACTUAL COMPLETION DATE"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,8,0,4" />
                <DatePicker SelectedDate="{Binding CompletionDate, UpdateSourceTrigger=PropertyChanged}"
                            Width="170"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Release attestation completion date"
                            AutomationProperties.HelpText="Choose the date the authorization was actually completed. This field starts blank." />
                <TextBlock Text="{Binding CompletionDateError}"
                           Foreground="{DynamicResource DangerStrongBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Complete attestation"
                            Command="{Binding CompleteAttestationCommand}"
                            Padding="10,5"
                            AutomationProperties.Name="Complete release attestation" />
                    <Button Content="Cancel"
                            Command="{Binding CancelEditorsCommand}"
                            Padding="10,5"
                            Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Visibility="{Binding HasRevocationEditor, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,4,0,8">
            <StackPanel>
                <TextBlock Text="{Binding SelectedForRevocation.Name}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Correcting an attestation retains the original date and reason in history. This does not withdraw the release authorization."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,3,0,8" />
                <TextBlock Text="WHY IS THIS ATTESTATION BEING REVOKED?" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding RevocationReason, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="500"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="52"
                         AutomationProperties.Name="Release attestation revocation reason" />
                <TextBlock Text="{Binding RevocationError}"
                           Foreground="{DynamicResource DangerStrongBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Revoke attestation"
                            Command="{Binding CompleteRevocationCommand}"
                            Padding="10,5"
                            AutomationProperties.Name="Revoke release attestation" />
                    <Button Content="Cancel"
                            Command="{Binding CancelEditorsCommand}"
                            Padding="10,5"
                            Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Visibility="{Binding HasWithdrawalEditor, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,4,0,8">
            <StackPanel>
                <TextBlock Text="{Binding SelectedForWithdrawal.Name}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Withdrawal preserves the historical attestation and ends the authorization prospectively."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,3,0,8" />
                <TextBlock Text="ACTUAL WITHDRAWAL DATE" Style="{StaticResource LabelStyle}" />
                <DatePicker SelectedDate="{Binding WithdrawalDate, UpdateSourceTrigger=PropertyChanged}"
                            Width="170"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Release withdrawal date" />
                <TextBlock Text="EXPLANATION" Style="{StaticResource LabelStyle}" Margin="0,8,0,4" />
                <TextBox Text="{Binding WithdrawalReason, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="500"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="52"
                         AutomationProperties.Name="Release withdrawal explanation" />
                <TextBlock Text="{Binding WithdrawalError}"
                           Foreground="{DynamicResource DangerStrongBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Record withdrawal"
                            Command="{Binding CompleteWithdrawalCommand}"
                            Padding="10,5"
                            AutomationProperties.Name="Record release withdrawal" />
                    <Button Content="Cancel"
                            Command="{Binding CancelEditorsCommand}"
                            Padding="10,5"
                            Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
        </StackPanel>

        <StackPanel Visibility="{Binding IsOneOffReleasesVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource PersonGroupAltBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="0,0,0,0"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,10">
                <TextBlock Text="One-off releases use the same document and signing tools, but do not add a provider or change annual compliance."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>

            <ItemsControl ItemsSource="{Binding OneOffReleases}"
                          Visibility="{Binding HasOneOffReleases, Converter={StaticResource BoolToVisibilityConverter}}"
                          AutomationProperties.Name="One-off releases">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding RecipientName}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DocumentType}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding WorkflowStage}"
                                               Margin="0,5,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding PreparedLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ProviderStatus}"
                                               Visibility="{Binding HasPromotedProvider, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessStrongBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Add to provider list"
                                        Command="{Binding DataContext.BeginAddOneOffProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanAddToProviderList, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Padding="10,5"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Add one-off recipient to provider list" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No one-off releases have been prepared for this consumer."
                       Visibility="{Binding HasNoOneOffReleases, Converter={StaticResource BoolToVisibilityConverter}}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,10,0,8" />
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>

      <Border Background="#88000000"
              Visibility="{Binding HasProviderModal, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="20"
              AutomationProperties.Name="Add provider from one-off release modal">
        <Border MaxWidth="620"
                MaxHeight="680"
                Margin="16"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Add provider"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="Available details were copied from the prepared one-off release. Review them before saving."
                         Margin="0,4,0,12"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <Border Background="{DynamicResource WarningSoftBrush}"
                      BorderBrush="{DynamicResource WarningBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="9"
                      Margin="0,0,0,12">
                <TextBlock Text="The original one-off release stays unchanged. Assigning this provider may create future tracked release requirements; it does not retroactively convert this document."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </Border>

              <TextBlock Text="Provider name *" Style="{StaticResource LabelStyle}" />
              <TextBox Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Provider name from one-off release" />
              <TextBlock Text="Provider type" Style="{StaticResource LabelStyle}" />
              <ComboBox ItemsSource="{Binding ProviderTypes}"
                        SelectedItem="{Binding ProviderType}"
                        AutomationProperties.Name="Provider type from one-off release" />
              <TextBlock Text="Street" Style="{StaticResource LabelStyle}" />
              <TextBox Text="{Binding ProviderStreet, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Provider street from one-off release" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="City" Style="{StaticResource LabelStyle}" />
                  <TextBox Text="{Binding ProviderCity, UpdateSourceTrigger=PropertyChanged}"
                           AutomationProperties.Name="Provider city from one-off release" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="State" Style="{StaticResource LabelStyle}" />
                  <TextBox Text="{Binding ProviderState, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"
                           AutomationProperties.Name="Provider state from one-off release" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="ZIP" Style="{StaticResource LabelStyle}" />
                  <TextBox Text="{Binding ProviderZip, UpdateSourceTrigger=PropertyChanged}"
                           AutomationProperties.Name="Provider ZIP code from one-off release" />
                </StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Phone" Style="{StaticResource LabelStyle}" />
                  <TextBox Text="{Binding ProviderPhone, UpdateSourceTrigger=PropertyChanged}"
                           AutomationProperties.Name="Provider phone from one-off release" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Email" Style="{StaticResource LabelStyle}" />
                  <TextBox Text="{Binding ProviderEmail, UpdateSourceTrigger=PropertyChanged}"
                           AutomationProperties.Name="Provider email from one-off release" />
                </StackPanel>
              </Grid>

              <CheckBox Content="Assign this provider to the current consumer after saving"
                        IsChecked="{Binding AssignProviderToConsumer}"
                        Margin="0,10,0,6" />
              <StackPanel Visibility="{Binding AssignProviderToConsumer, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Assignment start date *" Style="{StaticResource LabelStyle}" />
                <DatePicker SelectedDate="{Binding ProviderAssignmentStartDate}" Width="180" HorizontalAlignment="Left"
                            AutomationProperties.Name="Provider assignment start date from one-off release" />
                <TextBlock Text="Role / relationship" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding ProviderAssignmentRole, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Provider assignment role from one-off release" />
              </StackPanel>

              <TextBlock Text="{Binding ProviderModalError}"
                         Margin="0,8,0,0"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource DangerStrongBrush}"
                         AutomationProperties.LiveSetting="Assertive" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel"
                        Command="{Binding CancelAddOneOffProviderCommand}"
                        Padding="12,6" />
                <Button Content="Add provider"
                        Command="{Binding SaveOneOffProviderCommand}"
                        Padding="14,6"
                        Margin="8,0,0,0"
                        FontWeight="SemiBold" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Border>
    </Grid>
</UserControl>
