<UserControl x:Class="Sati.Views.ClientDocuments.HousingSupportFundsWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource WindowBackgroundBrush}" DataContextChanged="OnDataContextChanged">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  <Style x:Key="HousingField" TargetType="TextBox">
   <Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,3,8,8"/>
   <Setter Property="MinWidth" Value="150"/><Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
  </Style>
  <Style x:Key="HousingLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
   <Setter Property="Margin" Value="0,2,8,0"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="16" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="HOUSING SUPPORT FUNDS APPLICATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
     <TextBlock Text="{Binding PersonName}" Margin="0,4,0,5" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"/>
     <TextBlock Text="{Binding SourceRevision}" Foreground="{DynamicResource TextSecondaryBrush}"/>
     <TextBlock Text="This screen collects application answers; it is not a page preview. Generate the editable draft PDF to review the actual three-page OADS form with the values applied."
                Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
    </StackPanel>
    <Border Grid.Column="2" Padding="12" CornerRadius="6" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
     <TextBlock Text="Sati creates an editable draft of the state's three-page form. Consumer and guardian signatures and dates remain blank. Every field on page 3 remains blank because it is marked DHHS Staff Only." TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
    </Border>
   </Grid>
  </Border>

  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Housing Support Funds application answers">
    <StackPanel>
     <Border Padding="12" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <StackPanel>
       <TextBlock Text="PROFILE FACTS USED BY THE FORM" Style="{StaticResource HousingLabel}"/>
       <WrapPanel>
        <TextBlock Margin="0,3,22,0"><Run Text="Waiver: "/><Run FontWeight="Bold" Text="{Binding WaiverDisplay, Mode=OneWay}"/></TextBlock>
        <TextBlock Margin="0,3,22,0"><Run Text="Shared Living: "/><Run FontWeight="Bold" Text="{Binding SharedLivingDisplay, Mode=OneWay}"/></TextBlock>
        <TextBlock Margin="0,3,22,0"><Run Text="Guardian: "/><Run FontWeight="Bold" Text="{Binding GuardianName, Mode=OneWay}"/></TextBlock>
       </WrapPanel>
       <TextBlock Text="Correct profile facts in the consumer profile rather than changing them only on this application." Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>
     </Border>

     <Border Padding="12" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Visibility="{Binding HasEligibilityConflict, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="{Binding EligibilityMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite"/>
     </Border>

     <Expander Header="1. Consumer and housing" IsExpanded="True" Margin="0,0,0,8">
      <Border Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
       <StackPanel>
        <WrapPanel>
         <StackPanel><TextBlock Text="Consumer telephone" Style="{StaticResource HousingLabel}"/><TextBox Text="{Binding ConsumerTelephone, UpdateSourceTrigger=PropertyChanged}" Tag="Consumer telephone" Style="{StaticResource HousingField}"/></StackPanel>
         <StackPanel><TextBlock Text="Consumer email" Style="{StaticResource HousingLabel}"/><TextBox Text="{Binding ConsumerEmail, UpdateSourceTrigger=PropertyChanged}" Tag="Consumer email" Width="250" Style="{StaticResource HousingField}"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="Consumer address" Style="{StaticResource HousingLabel}"/><TextBox Text="{Binding ConsumerAddress, UpdateSourceTrigger=PropertyChanged}" Tag="Consumer address" Width="470" HorizontalAlignment="Left" Style="{StaticResource HousingField}"/>
        <WrapPanel>
         <StackPanel><TextBlock Text="Housing type" Style="{StaticResource HousingLabel}"/><ComboBox ItemsSource="{Binding HousingTypes}" SelectedItem="{Binding HousingType}" MinWidth="190" Margin="0,3,8,8" AutomationProperties.Name="Housing type"/></StackPanel>
         <StackPanel><TextBlock Text="Monthly rent or mortgage" Style="{StaticResource HousingLabel}"/><TextBox Text="{Binding MonthlyHousingAmount, UpdateSourceTrigger=PropertyChanged}" Tag="Monthly rent or mortgage amount" Width="150" Style="{StaticResource HousingField}"/></StackPanel>
         <StackPanel><TextBlock Text="Amount requested (maximum $3,000)" Style="{StaticResource HousingLabel}"/><TextBox Text="{Binding AmountRequested, UpdateSourceTrigger=PropertyChanged}" Tag="Housing support amount requested" Width="175" Style="{StaticResource HousingField}"/></StackPanel>
        </WrapPanel>
        <StackPanel Visibility="{Binding ShowLandlord, Converter={StaticResource BooleanToVisibilityConverter}}">
         <TextBlock Text="RENTAL / LANDLORD INFORMATION" Style="{StaticResource HousingLabel}" Margin="0,5,0,2"/>
         <WrapPanel><StackPanel><TextBlock Text="Landlord name" Style="{StaticResource HousingLabel}"/><TextBox Text="{Binding LandlordName, UpdateSourceTrigger=PropertyChanged}" Tag="Landlord name" Style="{StaticResource HousingField}"/></StackPanel><StackPanel><TextBlock Text="Telephone" Style="{StaticResource HousingLabel}"/><TextBox Text="{Binding LandlordTelephone, UpdateSourceTrigger=PropertyChanged}" Tag="Landlord telephone" Style="{StaticResource HousingField}"/></StackPanel><StackPanel><TextBlock Text="Email" Style="{StaticResource HousingLabel}"/><TextBox Text="{Binding LandlordEmail, UpdateSourceTrigger=PropertyChanged}" Tag="Landlord email" Width="230" Style="{StaticResource HousingField}"/></StackPanel></WrapPanel>
         <TextBlock Text="Landlord address" Style="{StaticResource HousingLabel}"/><TextBox Text="{Binding LandlordAddress, UpdateSourceTrigger=PropertyChanged}" Tag="Landlord address" Width="470" HorizontalAlignment="Left" Style="{StaticResource HousingField}"/>
        </StackPanel>
        <WrapPanel>
         <StackPanel><TextBlock Text="Does the consumer receive a subsidy?" Style="{StaticResource HousingLabel}"/><ComboBox ItemsSource="{Binding YesNoChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ReceivesSubsidy}" MinWidth="150" Margin="0,3,8,8" AutomationProperties.Name="Consumer receives housing subsidy"/></StackPanel>
         <StackPanel Visibility="{Binding ShowSubsidyType, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Subsidy type" Style="{StaticResource HousingLabel}"/><TextBox Text="{Binding SubsidyType, UpdateSourceTrigger=PropertyChanged}" Tag="Housing subsidy type" Width="280" Style="{StaticResource HousingField}"/></StackPanel>
        </WrapPanel>
        <CheckBox Content="Proof of room and board agreement, lease, or mortgage is ready to accompany this application" IsChecked="{Binding SupportingDocumentReady}" Margin="0,6,0,2" AutomationProperties.Name="Required housing proof is ready"/>
       </StackPanel>
      </Border>
     </Expander>

     <Expander Header="2. Guardian and representative payee" IsExpanded="True" Margin="0,0,0,8">
      <Border Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
       <StackPanel>
        <TextBlock Text="Guardian contact information" Style="{StaticResource HousingLabel}" Visibility="{Binding HasGuardian, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <StackPanel Visibility="{Binding HasGuardian, Converter={StaticResource BooleanToVisibilityConverter}}">
         <TextBox Text="{Binding GuardianAddress, UpdateSourceTrigger=PropertyChanged}" Tag="Guardian address" Width="470" HorizontalAlignment="Left" Style="{StaticResource HousingField}"/>
         <WrapPanel><TextBox Text="{Binding GuardianTelephone, UpdateSourceTrigger=PropertyChanged}" Tag="Guardian telephone" Style="{StaticResource HousingField}"/><TextBox Text="{Binding GuardianEmail, UpdateSourceTrigger=PropertyChanged}" Tag="Guardian email" Width="250" Style="{StaticResource HousingField}"/></WrapPanel>
        </StackPanel>
        <TextBlock Text="Representative payee (leave blank if none)" Style="{StaticResource HousingLabel}" Margin="0,5,0,0"/>
        <WrapPanel><TextBox Text="{Binding RepresentativePayeeName, UpdateSourceTrigger=PropertyChanged}" Tag="Representative payee name" Width="230" Style="{StaticResource HousingField}"/><TextBox Text="{Binding RepresentativePayeeAddress, UpdateSourceTrigger=PropertyChanged}" Tag="Representative payee address" Width="330" Style="{StaticResource HousingField}"/></WrapPanel>
       </StackPanel>
      </Border>
     </Expander>

     <Expander Header="3. Provider and request details" IsExpanded="True" Margin="0,0,0,8">
      <Border Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
       <StackPanel>
        <TextBlock Text="Provider and case-manager values come from the assigned consumer and signed-in agency." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,7"/>
        <WrapPanel><TextBlock Margin="0,2,24,5"><Run Text="Case manager: "/><Run FontWeight="Bold" Text="{Binding CaseManagerName, Mode=OneWay}"/></TextBlock><TextBlock Margin="0,2,0,5"><Run Text="Provider: "/><Run FontWeight="Bold" Text="{Binding ProviderName, Mode=OneWay}"/></TextBlock></WrapPanel>
        <TextBlock Text="{Binding ProviderAddress}" TextWrapping="Wrap"/>
        <TextBlock><Run Text="Provider phone: "/><Run Text="{Binding ProviderTelephone, Mode=OneWay}"/><Run Text="   Email: "/><Run Text="{Binding ProviderEmail, Mode=OneWay}"/></TextBlock>
        <TextBlock Text="Additional details supporting the request" Style="{StaticResource HousingLabel}" Margin="0,10,0,0"/>
        <TextBox Text="{Binding AdditionalDetails, UpdateSourceTrigger=PropertyChanged}" Tag="Additional Housing Support Funds request details" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxLength="2000" Style="{StaticResource HousingField}"/>
       </StackPanel>
      </Border>
     </Expander>
    </StackPanel>
  </ScrollViewer>

  <Border Grid.Row="4" Padding="12" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding ReviewItemsMessage}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,3,10,0"/><ProgressBar IsIndeterminate="True" Height="3" Margin="0,7,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Reset to profile" Command="{Binding ResetCommand}" Padding="13,7" Margin="0,0,8,0"/><Button Content="Generate editable draft PDF" Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}" Padding="16,7" FontWeight="SemiBold"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
