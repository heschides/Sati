<UserControl x:Class="Sati.Views.ClientDocuments.ComprehensiveAssessmentWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Sati.Converters"
             x:Name="AssessmentControl"
             Background="Transparent"
             AutomationProperties.Name="Comprehensive assessment workspace">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:NullableBoolChoiceConverter x:Key="NullableBoolChoice" />
        <converters:EnumChoiceConverter x:Key="EnumChoice" />
        <Style x:Key="Card" TargetType="Border">
            <!-- The card face slopes from the raised surface into the slightly
                 darker alternate surface. The diagonal translucent border adds
                 a restrained highlight/shadow bevel in both light and dark themes. -->
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,-0.5" EndPoint="0,1.5">
                        <GradientStop Color="{DynamicResource SurfaceRaisedColor}" Offset="0" />
                        <GradientStop Color="{DynamicResource SurfaceRaisedColor}" Offset="0.38" />
                        <GradientStop Color="{DynamicResource SurfaceAltColor}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="-0.5,-0.5" EndPoint="1.5,1.5">
                        <GradientStop Color="#4CFFFFFF" Offset="0" />
                        <GradientStop Color="#18000000" Offset="0.48" />
                        <GradientStop Color="#42000000" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,12,16" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="GuideLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="GuideText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid DataContext="{Binding Workspace, ElementName=AssessmentControl}" IsEnabled="{Binding HasPerson}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="COMPREHENSIVE ASSESSMENT" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding PersonName}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                <ComboBox ItemsSource="{Binding AnnualForms}" SelectedItem="{Binding SelectedAnnualForm}" IsEnabled="{Binding CanEdit}"
                          AutomationProperties.Name="Annual assessment Form being documented" Margin="0,6" MaxWidth="500" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock>
                        <Run Text="Annual target "/><Run Text="{Binding TargetEffectiveDate, Mode=OneWay, StringFormat={}{0:MM/dd/yyyy}}"/>
                        <Run Text=" · due "/><Run Text="{Binding DueDate, Mode=OneWay, StringFormat={}{0:MM/dd/yyyy}}"/>
                    </TextBlock></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Create a new version from approved content" Command="{Binding CreateNewVersionCommand}"
                        IsEnabled="{Binding CanCreateVersion}" HorizontalAlignment="Left"/>
                <Button Content="Reopen legacy submission for validated review" Command="{Binding ReopenLegacyCommand}"
                        Visibility="{Binding CanReopenLegacy, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Reopen legacy assessment without review snapshots" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="{Binding CompletionText}" HorizontalAlignment="Right" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding SaveStatus}" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.LiveSetting="Polite" />
                <Button Content="Submit for supervisor review" Command="{Binding SubmitForReviewCommand}"
                        IsEnabled="{Binding CanEdit}" Margin="0,7,0,0" Padding="12,5" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,12,8,6">
                        <TextBlock Text="Drafts save automatically" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="Completion requires every question to be addressed."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                             Background="Transparent" BorderThickness="0" AutomationProperties.Name="Assessment sections">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,7" Width="184">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                    <ListBox x:Name="ValidationSummary" ItemsSource="{Binding ValidationIssues}" MaxHeight="180"
                             AutomationProperties.Name="Assessment submission validation summary" Margin="0,0,12,10">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Location, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Message, Mode=OneWay}"/>
                        </TextBlock></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Expander Header="Submissions and review history" Margin="0,0,12,12">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Submissions}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4">
                                <Button DockPanel.Dock="Right" Content="Save version PDF" Command="{Binding DataContext.GeneratePdfCommand, RelativeSource={RelativeSource AncestorType=Grid}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="Save identified assessment submission PDF"/>
                                <TextBlock><Run Text="Version "/><Run Text="{Binding AssessmentVersion, Mode=OneWay}"/><Run Text=" · review "/><Run Text="{Binding CycleNumber, Mode=OneWay}"/><Run Text=" · submission "/><Run Text="{Binding Id, Mode=OneWay}"/></TextBlock>
                            </DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <ItemsControl ItemsSource="{Binding ReviewHistory}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4">
                                <TextBlock><Run Text="{Binding Action, Mode=OneWay}"/><Run Text=" · submission "/><Run Text="{Binding SubmissionId, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding RecordedAtUtc, Mode=OneWay, StringFormat={}{0:u}}"/></TextBlock>
                                <TextBlock Text="{Binding Location}"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                            </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <StackPanel IsEnabled="{Binding CanRespond}">
                                <ComboBox ItemsSource="{Binding OpenFlags}" SelectedItem="{Binding SelectedReviewFlag}" DisplayMemberPath="Text" AutomationProperties.Name="Assessment flag to respond to"/>
                                <TextBox Text="{Binding FlagResponse, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" AutomationProperties.Name="Author response to assessment review flag"/>
                                <Button Content="Record response; reviewer resolves the flag" Command="{Binding RespondToFlagCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEdit}">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="Assessment contributors" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Add everyone who contributed information to this report. The assigned case manager is recorded automatically as the author."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Contributors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Contributor name" />
                                                <TextBox Grid.Column="2" Text="{Binding Relationship, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Contributor role or relationship" />
                                                <Button Grid.Column="4" Content="Remove" Command="{Binding RemoveCommand}" Padding="10,4" AutomationProperties.Name="Remove contributor" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Add contributor" Command="{Binding AddContributorCommand}" HorizontalAlignment="Left" Padding="12,5" />
                            </StackPanel>
                        </Expander>
                    </Border>

                    <TextBlock Text="{Binding SelectedSection.Title}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding SelectedSection.Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,14" />

                    <ItemsControl ItemsSource="{Binding SelectedSection.Questions}" IsEnabled="{Binding CanEdit}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding Prompt}" FontSize="16.8" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                                       AutomationProperties.HeadingLevel="Level3" />
                                        </Expander.Header>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                        <!-- A narrow, partially transparent theme accent makes
                                             the start and end of each question easy to scan. -->
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Opacity="0.45" />

                                        <StackPanel Grid.Column="2">
                                        <Expander Header="How to answer this" Margin="0,10,0,10"
                                                  Visibility="{Binding HasGuidance, Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="Practical answer guidance">
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="5" Padding="12" Margin="0,5,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Why we ask" Style="{StaticResource GuideLabel}" Margin="0,0,0,2" />
                                                    <TextBlock Text="{Binding WhyAsked}" Style="{StaticResource GuideText}" />
                                                    <TextBlock Text="A complete answer includes" Style="{StaticResource GuideLabel}" />
                                                    <TextBlock Text="{Binding CompleteAnswerIncludes}" Style="{StaticResource GuideText}" />
                                                    <TextBlock Text="Avoid" Style="{StaticResource GuideLabel}" />
                                                    <TextBlock Text="{Binding Avoid}" Style="{StaticResource GuideText}" />
                                                </StackPanel>
                                            </Border>
                                        </Expander>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Answer status" Style="{StaticResource GuideLabel}" />
                                                <ComboBox ItemsSource="{Binding Workspace.AnswerStatuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding Status}"
                                                          AutomationProperties.Name="Answer status">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        Visibility="{Binding ShowExceptionReason, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding ExceptionReasonPrompt}" Style="{StaticResource GuideLabel}" />
                                                <TextBox Text="{Binding ExceptionReason, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" MinHeight="50" TextWrapping="Wrap"
                                                         AutomationProperties.Name="{Binding ExceptionReasonPrompt}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Visibility="{Binding IsNarrative, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Team assessment" Style="{StaticResource GuideLabel}" />
                                            <TextBox Text="{Binding Narrative, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                     MinHeight="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     SpellCheck.IsEnabled="True" AutomationProperties.Name="Team assessment answer" />
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding UsesYesNo, Converter={StaticResource BoolToVisibility}}"
                                                    Margin="0,10,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Yes" Margin="0,0,22,0"
                                                             IsChecked="{Binding YesNoResponse, Converter={StaticResource NullableBoolChoice}, ConverterParameter=True, Mode=TwoWay}" />
                                                <RadioButton Content="No"
                                                             IsChecked="{Binding YesNoResponse, Converter={StaticResource NullableBoolChoice}, ConverterParameter=False, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding ShowHealthConcernDetails, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Please describe" Style="{StaticResource GuideLabel}" />
                                            <TextBox Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"
                                                     AutomationProperties.Name="Please describe monitored health and wellness concerns" />
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding ShowTherapyRequestedFollowUp, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding WouldLikeTherapistPrompt}" Style="{StaticResource GuideLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Yes" Margin="0,0,22,0"
                                                             IsChecked="{Binding FollowUpYesNoResponse, Converter={StaticResource NullableBoolChoice}, ConverterParameter=True, Mode=TwoWay}" />
                                                <RadioButton Content="No"
                                                             IsChecked="{Binding FollowUpYesNoResponse, Converter={StaticResource NullableBoolChoice}, ConverterParameter=False, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding ShowTherapyCurrentFollowUps, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding TherapistSatisfactionPrompt}" Style="{StaticResource GuideLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Yes" Margin="0,0,22,0"
                                                             IsChecked="{Binding FollowUpYesNoResponse, Converter={StaticResource NullableBoolChoice}, ConverterParameter=True, Mode=TwoWay}" />
                                                <RadioButton Content="No"
                                                             IsChecked="{Binding FollowUpYesNoResponse, Converter={StaticResource NullableBoolChoice}, ConverterParameter=False, Mode=TwoWay}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding SessionFormatPrompt}" Style="{StaticResource GuideLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="In person" Margin="0,0,22,0"
                                                             IsChecked="{Binding TherapySessionFormat, Converter={StaticResource EnumChoice}, ConverterParameter=InPerson, Mode=TwoWay}" />
                                                <RadioButton Content="Telehealth"
                                                             IsChecked="{Binding TherapySessionFormat, Converter={StaticResource EnumChoice}, ConverterParameter=Telehealth, Mode=TwoWay}" />
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding ShowOtherSessionFormatQuestion, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding OtherSessionFormatPrompt}" Style="{StaticResource GuideLabel}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="Yes" Margin="0,0,22,0"
                                                                 IsChecked="{Binding WantsOtherSessionFormat, Converter={StaticResource NullableBoolChoice}, ConverterParameter=True, Mode=TwoWay}" />
                                                    <RadioButton Content="No"
                                                                 IsChecked="{Binding WantsOtherSessionFormat, Converter={StaticResource NullableBoolChoice}, ConverterParameter=False, Mode=TwoWay}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Text="{Binding FrequencyChangePrompt}" Style="{StaticResource GuideLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Yes" Margin="0,0,22,0"
                                                             IsChecked="{Binding WantsFrequencyChange, Converter={StaticResource NullableBoolChoice}, ConverterParameter=True, Mode=TwoWay}" />
                                                <RadioButton Content="No"
                                                             IsChecked="{Binding WantsFrequencyChange, Converter={StaticResource NullableBoolChoice}, ConverterParameter=False, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding ShowFrequencyDirection, Converter={StaticResource BoolToVisibility}}"
                                                        Margin="0,8,0,0">
                                                <RadioButton Content="Increase" Margin="0,0,22,0"
                                                             IsChecked="{Binding TherapyFrequencyDirection, Converter={StaticResource EnumChoice}, ConverterParameter=Increase, Mode=TwoWay}" />
                                                <RadioButton Content="Decrease"
                                                             IsChecked="{Binding TherapyFrequencyDirection, Converter={StaticResource EnumChoice}, ConverterParameter=Decrease, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding UsesActivitySupport, Converter={StaticResource BoolToVisibility}}"
                                                    Margin="0,12,0,4">
                                            <Grid Margin="170,0,0,8" Width="550" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" /><ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Independent" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="Prompting" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="Monitoring" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3" Text="Physical Assistance" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="4" Text="Total Care" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Activities}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="160" />
                                                                <ColumnDefinition Width="550" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="4"
                                                                    Value="{Binding LevelValue, Mode=TwoWay}"
                                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    TickPlacement="BottomRight"
                                                                    AutomationProperties.Name="{Binding Name}" />
                                                            <CheckBox Grid.Column="2" Content="Skills training"
                                                                      IsChecked="{Binding SkillsTraining}"
                                                                      VerticalAlignment="Center" Margin="18,0,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding UsesSupports, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Support currently used — select all that apply" Style="{StaticResource GuideLabel}" />
                                            <WrapPanel>
                                                <CheckBox Content="No support currently needed" IsChecked="{Binding NoSupportCurrentlyNeeded}" Margin="0,3,18,5" />
                                                <CheckBox Content="Setup or environmental support" IsChecked="{Binding SetupOrEnvironmental}" Margin="0,3,18,5" />
                                                <CheckBox Content="Prompting or coaching" IsChecked="{Binding PromptingOrCoaching}" Margin="0,3,18,5" />
                                                <CheckBox Content="Hands-on assistance" IsChecked="{Binding HandsOnAssistance}" Margin="0,3,18,5" />
                                                <CheckBox Content="Another person completes some or all" IsChecked="{Binding AnotherPersonCompletes}" Margin="0,3,18,5" />
                                                <CheckBox Content="Varies by situation" IsChecked="{Binding Varies}" Margin="0,3,18,5" />
                                            </WrapPanel>
                                            <TextBlock Text="Explain which support applies to which part, situation, or setting. Required when support varies."
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,4" />
                                            <TextBox Text="{Binding SupportDetails, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                     MinHeight="55" TextWrapping="Wrap" AutomationProperties.Name="Support details" />
                                        </StackPanel>

                                        <Expander Header="Add a differing perspective" Margin="0,12,0,0">
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Text="Record who disagrees, their view, whether it was discussed, and whether it remains unresolved."
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
                                                <TextBox Text="{Binding DissentingOpinion, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                         MinHeight="60" TextWrapping="Wrap" AutomationProperties.Name="Differing perspective" />
                                                <TextBox Text="{Binding DissentContributor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Whose differing perspective" Margin="0,6"/>
                                                <TextBox Text="{Binding DissentDiscussion, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="45" AutomationProperties.Name="Discussion of differing perspective"/>
                                                <WrapPanel Margin="0,6">
                                                    <RadioButton Content="Still unresolved" IsChecked="{Binding DissentUnresolved, Converter={StaticResource NullableBoolChoice}, ConverterParameter=True}" Margin="0,0,16,0"/>
                                                    <RadioButton Content="Resolved through the discussion above" IsChecked="{Binding DissentUnresolved, Converter={StaticResource NullableBoolChoice}, ConverterParameter=False}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                        </StackPanel>
                                        </Grid>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsSummarySelected, Converter={StaticResource BoolToVisibility}}"
                            IsEnabled="{Binding CanEdit}">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="Identified needs" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Record material needs and broader support, access, autonomy, health, relationship, or planning needs separately so they can feed the PCP."
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Needs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding Workspace.NeedTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding Type}" Width="270" HorizontalAlignment="Left"
                                                              AutomationProperties.Name="Need type">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="Remove need" Command="{Binding RemoveCommand}" Padding="10,4" />
                                                </Grid>
                                                <TextBlock Text="What is needed?" Style="{StaticResource GuideLabel}" />
                                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="55" TextWrapping="Wrap" />
                                                <TextBlock Text="What result is wanted?" Style="{StaticResource GuideLabel}" />
                                                <TextBox Text="{Binding DesiredResult, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="45" TextWrapping="Wrap" />
                                                <CheckBox Content="Associate a service provider with this need" IsChecked="{Binding AssociateProvider}" Margin="0,10,0,4" />

                                                <!-- Chosen from the consumer's own provider list, not typed.
                                                     Selecting one FREEZES its practice and network onto this
                                                     document: an assessment approved in March has to keep saying
                                                     what it said in March, even after the clinician moves. This
                                                     is the one place in Sati the chain is copied rather than
                                                     derived, and it is deliberate. -->
                                                <ComboBox ItemsSource="{Binding ProviderOptions}"
                                                          DisplayMemberPath="Display"
                                                          SelectedValuePath="ProviderId"
                                                          SelectedValue="{Binding ProviderId, Mode=TwoWay}"
                                                          AutomationProperties.Name="Provider associated with this need"
                                                          Visibility="{Binding HasProviderOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding AssociateProvider}" Value="True"><Setter Property="IsEnabled" Value="True" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>

                                                <!-- Nothing to choose from: the consumer has no linked providers
                                                     yet. Says where to go rather than showing an empty control. -->
                                                <TextBlock Text="No providers are linked to this consumer yet. Add them on the consumer's profile first."
                                                           AutomationProperties.Name="No linked providers to associate"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding HasProviderOptions, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                                <!-- What the document actually records, including entries whose
                                                     provider was typed before the directory existed or is no
                                                     longer on the consumer's list. Read-only: the document keeps
                                                     what it froze. -->
                                                <TextBlock Text="{Binding RecordedProvider}"
                                                           AutomationProperties.Name="Provider recorded on this need"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding HasRecordedProvider, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                                <TextBlock Text="If no needs were identified, explain why." TextWrapping="Wrap" Margin="0,6"/>
                                <TextBox Text="{Binding NoIdentifiedNeedsReason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="45" AutomationProperties.Name="No identified needs explanation"/>
                                <Button Content="Add identified need" Command="{Binding AddNeedCommand}" HorizontalAlignment="Left" Padding="12,5" />
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
