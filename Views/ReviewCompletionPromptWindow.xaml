<Window x:Class="Sati.Views.ReviewCompletionPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record review completion" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="22">
        <TextBlock x:Name="ReviewHeading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="When did you complete this review?" Margin="0,18,0,6"/>
        <DatePicker x:Name="CompletionDate" SelectedDateChanged="DateChanged"
                    AutomationProperties.Name="Actual review completion date"/>
        <TextBlock x:Name="Question" Margin="0,16,0,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="The review stays incomplete until you submit the note. Other billing requirements still apply. Enter the actual time spent in the note editor."
                   Margin="0,10,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="No, cancel" IsCancel="True" Padding="14,7"/>
            <Button Style="{StaticResource PrimaryButton}" x:Name="GenerateButton" Content="Yes, generate note" IsDefault="True"
                    IsEnabled="False" Click="GenerateClick" Margin="8,0,0,0" Padding="14,7"/>
        </StackPanel>
    </StackPanel>
</Window>
